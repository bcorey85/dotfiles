#!/usr/bin/env bash
# Inter-agent message mailbox via a shared file directory.
# Two Claude Code agents in separate repos share ~/.cache/claude-msg/ — no
# network needed.
#
# Usage:
#   claude-msg send <recipient> <message...>   send a message to <recipient>'s inbox
#   claude-msg read [recipient]                 print and consume inbox (default: basename $PWD)
#   claude-msg peek [recipient]                 print without consuming
#   claude-msg list                             list all inboxes that have mail

set -euo pipefail

_MAILBOX_DIR="${CLAUDE_MSG_DIR:-$HOME/.cache/claude-msg}"
_BUFFER_PREFIX="claude_inbox_"

_usage() {
    cat >&2 <<'EOF'
Usage: claude-msg <subcommand> [args]

Subcommands:
  send <recipient> <message...>   deliver a message to recipient's inbox
  read [recipient]                print and consume inbox (default: basename $PWD)
  peek [recipient]                print inbox without consuming
  list                            list all inboxes with pending mail
EOF
    exit 1
}

_inbox_file() {
    printf '%s/%s%s' "$_MAILBOX_DIR" "$_BUFFER_PREFIX" "$1"
}

cmd_send() {
    if [[ $# -lt 2 ]]; then
        echo "claude-msg send: requires <recipient> and <message>" >&2
        exit 1
    fi

    local recipient="$1"
    shift
    local body="$*"
    local from
    from="$(basename "$PWD")"
    local ts
    ts="$(date '+%Y-%m-%d %H:%M')"
    local file
    file="$(_inbox_file "$recipient")"

    mkdir -p "$_MAILBOX_DIR"
    printf '┌─ from: %s · %s ─────────────\n%s\n└────────────────────────────────────\n\n' \
        "$from" "$ts" "$body" >>"$file"
    echo "✉️  sent to ${recipient}"
}

cmd_read() {
    local target="${1:-$(basename "$PWD")}"
    local file
    file="$(_inbox_file "$target")"

    if [[ -s "$file" ]]; then
        cat "$file"
        rm -f "$file"
    else
        echo "📭 inbox empty (${target})"
    fi
}

cmd_peek() {
    local target="${1:-$(basename "$PWD")}"
    local file
    file="$(_inbox_file "$target")"

    if [[ -s "$file" ]]; then
        cat "$file"
    else
        echo "📭 inbox empty (${target})"
    fi
}

cmd_list() {
    if [[ ! -d "$_MAILBOX_DIR" ]]; then
        echo "📭 no pending messages"
        return
    fi

    local found=false
    for file in "$_MAILBOX_DIR/${_BUFFER_PREFIX}"*; do
        [[ -f "$file" ]] || continue
        found=true
        local name size repo
        name="$(basename "$file")"
        size="$(stat -c %s "$file" 2>/dev/null || stat -f %z "$file" 2>/dev/null || echo 0)"
        repo="${name#"${_BUFFER_PREFIX}"}"
        printf '%-30s %s bytes\n' "$repo" "$size"
    done

    if [[ "$found" == false ]]; then
        echo "📭 no pending messages"
    fi
}

case "${1:-}" in
    send)
        shift
        cmd_send "$@"
        ;;
    read)
        shift
        cmd_read "${1:-}"
        ;;
    peek)
        shift
        cmd_peek "${1:-}"
        ;;
    list)
        cmd_list
        ;;
    *)
        _usage
        ;;
esac
