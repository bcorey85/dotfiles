# Theme — owned by the `theme-mode` switcher. Starship has no include mechanism,
# but it re-reads its whole config every prompt, so theme-mode regenerates the
# REAL ~/.config/starship.toml (starship's default read path) from THIS template
# with the `palette =` line below swapped to the active mode (dark|light). Because
# it writes starship's default path, EVERY running shell flips on its next prompt
# with no reload and no STARSHIP_CONFIG — the generated file is machine-local, so
# this tracked template never gets dirtied. Same source-of-truth model as
# ghostty/tmux.
#
# THIS is the template (stowed to ~/.config/starship.toml.template): if you edit
# it, re-run `theme-mode` (any invocation) to regenerate the live config, or the
# change won't show until the next theme switch.
#
# NOTE: the root `palette`/`format` keys MUST come before any [palettes.*] table
# header — any key after a table header belongs to that table. Placed below a
# palette, `format` silently became palettes.<name>.format and starship fell
# back to the default `$all` format (which pulls in $aws et al.).
palette = "dark"

format = """
$directory\
$git_branch\
$git_status\
$python\
$nodejs\
$cmd_duration\
$line_break\
$character"""

# Dark — onedark "darker" (#1f2329 canvas), the same palette nvim/tmux/ghostty
# paint. `grey` is the comment colour AFTER the contrast lift theme-sync applies
# (stock #535965 is 2.24:1 on the canvas); everything else is stock.
[palettes.dark]
red = "#e55561"
orange = "#e2b86b"
yellow = "#e2b86b"
green = "#8ebd6b"
blue = "#4fa6ed"
teal = "#48b0bd"
purple = "#bf68d9"
fg = "#a0a8b7"
bg = "#1f2329"
grey = "#858c9a"

# Light — onedark's "light" style (#fafafa canvas). `grey` is again the lifted
# comment (stock #a0a1a7 is 2.47:1); the accents are stock and all clear 4.5:1.
[palettes.light]
red = "#e45649"
orange = "#986801"
yellow = "#986801"
green = "#50a14f"
blue = "#4078f2"
teal = "#0184bc"
purple = "#a626a4"
fg = "#383a42"
bg = "#fafafa"
grey = "#6f7178"

[directory]
style = "bold teal"
truncation_length = 3
truncate_to_repo = true

[git_branch]
format = " [$branch]($style)"
style = "blue"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "red"
ahead = " ↑${count}"
behind = " ↓${count}"
diverged = " ↑${ahead_count}↓${behind_count}"
modified = " ✗"
staged = " +"
untracked = " ?"
stashed = " ≡"

[python]
format = " [${virtualenv}]($style)"
style = "green"
detect_extensions = []

[nodejs]
format = " [ $version]($style)"
style = "green"

[cmd_duration]
min_time = 2_000
format = " [$duration]($style)"
style = "grey"

[character]
success_symbol = "[❯](bold teal)"
error_symbol = "[❯](bold red)"
