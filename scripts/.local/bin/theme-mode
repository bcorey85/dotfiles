  # Roles the retired families never set; default them so their (inert) branches
  # still emit legal TOML.
  konst="${konst:-$num}"; esc="${esc:-$str}"
  # Secondary-role defaults — the generic role each scope used before these
  # vars existed.
  cmt="${cmt:-$muted}"; mem="${mem:-$text}"; param="${param:-$punct}"
  attr="${attr:-$punct}"; tag="${tag:-$fn}"; vbi="${vbi:-$kw}"
  imp="${imp:-$typ}"; pre="${pre:-$num}"; prim="${prim:-$num}"
  ns="${ns:-$typ}"; mac="${mac:-$esc}"; bfn="${bfn:-$esc}"; var="${var:-$text}"
  lang="${lang:-$num}"; cls="${cls:-$typ}"; use="${use:-$var}"; call="${call:-$fn}"
