{
  "skills": [
    "~/.claude/skills"
  ],
  "lastChangelogVersion": "0.82.0",
  "theme": "dark",
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-spark",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-subagents",
    "npm:pi-questionnaire",
    "npm:pi-lens",
    "npm:pi-powerline-footer",
    "npm:@piex-dev/hashline",
    "npm:@piex-dev/lsp",
    "npm:@hsingjui/pi-hooks"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "workingVibe": "star trek",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/bash-safety-gate.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/git-discipline-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/review-commit-gate.py"
          }
        ]
      },
      {
        "matcher": "read|grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/block-credential-read.sh"
          }
        ]
      },
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/write-edit-safety-gate.sh"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/spec-budget-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/claudemd-linecount.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v ledger >/dev/null 2>&1 && ledger hook skill-use; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/warn-skip-hooks.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/calibration-guard.py"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/warn-skip-hooks.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/calibration-guard.py"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/warn-skip-hooks.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/calibration-guard.py"
          }
        ]
      }
    ]
  }
}