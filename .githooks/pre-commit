#!/usr/bin/env bash
# Refuse a commit that changes the Claude Code toolkit without a change file, and a commit while the change
# ledger (docs/changes) fails its check. Enable with: git config core.hooksPath .githooks
# AGENT_EVALS_DIR overrides the agent-evals checkout (default ~/agent-evals).
set -euo pipefail

agent_evals_dir="${AGENT_EVALS_DIR:-$HOME/agent-evals}"
build_changes="$agent_evals_dir/bin/build_changes.py"
hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$(git rev-parse --show-toplevel)"

touched_paths="$(git diff --cached --name-only)"
git diff --cached --name-status -z --no-renames | "$hooks_dir/change-file-check"

# A staged change to rule text or the skill set can strand an agent-evals rule-meter scenario or skill list entry.
# Check the staged prose files, not the work tree, so the check sees exactly what the commit holds.
drift_check="$agent_evals_dir/bin/toolkit_drift.py"
drift_pattern='^claude/\.claude/(agents|skills|rules)/|^claude/\.claude/[^/]+\.md$'
if grep -qE "$drift_pattern" <<<"$touched_paths"; then
    if [[ ! -f "$drift_check" ]]; then
        echo "pre-commit: note: $drift_check not found; meter scenarios and the skill list were not checked" >&2
    else
        staged_tree="$(mktemp -d)"
        trap 'rm -rf "$staged_tree"' EXIT
        git ls-files -z -- 'claude/.claude/*.md' | git checkout-index -z --stdin --prefix="$staged_tree/"
        if ! python3 "$drift_check" --toolkit "$staged_tree/claude/.claude"; then
            echo "pre-commit: the staged toolkit strands the agent-evals entries above; fix them in ~/agent-evals first" >&2
            exit 1
        fi
    fi
fi

if [[ ! -f "$build_changes" ]]; then
    echo "pre-commit: warning: $build_changes not found; the change ledger was not checked" >&2
    exit 0
fi

if ! python3 "$build_changes" --check --root docs/changes; then
    echo "pre-commit: docs/changes failed build_changes.py --check; fix the change files above and stage them" >&2
    exit 1
fi
