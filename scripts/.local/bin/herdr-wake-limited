#!/usr/bin/env python3
"""Press Enter in Claude panes stuck at the usage-limit "press enter" prompt, announce
panes stopped on an expired login, and send one resume prompt to a pane whose
transcript ends on a usage-limit or overload API error once it has cleared.

Usage: herdr-wake-limited [-h|--help]

Claude Code waits out a usage limit and continues at the reset. When the
computer slept past the reset it instead shows `Your usage limit has reset`
and `Press enter to continue`, and nothing continues until someone presses
Enter; herdr reports such a pane as idle or done.

This reads the visible screen of every claude agent that `herdr-api agent list`
names as idle or done. A pane whose last six non-empty lines hold both phrases gets one Enter, one line on
stdout (pane id and cwd) and one line in
${XDG_STATE_HOME:-~/.local/state}/herdr-wake-limited.log (ISO time, pane id,
cwd); when the log cannot be written, only a stderr line names the pane. Any other
pane gets nothing, except a pane on an expired login or an API error (below).
When herdr does not answer it exits 0 and prints nothing, so a timer can run it every few minutes.

A pane that stopped on an expired login (`Login expired · Please run /login`,
`Not logged in · Please run /login`; a whole line among the bottom ten
non-empty lines, after an optional leading glyph) gets no keys: only /login in
that pane fixes it. It gets one `herdr notification show`, one line on stdout
(`login expired <pane> <cwd>`) and one log line, once per stuck spell. The ids
already announced are kept in ${XDG_STATE_HOME:-~/.local/state}/herdr-wake-limited.noticed
(a JSON list, written atomically); an id is dropped once its pane no longer
shows the line or is no longer an idle or done claude agent, so a later expiry
announces again. Under tuios (TUIOS_SOCKET
set) there is no notification command, so nothing is announced and the
noticed file is neither read nor written.

A pane whose session transcript ends on a usage-limit or server (overload,
lost connection) API error gets one `herdr-api agent prompt` once the error
has cleared: a usage limit a minute after its reset time, a server error five
minutes after it was written; an error whose resume time passed more than a
day ago gets no prompt. It also gets one line on stdout (`resumed <pane>
<cwd>`) and one log line. The error records already answered are kept by uuid
in ${XDG_STATE_HOME:-~/.local/state}/herdr-wake-limited.resumed (a JSON list,
written atomically); a uuid is dropped once no claude pane, in any state, ends on it, so a
pane is prompted once per error. A login, billing or bad-request error gets no
prompt. The transcript is found and read through the toolkit's
`lib/herdr_agents.py`, `lib/api_error_stop.py` and `lib/script_utils.py`, found from this script's
real path. Under tuios nothing is resumed and the resumed
file is neither read nor written.
"""
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import time

# The stowed link resolves into the dotfiles checkout, whose toolkit lib reads transcripts.
toolkit_lib = pathlib.Path(__file__).resolve().parents[3] / "claude" / ".claude" / "scripts" / "lib"
sys.path.insert(0, str(toolkit_lib))
import api_error_stop
import herdr_agents
import script_utils

PHRASES = ("your usage limit has reset", "press enter to continue")
VISIBLE_LINES = "15"
BOTTOM_LINES = 6
LOGIN_BOTTOM_LINES = 10
RESUME_PROMPT = ("Your last turn stopped on an API error that has now cleared. "
                 "Go on with the task from where it stopped.")
# A whole line: plain words, then the hint. Quotes, prompts or other text around
# the phrase mean a pane is discussing it, not showing it.
LOGIN_LINE = re.compile(r"^(?:[●⎿]\s*)?[A-Za-z][A-Za-z ]* · Please run /login$")


def herdr_api(*args):
    """Return herdr-api's stdout, or None when herdr gives no answer."""
    try:
        answer = subprocess.run(["herdr-api", *args], capture_output=True,
                                text=True, timeout=herdr_agents.HERDR_CALL_TIMEOUT_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if answer.returncode != 0:
        return None
    return answer.stdout


def claude_agents_with_panes():
    """Every claude agent with a pane, or None when herdr gives no usable answer."""
    try:
        agents = herdr_agents.claude_agents()
    except herdr_agents.PaneCallError:
        return None
    return [agent for agent in agents if agent.get("pane_id")]


def is_waiting(agent):
    """True when herdr reports the pane idle or done."""
    return agent.get("agent_status") in ("idle", "done")


def holds_limit_reset_prompt(text):
    """True when the prompt's lines sit at the bottom of the screen. Lines are joined with spaces, so a phrase a
    narrow pane wrapped still matches, and a pane that only quotes the phrases higher up does not."""
    lines = [line for line in text.splitlines() if line.strip()]
    bottom = " ".join(" ".join(lines[-BOTTOM_LINES:]).split()).lower()
    return all(phrase in bottom for phrase in PHRASES)


def login_expired_line(text):
    """The first whole login-expired line among the bottom lines of the screen, else None."""
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    for line in lines[-LOGIN_BOTTOM_LINES:]:
        if LOGIN_LINE.match(line):
            return line
    return None


def state_dir():
    state_home = os.environ.get("XDG_STATE_HOME") or str(pathlib.Path.home() / ".local" / "state")
    return pathlib.Path(state_home)


def read_id_list(id_file):
    """Ids kept by an earlier run. A missing or unreadable file reads as none, so a pane is acted on again, never
    missed."""
    try:
        raw_ids = id_file.read_text()
        loaded = json.loads(raw_ids)
        return set(loaded)
    except (OSError, ValueError, TypeError):
        return set()


def write_id_list(id_file, ids):
    try:
        id_file.parent.mkdir(parents=True, exist_ok=True)
        id_json = json.dumps(sorted(ids))
        script_utils.write_text_atomically(id_file, id_json)
    except OSError as error:
        print(f"herdr-wake-limited: could not write {id_file}: {error}", file=sys.stderr)


def announce_login_expired(pane_id, cwd, line):
    """Show the notification; True when herdr took it."""
    body = f"{pane_id} in {cwd} stopped on {line}; run /login there"
    shown = herdr_api("notification", "show", "herdr-wake-limited: login expired",
                      "--body", body, "--sound", "request")
    if shown is None:
        print(f"herdr-wake-limited: could not notify about {pane_id}", file=sys.stderr)
        return False
    return True


def log_event(pane_id, cwd, note=""):
    log_file = state_dir() / "herdr-wake-limited.log"
    stamp = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    try:
        log_file.parent.mkdir(parents=True, exist_ok=True)
        with log_file.open("a") as log:
            suffix = f" {note}" if note else ""
            log.write(f"{stamp} {pane_id} {cwd}{suffix}\n")
    except OSError as error:
        print(f"herdr-wake-limited: could not write {log_file}: {error}", file=sys.stderr)


def handle_login_expired(agent, login_line, noticed):
    """Announce a stuck pane once.

    Returns True when the pane is announced, on this run or an earlier one
    (the caller keeps it noticed). Returns False when the notification failed,
    so the next run retries.
    """
    pane_id = agent["pane_id"]
    if pane_id in noticed:
        return True
    cwd = agent.get("cwd", "")
    if not announce_login_expired(pane_id, cwd, login_line):
        return False
    log_event(pane_id, cwd, "login-expired")
    print(f"login expired {pane_id} {cwd}")
    return True


def wake_pane(agent):
    pane_id = agent["pane_id"]
    if herdr_api("agent", "send-keys", pane_id, "enter") is None:
        print(f"herdr-wake-limited: could not send Enter to {pane_id}", file=sys.stderr)
        return
    cwd = agent.get("cwd", "")
    log_event(pane_id, cwd)
    print(f"woke {pane_id} {cwd}")


def handle_pane(agent, noticed, under_tuios, screen_handled):
    """Act on one pane's screen; True when its id stays in the noticed set. A pane at the login or reset prompt,
    or whose screen read failed, goes into screen_handled, so the API-error pass leaves it alone."""
    pane_id = agent["pane_id"]
    screen = herdr_api("agent", "read", pane_id, "--source", "visible", "--lines", VISIBLE_LINES)
    if screen is None:
        # A failed read says nothing about the pane: keep its announced state, and send no resume prompt this run.
        screen_handled.add(pane_id)
        return pane_id in noticed
    login_line = login_expired_line(screen)
    if login_line:
        screen_handled.add(pane_id)
        return not under_tuios and handle_login_expired(agent, login_line, noticed)
    if holds_limit_reset_prompt(screen):
        screen_handled.add(pane_id)
        wake_pane(agent)
    return False


def resume_stopped_pane(agent, resumed, now, may_prompt):
    """Prompt a pane whose transcript ends on a cleared API error. Returns the error record's uuid while the pane
    still ends on it (the caller keeps it in the resumed set), TRANSCRIPT_UNREADABLE when the transcript read failed
    (the caller keeps the whole resumed set, since a failed read says nothing about the pane), else None. With
    may_prompt False (the screen shows a login or reset prompt, the screen read failed, or the pane is not idle or
    done) nothing is sent, but an already answered uuid is still returned."""
    transcript = herdr_agents.herdr_agent_transcript(agent)
    if transcript is None:
        return None
    record = script_utils.last_api_error(transcript, report_unreadable=True)
    if record == script_utils.TRANSCRIPT_UNREADABLE:
        return script_utils.TRANSCRIPT_UNREADABLE
    if record is None or not isinstance(record.get("uuid"), str):
        return None
    error_id = record["uuid"]
    if error_id in resumed:
        return error_id
    if not may_prompt:
        return None
    resume_at = api_error_stop.resume_epoch(record, now)
    if resume_at is None or now < resume_at:
        return None
    pane_id = agent["pane_id"]
    if herdr_api("agent", "prompt", pane_id, RESUME_PROMPT) is None:
        print(f"herdr-wake-limited: could not prompt {pane_id}", file=sys.stderr)
        return None
    cwd = agent.get("cwd", "")
    log_event(pane_id, cwd, "resumed")
    print(f"resumed {pane_id} {cwd}")
    return error_id


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        print(f"herdr-wake-limited: unknown argument: {sys.argv[1]}", file=sys.stderr)
        return 1

    # Timer units start with a short PATH that lacks herdr-api; every herdr-api call below inherits this one.
    local_bin = pathlib.Path.home() / ".local" / "bin"
    os.environ["PATH"] = f"{local_bin}:{os.environ.get('PATH', '')}"

    all_agents = claude_agents_with_panes()
    if all_agents is None:
        return 0
    agents = [agent for agent in all_agents if is_waiting(agent)]
    # tuios shares the noticed file with herdr but lists other pane ids, so a
    # tuios run must not read or rewrite it.
    under_tuios = bool(os.environ.get("TUIOS_SOCKET"))
    noticed_file = state_dir() / "herdr-wake-limited.noticed"
    noticed = set() if under_tuios else read_id_list(noticed_file)
    screen_handled = set()
    still_stuck = {agent["pane_id"] for agent in agents
                   if handle_pane(agent, noticed, under_tuios, screen_handled)}
    if under_tuios:
        return 0
    if still_stuck != noticed:
        write_id_list(noticed_file, still_stuck)

    resumed_file = state_dir() / "herdr-wake-limited.resumed"
    resumed = read_id_list(resumed_file)
    now = time.time()
    still_resumed = set()
    for agent in all_agents:
        # A pane that is working again after its prompt is not listed idle or done, but its uuid stays kept
        # while its transcript still ends on it.
        may_prompt = is_waiting(agent) and agent["pane_id"] not in screen_handled
        error_id = resume_stopped_pane(agent, resumed, now, may_prompt)
        if error_id == script_utils.TRANSCRIPT_UNREADABLE:
            still_resumed |= resumed
        elif error_id is not None:
            still_resumed.add(error_id)
    if still_resumed != resumed:
        write_id_list(resumed_file, still_resumed)
    return 0


if __name__ == "__main__":
    sys.exit(main())
