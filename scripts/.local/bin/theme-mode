#!/bin/bash
# theme-mode — single source of truth for the theme FAMILY and light/dark MODE
# across herdr + neovim + ghostty + claude code.
#
# State files (read by every consumer):
#   ~/.cache/theme-mode    dark|light
#   ~/.cache/theme-family  family name (see families() below)
#
# Consumers:
#   - nvim:    lua/config/theme-sync.lua polls both files (~1s) and applies
#              the family's colorscheme + overrides
#   - ghostty: this script writes ~/.config/ghostty/theme-switch.conf
#              (machine-local include, same pattern as local.conf), then
#              SIGUSR2s the running ghostty to reload it (1.2+; ctrl+shift+,
#              still works by hand). Only USR2 — any other signal crashes it.
#   - claude:  this script writes .theme (mode only) into ~/.claude/settings.json
#              via jq (correct key on Claude Code >= 2.1.119; older builds kept it
#              in ~/.claude.json). This sets the theme for the NEXT session — a
#              running session does NOT repaint live: Claude Code reloads the
#              settings value but never re-renders the TUI on a theme change, and
#              its `auto` OSC 11 detection only samples at launch (and the
#              multiplexer mangles it). No supported live-flip lever exists (see anthropics/claude-code
#              #33899); restart or run /theme by hand to see it in an open session.
#   - herdr:   this script regenerates the REAL ~/.config/herdr/config.toml from
#              the stowed ~/.config/herdr/config.toml.template (substituting the
#              __THEME_MODE_PALETTE__ marker with herdr_palette() below), then
#              runs `herdr server reload-config` so attached clients repaint
#              live. Same template contract as starship: the generated config is
#              machine-local, so a toggle never dirties the tracked file. herdr
#              has no include mechanism, so the WHOLE file is regenerated —
#              anything herdr writes to config.toml itself (e.g. `herdr config
#              reset-keys`) is overwritten on the next toggle. herdr's own
#              auto_switch is deliberately off: it keys off the terminal's
#              reported appearance rather than ~/.cache/theme-mode.
#   - starship: this script regenerates the REAL ~/.config/starship.toml from
#              the stowed ~/.config/starship.toml.template with the active
#              `palette =` line swapped to `<family>-<mode>` — a two-axis
#              swap, not mode-only. Starship has no include but re-reads its
#              config every prompt from that default path, so EVERY running
#              shell flips on its next prompt — no reload, no STARSHIP_CONFIG.
#              The generated file is machine-local (not stowed), so the
#              tracked template is never dirtied. Edit the template => re-run
#              theme-mode to refresh the live config.
#
# Usage:
#   theme-mode [dark|light|toggle]    flip mode, keep family (default: toggle)
#   theme-mode use <family> [mode]    switch family, keep mode unless given
#   theme-mode list                   known families
#   theme-mode status                 current family + mode
#
# Adding a family = five touchpoints, kept in sync by hand:
#   1. families() + ghostty_theme() below
#   2. FAMILIES table in nvim lua/config/theme-sync.lua
#   3. a ghostty theme (builtin name, or custom file in ghostty/themes/)
#   4. herdr_palette() below (herdr's [theme.custom] token block)
#   5. hunk_theme() below — pick the closest of hunk's builtins; a family with
#      no good match maps to nothing and hunk keeps whatever it had
#
# Also needed, not part of the six but easy to miss:
#   - starship.toml.template: add a `[palettes.<family>-dark]` /
#     `[palettes.<family>-light]` pair for the new family
#   - zsh/.zshrc: its fresh-machine bootstrap copies starship.toml.template
#     verbatim, so it must stay in sync with the template's default palette
#     name (this already caused one bug, fixed separately)
#   - DEFAULT_FAMILY must be kept in sync across three sites: this script's own
#     DEFAULT_FAMILY var, theme-sync.lua's default, and starship.toml.template's
#     root `palette =` line
set -euo pipefail

MODE_FILE="$HOME/.cache/theme-mode"
FAMILY_FILE="$HOME/.cache/theme-family"
GHOSTTY_SWITCH="$HOME/.config/ghostty/theme-switch.conf"
DEFAULT_FAMILY="monokai-pro"

families() { printf '%s\n' monokai-pro; }

ghostty_theme() { # <family> <mode> -> ghostty theme name
  # "Monokai Pro" is a ghostty builtin (spaces and all), so no custom themes/
  # file — apply() writes `theme = Monokai Pro`. Dark-only, so both modes map to
  # the same builtin until a light theme is chosen.
  case "$1:$2" in
    monokai-pro:*) echo "Monokai Pro" ;;
  esac
}

hunk_theme() { # <family> <mode> -> the hunk BUILTIN a custom theme inherits from
  # hunk's [custom_theme] `base` inherits syntax (and any unset colours) from a
  # bundled theme; hunk_custom_theme() then overrides the diff/chrome colours on
  # top. This picks that base — the closest shipped theme for the family's
  # syntax. hunk has no monokai-pro builtin, so classic `monokai` is the base
  # (its diff washes are replaced below). If a family sets no custom block, this
  # id is used directly as `theme =`. The ids live in the installed package's
  # dist/npm/opentui/themes.d.ts (`hunk diff --help` has no list).
  case "$1:$2" in
    monokai-pro:*) echo "monokai" ;;
  esac
}

# theme-mode owns exactly this delimited block inside hunk's self-written
# config.toml; hunk_set_block strips only what is between the markers, never
# hunk's own keys/tables.
HUNK_BLOCK_BEGIN="# >>> theme-mode custom_theme (do not edit inside markers)"
HUNK_BLOCK_END="# <<< theme-mode custom_theme"

hunk_custom_theme() { # <family> <mode> <base> -> a [custom_theme] TOML table, or nothing
  # Overrides hunk's diff line/sign colours to the EXACT values nvim paints
  # under this family, since no bundled hunk theme reproduces them. Diff
  # backgrounds are the monokai-pro "pro" filter's diffEditor blends
  # (accent 10% over dark1 #221f22): add #30322a, remove #38262c. `base` above
  # supplies syntax; keys here (camelCase, matching hunk's CUSTOM_THEME_COLOR_KEYS)
  # win over it. Both modes share the block — monokai-pro is dark-only.
  case "$1:$2" in
    monokai-pro:*) ;;
    *) return 0 ;;
  esac
  cat <<EOF
[custom_theme]
base             = "$3"
background       = "#2d2a2e"
panel            = "#221f22"
panelAlt         = "#19181a"
border           = "#403e41"
accent           = "#ab9df2"
accentMuted      = "#5b595c"
text             = "#fcfcfa"
muted            = "#949394"
addedBg          = "#30322a"
removedBg        = "#38262c"
movedAddedBg     = "#30322a"
movedRemovedBg   = "#38262c"
contextBg        = "#2d2a2e"
addedContentBg   = "#30322a"
removedContentBg = "#38262c"
contextContentBg = "#2d2a2e"
addedSignColor   = "#a9dc76"
removedSignColor = "#ff6188"
lineNumberBg     = "#2d2a2e"
lineNumberFg     = "#5b595c"
selectedHunk     = "#403e41"
badgeAdded       = "#a9dc76"
badgeRemoved     = "#ff6188"
badgeNeutral     = "#78dce8"
fileNew          = "#a9dc76"
fileDeleted      = "#ff6188"
fileRenamed      = "#ab9df2"
fileModified     = "#ffd866"
fileUntracked    = "#949394"
noteBorder       = "#403e41"
noteBackground   = "#221f22"
noteTitleBackground = "#403e41"
noteTitleText    = "#fcfcfa"

# Syntax slots — the monokai-pro "pro" filter palette, so hunk's code body
# reads identically to nvim's, not the classic-monokai `base` above (which it
# overrides). comment is the same contrast-lifted grey nvim uses (#949394,
# ~4.6:1 on #2d2a2e). ceiling: hunk marks the named-slot `syntax` field
# deprecated in favour of exact TextMate selectors (syntaxScopes); if a major
# bump drops it, port these 11 slots to syntaxScopes.
[custom_theme.syntax]
default     = "#fcfcfa"
keyword     = "#ff6188"
string      = "#ffd866"
comment     = "#949394"
number      = "#ab9df2"
function    = "#a9dc76"
property    = "#fcfcfa"
type        = "#78dce8"
variable    = "#fcfcfa"
operator    = "#ff6188"
punctuation = "#c1c0c0"
EOF
}

hunk_set_block() { # <file> <block-or-empty> — replace theme-mode's marked block
  # Drops any prior marked block (markers inclusive), then appends the fresh one
  # at EOF. Empty content just clears it (the builtin path). The [custom_theme]
  # table lands after hunk's bare keys, keeping the same "tables sort last"
  # invariant hunk_set relies on.
  local file="$1" content="$2" tmp
  tmp="$(mktemp)"
  awk -v b="$HUNK_BLOCK_BEGIN" -v e="$HUNK_BLOCK_END" '
    $0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip { print }
  ' "$file" >"$tmp"
  if [ -n "$content" ]; then
    { echo "$HUNK_BLOCK_BEGIN"; printf '%s\n' "$content"; echo "$HUNK_BLOCK_END"; } >>"$tmp"
  fi
  mv "$tmp" "$file"
}

hunk_set() { # <file> <key> <toml-value> — set a top-level key, preserving the rest
  # Anchored so it only ever touches the top-level key, never a same-named key
  # inside one of hunk's tables ([vcs], [pager], [custom_theme], ...). Those
  # tables all sort after the bare keys hunk writes, so appending stays legal
  # TOML: a new key added below a table header would silently join that table.
  local file="$1" key="$2" value="$3"
  if grep -q "^$key = " "$file" 2>/dev/null; then
    sed -i.bak "s|^$key = .*|$key = $value|" "$file" && rm -f "$file.bak"
  elif grep -q '^\[' "$file" 2>/dev/null; then
    sed -i.bak "1i\\
$key = $value" "$file" && rm -f "$file.bak"
  else
    printf '%s = %s\n' "$key" "$value" >>"$file"
  fi
}

hunk_apply() { # <family> <mode> — point hunk's config at the family's theme
  local base custom cfg
  base="$(hunk_theme "$1" "$2")"
  cfg="$HOME/.config/hunk/config.toml"
  # No template here, unlike herdr/starship: hunk WRITES this file itself
  # (the in-app View menu persists theme, wrap, line numbers and more), so
  # regenerating it would silently drop the user's other preferences. Set only
  # the keys this script owns, and create the file when there is none.
  mkdir -p "$(dirname "$cfg")"
  [ -f "$cfg" ] || : >"$cfg"

  # A family with a custom block selects theme="custom" and inherits syntax from
  # `base`; one without falls back to the plain builtin. Set the bare keys before
  # appending the [custom_theme] table so they stay above it (bare keys first).
  custom="$(hunk_custom_theme "$1" "$2" "$base")"
  if [ -n "$custom" ]; then
    hunk_set "$cfg" theme '"custom"'
  elif [ -n "$base" ]; then
    hunk_set "$cfg" theme "\"$base\""
  else
    return 0
  fi
  # Without this, hunk paints its chrome with the builtin's own background,
  # which sits a step off the terminal's in dark mode and reads as a gray box
  # inside the black. Letting the terminal show through matches whatever
  # ghostty/herdr already painted, in both modes, with no second palette to
  # keep in sync.
  hunk_set "$cfg" transparent_background true
  # Write (or clear, when empty) the [custom_theme] table so hunk's diff/syntax
  # colors match nvim's exactly. The builtin monokai base is close on syntax but
  # its diff bgs differ from Monokai Pro's, which this block overrides.
  hunk_set_block "$cfg" "$custom"
  # No reload: hunk reads its config at launch, and the session daemon exposes
  # no config command. Running reviews keep their colors; the next one flips.
}

herdr_palette() { # <family> <mode> -> the [theme] + [theme.custom] TOML block
  # herdr's token namespace is catppuccin-derived; `name` picks the BASE theme
  # and [theme.custom] overrides individual tokens on top of it. There is no
  # one-light builtin, so light overrides the same token set rather than
  # swapping the base — any token not listed here keeps its one-dark value.
  local accent panel_bg surface_dim surface0 surface1 overlay0 overlay1
  local text subtext0 green yellow red blue teal peach
  case "$1:$2" in
    monokai-pro:*)
      # Monokai Pro, "pro" filter (#2d2a2e canvas) — matches nvim/ghostty.
      # Dark-only: light mode reuses this block until a light theme is chosen.
      #
      # overlay1/subtext0 is the comment grey lifted to clear 4.5:1: stock
      # #727072 is 2.89:1 on the canvas; #949394 is ~4.6:1. yellow and peach
      # collapse to carpYellow's role — Monokai Pro ships a distinct orange
      # (#fc9867), so peach takes it rather than duplicating yellow.
      accent="#ab9df2" panel_bg="#221f22" surface_dim="#363437"
      surface0="#403e41" surface1="#4a484b"
      overlay0="#5b595c" overlay1="#949394"
      text="#fcfcfa" subtext0="#949394"
      green="#a9dc76" yellow="#ffd866" red="#ff6188"
      blue="#78dce8" teal="#78dce8" peach="#fc9867"
      ;;
  esac

  # Sidebar focus contrast — deviations from the stock family values above:
  #   surface_dim = the FOCUSED agent/workspace row's background bar. At the
  #     stock canvas value it sat ~1.05:1 against panel_bg, so the focused row
  #     read as unmarked. Both modes push it clear of panel_bg instead. It also
  #     tints inactive pane borders, scrollbar tracks, and sidebar separators.
  #   surface0 = nav-mode selection bg; kept a step above surface_dim so
  #     selection still outranks focus. surface1 = drag.
  #   text/subtext0 = focused vs unfocused agent name. Dark widens the gap;
  #     light leaves subtext0 at the 4.5:1 floor documented above.
  #   overlay0 = NOT a border color despite the name — herdr uses it as the
  #     muted FOREGROUND for sidebar chrome (the "spaces"/"agents" headers, the
  #     sort label, new/menu, the per-row agent name, inactive tab labels,
  #     scrollbar thumbs), much of it DIM on top. So light needs it DARKER than
  #     panel_bg, not lighter; a border-grey there erases the whole sidebar.
  #     Keep it between overlay1/subtext0 and the backgrounds on both sides.
  cat <<EOF
[theme]
name = "one-dark"
auto_switch = false

[theme.custom]
accent      = "$accent"
panel_bg    = "$panel_bg"
surface_dim = "$surface_dim"
surface0    = "$surface0"
surface1    = "$surface1"
overlay0    = "$overlay0"
overlay1    = "$overlay1"
text        = "$text"
subtext0    = "$subtext0"
mauve       = "$accent"
green       = "$green"
yellow      = "$yellow"
red         = "$red"
blue        = "$blue"
teal        = "$teal"
peach       = "$peach"
EOF
}

herdr_apply() { # <family> <mode> — regenerate the live config, reload the server
  local tmpl="$HOME/.config/herdr/config.toml.template"
  local cfg="$HOME/.config/herdr/config.toml"
  [ -f "$tmpl" ] || return 0

  # Same contract as starship: the stowed file is the TEMPLATE and the real
  # config is machine-local, so toggling never dirties the tracked file. herdr
  # has no include mechanism, hence full regeneration rather than a fragment.
  local tmp palette_file
  tmp="$(mktemp)"
  palette_file="$(mktemp)"
  herdr_palette "$1" "$2" >"$palette_file"
  # awk, not sed: the palette is multi-line and contains #/& which sed's
  # replacement would mangle. The block is read from a FILE via getline, not
  # passed with -v: macOS's awk rejects a newline inside a -v assignment
  # ("newline in string"), which silently left the mac with no config.toml at
  # all while gawk/mawk on Linux accepted it.
  awk -v pf="$palette_file" '
    /^# __THEME_MODE_PALETTE__$/ {
      while ((getline line < pf) > 0) print line
      close(pf); next
    }
    { print }
  ' "$tmpl" >"$tmp" && mv "$tmp" "$cfg" || { rm -f "$tmp" "$palette_file"; return 0; }
  rm -f "$palette_file"

  # No-op (non-zero, swallowed) when no server is running.
  command -v herdr >/dev/null 2>&1 && herdr server reload-config >/dev/null 2>&1 || true
}

current_mode() { cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]'; }
current_family() {
  local f
  f="$(cat "$FAMILY_FILE" 2>/dev/null | tr -d '[:space:]')"
  families | grep -qx "$f" && echo "$f" || echo "$DEFAULT_FAMILY"
}

apply() { # <family> <mode> — write state and repaint herdr + ghostty
  local family="$1" mode="$2"
  mkdir -p "$(dirname "$MODE_FILE")"
  printf '%s\n' "$mode" >"$MODE_FILE"     # nvim picks these up
  printf '%s\n' "$family" >"$FAMILY_FILE" # via its own watcher

  # ghostty: machine-local include; wins over the fallback `theme =` line
  # because config-file includes are processed after the main config.
  #
  # Custom themes are pulled in by ABSOLUTE PATH, not by name. `theme = <name>`
  # resolves against a themes/ dir inside whatever ghostty considers its config
  # directory — on macOS that's ~/Library/Application Support/com.mitchellh.ghostty/,
  # NOT the stowed ~/.config/ghostty/, so every custom theme 404s there while
  # builtins keep working. A theme file is just a config fragment (palette /
  # background / foreground), so config-file loads it identically on any
  # platform. Builtins have no file on disk and still go through `theme =`.
  mkdir -p "$(dirname "$GHOSTTY_SWITCH")"
  local theme custom
  theme="$(ghostty_theme "$family" "$mode")"
  custom="$(dirname "$GHOSTTY_SWITCH")/themes/$theme"
  {
    echo "# Written by theme-mode — do not edit. Reload ghostty: ctrl+shift+,"
    if [ -f "$custom" ]; then
      echo "config-file = $custom"
    else
      echo "theme = $theme"
    fi
  } >"$GHOSTTY_SWITCH"

  # Ghostty reloads its config on SIGUSR2 (1.2+). Without this the include above
  # sits on disk until you hit ctrl+shift+, by hand. USR2 ONLY — ghostty crashes
  # on any other signal. macOS runs the same binary name from the app bundle.
  if command -v pkill >/dev/null 2>&1; then
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi

  # Claude Code: push the mode into ~/.claude/settings.json so the NEXT session
  # opens in it. A running session does NOT repaint — Claude Code reloads the
  # settings value but never re-renders the TUI on a `theme` change (known gap,
  # anthropics/claude-code #33899), and its `auto` OSC 11 detection only samples
  # at launch (and the multiplexer mangles it), so a flip never reaches an open
  # session. `light`/`dark` are valid theme values, so $mode drops straight in.
  # To see it live in an open session, run /theme by hand.
  local claude_settings="$HOME/.claude/settings.json"
  if command -v jq >/dev/null 2>&1 && [ -f "$claude_settings" ]; then
    local claude_tmp
    claude_tmp="$(mktemp)"
    if jq --arg t "$mode" '.theme = $t' "$claude_settings" >"$claude_tmp" 2>/dev/null; then
      mv "$claude_tmp" "$claude_settings"
    else
      rm -f "$claude_tmp"
    fi
  fi

  # Starship: no include mechanism, but it re-reads its whole config every prompt
  # from its default path ~/.config/starship.toml. Regenerate that REAL file (not
  # a symlink — it's machine-local) from the stowed template with the active
  # `palette =` line swapped to `$family-$mode`, so EVERY running shell flips on
  # its next prompt with no reload. Only the top-level `palette = ` line matches
  # the anchored sed — the [palettes.*] headers are untouched. The palette names
  # in the template are `<family>-<mode>` (e.g. monokai-pro-dark), so this is a two-
  # axis swap now, not mode-only.
  local starship_tmpl="$HOME/.config/starship.toml.template"
  local starship_cfg="$HOME/.config/starship.toml"
  if [ -f "$starship_tmpl" ]; then
    sed "s/^palette = .*/palette = \"$family-$mode\"/" "$starship_tmpl" >"$starship_cfg"
  fi

  # herdr: regenerate ~/.config/herdr/config.toml from the stowed template with
  # the active palette, then reload the running server. No-op without herdr.
  herdr_apply "$family" "$mode"

  # hunk: one builtin theme id per family x mode, edited in place. No-op for a
  # family with no mapping.
  hunk_apply "$family" "$mode"

  echo "$family $mode"
}

arg="${1:-toggle}"
case "$arg" in
  dark | light) apply "$(current_family)" "$arg" ;;
  toggle)
    [ "$(current_mode)" = "light" ] && mode="dark" || mode="light"
    apply "$(current_family)" "$mode"
    ;;
  use)
    family="${2:-}"
    if ! families | grep -qx "$family"; then
      echo "unknown family: '$family' (see: theme-mode list)" >&2
      exit 2
    fi
    mode="${3:-$(current_mode)}"
    case "$mode" in dark | light) : ;; *) mode="dark" ;; esac
    apply "$family" "$mode"
    ;;
  list) families ;;
  status) echo "$(current_family) $(current_mode)" ;;
  *)
    echo "usage: theme-mode [dark|light|toggle] | use <family> [mode] | list | status" >&2
    exit 2
    ;;
esac
