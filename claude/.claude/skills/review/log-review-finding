#!/usr/bin/env bash
# log-review-finding — per-finding and per-run telemetry for every review gate.
#
# review-metrics.jsonl records one aggregate row per /review run: disposition
# counts, no per-finding detail. That answers "how loud was this run" and
# nothing else. Two questions it cannot answer:
#
#   - What did a gate catch that no other gate caught? (needs file:line)
#   - What is a gate's denominator? (needs the silent runs recorded too)
#
# This log carries both. Two row kinds, discriminated by `kind`:
#
#   kind=run      one per GATE DISPATCH, including dispatches that found
#                 nothing. The silent runs are the denominator; a log that
#                 only records findings makes every gate look perfect.
#   kind=finding  one per finding that gate emitted, with file:line so rows
#                 join against each other and against review-escapes.jsonl.
#
# usage: log-review-finding kind=run|finding key=value [key=value ...]
#
#   COMMON
#     repo=<basename>
#     branch=<git branch>
#     lane=eng-spec|code|other|none
#     scope=phase|branch-exit|standalone
#       phase       gate ran at a /code phase boundary, on that phase's diff
#       branch-exit gate ran in a closing phase, on the whole-branch diff
#       standalone  direct invocation, no enclosing loop
#     phase=<index|name>          ("-" when scope is not `phase`)
#     iter=<N>                    review-loop iteration this dispatch belongs to
#     gate=code-reviewer|code-reviewer-deep|smell-reviewer|smell-reviewer-deep
#         |security-reviewer|security-reviewer-deep|perf-reviewer
#         |perf-reviewer-deep|complexity-reviewer|complexity-reviewer-deep
#         |test-intent-reviewer|test-reviewer|plan-verifier|drift-gate|stage
#       The literal agent name dispatched, so the sonnet and opus tiers of the
#       same reviewer stay separable. Never collapse them.
#
#   kind=run ONLY
#     n_findings=<n>              0 for a silent run — the point of the row
#     diff_loc=<n>                lines the gate actually read (git diff
#       --shortstat on its scope, insertions+deletions). Review-defect-detection
#       degrades with the size of the change under review, so a gate's yield is
#       uninterpretable without it. Measure it; do not estimate it.
#     result=PASS|PASS WITH WARNINGS|NEEDS CHANGES|NOT DISPATCHED   (optional)
#       Case and -/_ spelling are normalized, and the words gates reach for when
#       none of the four fit are folded in: clean and intent-aligned are PASS,
#       findings, gaps and residue are NEEDS CHANGES. Anything else is refused.
#
#   kind=finding ONLY
#     disposition=fix|ask|nit       what the reviewer said should happen
#     blocker=yes|no                (optional, `fix` only) advancing with it
#                                   in place ships the defect — set
#                                   automatically when fix_induced=bug
#     class=bug|smell|duplication|complexity|plan-drift|test-gap|weak-assertion
#          |security|perf|correctness|docs|other  (same vocabulary as log-escape,
#                                                  so the two logs cross-tabulate)
#       perf = query/IO cost (N+1, unbounded query, missing index, over-fetch,
#       serial awaits, per-item round-trip). perf-reviewer's findings go here,
#       never under `other` — under `other` they cannot be told apart from
#       anyone else's and the gate's recall is uncomputable.
#       docs = the prose is wrong about the code: a stale or misleading comment,
#       a rationale that cites the wrong quantity, a doc contradicting the
#       behaviour it describes, comment volume against the file's own cap. The
#       code may be correct — that is what separates it from `bug`.
#       other = last resort, and it is read as one. A run whose findings are
#       mostly `other` has told the analysis nothing about what the gate catches.
#     file=<path>                 repo-relative
#     line=<n>                    0 when the finding names no line
#     actioned=fixed|skipped_fp|deferred|ask|none
#       fixed      code changed because of this finding
#       skipped_fp judged a false positive
#       deferred   real, moved to the branch-exit triage queue
#       ask        needs a human decision
#       none       not yet dispositioned
#     desc="one line"
#     fix_induced=yes|no|bug      (optional) the finding names code a previous
#       fix in this loop introduced, not code the coder originally wrote.
#       `bug` sets blocker=yes.
#
# Numeric-looking values are stored as numbers, everything else as strings.
# A "date" field (UTC ISO 8601) is always added. Output file:
#   $REVIEW_FINDINGS_FILE or ~/.claude/review-findings.jsonl
set -euo pipefail

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
out="${REVIEW_FINDINGS_FILE:-$HOME/.claude/review-findings.jsonl}"

# schema_version marks the row's schema era; bump ONLY on a breaking change
# (a value-vocabulary swap or a field-meaning change), never for additive fields.
# /audit review reads only the current version; older versions are archived.
SCHEMA_VERSION=3
json=$(jq -cn --argjson sv "$SCHEMA_VERSION" '{date: (now | todate), schema_version: $sv}')
for kv in "$@"; do
  case "$kv" in
    out=*) out="${kv#out=}"; continue ;;
    *=*) ;;
    *) echo "skipping malformed arg (want key=value): $kv" >&2; continue ;;
  esac
  k="${kv%%=*}"
  v="${kv#*=}"
  # Only desc and result are free text. A space in any other value means the
  # caller quoted too much and swallowed the following key=value pairs into this
  # one — which is how repo= ends up holding branch, lane, scope, phase and
  # iter, destroying every join key /audit review needs. Fail loud.
  case "$k" in
    desc|result) ;;
    *)
      if [ "$v" != "${v#* }" ]; then
        echo "refusing to log: $k= contains a space: '$v'" >&2
        echo "Quote each key=value separately; only desc= and result= may contain spaces." >&2
        exit 1
      fi ;;
  esac
  json=$(jq -c --arg k "$k" --arg v "$v" '.[$k] = ($v | (tonumber? // .))' <<< "$json")
done

kind=$(jq -r '.kind // ""' <<< "$json")
gate=$(jq -r '.gate // ""' <<< "$json")

case "$kind" in
  run|finding) ;;
  "") echo "refusing to log: kind=run|finding is required." >&2; exit 1 ;;
  *)  echo "refusing to log: kind=$kind is not run|finding" >&2; exit 1 ;;
esac

[ -n "$gate" ] || { echo "refusing to log: gate=<agent name> is required." >&2; exit 1; }

# The checkout is not the repo. In a linked worktree the caller's
# `basename $(git rev-parse --show-toplevel)` is the worktree directory, so one
# repo logs under as many names as it has had worktrees and every per-repo rate
# splits across them. Derive it here instead of trusting the caller.
if canonical=$("$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../scripts" && pwd)/repo-name" 2>/dev/null); then
  json=$(jq -c --arg r "$canonical" '.repo = $r' <<< "$json")
fi

# `result` is the gate's verdict, reported as a distribution. It was collecting
# disposition words ("fix", "clean", "gaps", "actioned") instead — each one a
# bucket of size 1 reading as a verdict the reviewer never gave. Free text
# belongs in desc=.
#
# Rejecting outright loses the row, because telemetry never blocks the caller:
# the gates with no natural PASS/NEEDS CHANGES vocabulary (plan-verifier,
# test-intent-reviewer, test-reviewer) then log no run row at all and lose their
# denominator. So spelling and the known synonyms are folded in, and only a
# genuinely unmappable value is refused.
if [ "$kind" = run ]; then
  res=$(jq -r '.result // ""' <<< "$json")
  norm=$(printf '%s' "$res" | tr '[:lower:]' '[:upper:]' | tr '_-' '  ')
  case "$norm" in
    "") mapped="" ;;
    "PASS WITH WARNINGS"* | "PASS (NITS ONLY)") mapped="PASS WITH WARNINGS" ;;
    PASS | CLEAN* | "INTENT ALIGNED") mapped="PASS" ;;
    "NEEDS CHANGES"* | FINDINGS | GAPS | "GAPS FOUND" | RESIDUE) mapped="NEEDS CHANGES" ;;
    "NOT DISPATCHED"*) mapped="NOT DISPATCHED" ;;
    *)
      echo "refusing to log: result=$res is not PASS|PASS WITH WARNINGS|NEEDS CHANGES|NOT DISPATCHED" >&2
      echo "It is the gate's verdict, not what happened to the findings. Omit it if" >&2
      echo "the gate gave no verdict; put anything else in desc=." >&2
      exit 1 ;;
  esac
  if [ "$mapped" != "$res" ]; then
    [ -z "$mapped" ] || echo "note: result=$res logged as $mapped" >&2
    json=$(jq -c --arg r "$mapped" '.result = $r' <<< "$json")
  fi
fi

# `class` is the join key against review-escapes.jsonl. An unknown value cannot
# be cross-tabulated, and `other` is a legal answer that costs the analysis a
# bucket every time it is used as a shrug — nearly half of all findings landed
# there, dominated by stale comments and wrong documented rationale, which is
# what `docs` now exists for.
if [ "$kind" = finding ]; then
  cls=$(jq -r '.class // ""' <<< "$json")
  case "$cls" in
    "" | bug | smell | duplication | complexity | plan-drift | test-gap \
      | weak-assertion | security | perf | correctness | docs | other) ;;
    *)
      echo "refusing to log: class=$cls is not one of bug|smell|duplication|complexity|" >&2
      echo "plan-drift|test-gap|weak-assertion|security|perf|correctness|docs|other." >&2
      echo "The vocabulary is shared with log-escape so the caught and escaped sides" >&2
      echo "cross-tabulate; do not invent values." >&2
      exit 1 ;;
  esac
  fi_val=$(jq -r '.fix_induced // ""' <<< "$json")
  case "$fi_val" in
    "" | yes | no) ;;
    bug) json=$(jq -c '.blocker = "yes"' <<< "$json") ;;
    *)
      echo "refusing to log: fix_induced=$fi_val is not yes|no|bug." >&2
      echo "Only the literal 'bug' promotes the row to blocker=yes." >&2
      exit 1 ;;
  esac
fi

# A run row with no n_findings is the failure mode that silently destroys the
# denominator: it looks logged and counts as nothing.
if [ "$kind" = run ] && [ "$(jq -r '.n_findings // "MISSING"' <<< "$json")" = MISSING ]; then
  echo "refusing to log: kind=run needs n_findings=<n> (0 for a silent run)." >&2
  exit 1
fi

printf '%s\n' "$json" >> "$out"
echo "logged → $out"
