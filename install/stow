#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_info() { echo -e "${YELLOW}→${NC} $1"; }

PLATFORM=${1:-}

print_info "Creating symlinks with stow..."

# Get the dotfiles root (parent of install/)
DOTFILES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
cd "$DOTFILES_DIR"

# Backup existing configs
if [ -d ~/.config/nvim ] && [ ! -L ~/.config/nvim ]; then
    print_info "Backing up existing nvim config..."
    mv ~/.config/nvim ~/.config/nvim.backup.$(date +%Y%m%d_%H%M%S)
fi

if [ -f ~/.zshrc ] && [ ! -L ~/.zshrc ]; then
    print_info "Backing up existing zshrc..."
    mv ~/.zshrc ~/.zshrc.backup.$(date +%Y%m%d_%H%M%S)
fi

if [ -d ~/.claude ] && [ ! -L ~/.claude ]; then
    print_info "Backing up existing claude config..."
    mv ~/.claude ~/.claude.backup.$(date +%Y%m%d_%H%M%S)
fi

if [ -d ~/.config/opencode ] && [ ! -L ~/.config/opencode ]; then
    print_info "Backing up existing opencode config..."
    mv ~/.config/opencode ~/.config/opencode.backup.$(date +%Y%m%d_%H%M%S)
fi



if [ "$PLATFORM" = "arch" ] && [ -d ~/.config/hypr ] && [ ! -L ~/.config/hypr ]; then
    print_info "Backing up existing hypr config..."
    mv ~/.config/hypr ~/.config/hypr.backup.$(date +%Y%m%d_%H%M%S)
fi

# Stow configs — common packages for all platforms
PACKAGES="nvim scripts zsh claude opencode omp pi ghostty starship git lazygit herdr hunk"

# Arch-only packages
if [ "$PLATFORM" = "arch" ]; then
    PACKAGES="$PACKAGES hypr rofi walker waybar gtk dunst qt"
fi

# macOS-only packages
if [ "$PLATFORM" = "mac" ]; then
    PACKAGES="$PACKAGES aerospace"
fi

# One package at a time, NOT `stow -R $PACKAGES`: a single conflict makes stow
# abort the WHOLE run ("All operations aborted"), so one stale real file where a
# symlink belongs silently leaves every other package unlinked. Per-package, a
# conflict costs only that package and gets named at the end.
FAILED=""
for pkg in $PACKAGES; do
    if stow -R "$pkg" 2>/tmp/stow-$pkg.err; then
        print_success "stowed $pkg"
    else
        FAILED="$FAILED $pkg"
        print_error "stow $pkg failed:"
        sed 's/^/    /' /tmp/stow-$pkg.err
    fi
    rm -f /tmp/stow-$pkg.err
done

if [ -n "$FAILED" ]; then
    print_error "Unstowed packages:$FAILED"
    print_info "Usually a real file where a symlink belongs — move it aside, then re-run."
    exit 1
fi
print_success "Symlinks created"

# macOS: Ghostty reads from Application Support, symlink to stow-managed config
if [ "$PLATFORM" = "mac" ] && [ -d "$HOME/Library/Application Support/com.mitchellh.ghostty" ]; then
    GHOSTTY_MAC="$HOME/Library/Application Support/com.mitchellh.ghostty/config"
    if [ -f "$GHOSTTY_MAC" ] && [ ! -L "$GHOSTTY_MAC" ]; then
        print_info "Backing up existing macOS Ghostty config..."
        mv "$GHOSTTY_MAC" "$GHOSTTY_MAC.backup.$(date +%Y%m%d_%H%M%S)"
    fi
    if [ ! -L "$GHOSTTY_MAC" ]; then
        ln -s "$HOME/.config/ghostty/config" "$GHOSTTY_MAC"
        print_success "Ghostty macOS symlink created"
    fi
fi

# macOS: lazygit ignores ~/.config unless XDG_CONFIG_HOME is set, and reads
# Application Support instead — so the stowed config (hunk pager, editPreset,
# no subprocess return prompt) is invisible there. Symlink rather than export
# XDG_CONFIG_HOME: lazygit is launched from the herdr server's login
# environment, which never sources .zshrc.
if [ "$PLATFORM" = "mac" ]; then
    LAZYGIT_MAC="$HOME/Library/Application Support/lazygit/config.yml"
    mkdir -p "$(dirname "$LAZYGIT_MAC")"
    if [ -f "$LAZYGIT_MAC" ] && [ ! -L "$LAZYGIT_MAC" ]; then
        print_info "Backing up existing macOS lazygit config..."
        mv "$LAZYGIT_MAC" "$LAZYGIT_MAC.backup.$(date +%Y%m%d_%H%M%S)"
    fi
    if [ ! -L "$LAZYGIT_MAC" ]; then
        ln -s "$HOME/.config/lazygit/config.yml" "$LAZYGIT_MAC"
        print_success "lazygit macOS symlink created"
    fi
fi
