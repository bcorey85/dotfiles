#!/bin/bash
# Reopen a dead lane from its lane file, or close a finished one.
#
# Usage: herdr-lane-resume <name>
#        herdr-lane-resume --close <name|path>
#   <name>      the lane's name: its worktree folder name, as herdr-worktree --fork
#               recorded it in ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-lanes/<name>.json;
#               a relative XDG_STATE_HOME is ignored.
#               Opens a workspace on the worktree (a tuios session under tuios) and
#               runs herdr-dev --headless --resume there: the claude pane, alone in
#               its tab with no hunk pane, resumes the lane's session under its
#               name, with no fork, and is given the lane's latest brief. Stops,
#               changing nothing, when the worktree is gone, the entry holds no
#               session id, an agent of any kind already runs in the worktree or a
#               workspace is already open on it.
#   --close     for a finished lane: refuse while a claude agent in the worktree
#               is working; close the lane's workspace and wait up to
#               HERDR_LANE_CLOSE_WAIT seconds (default 10) for its agents, of any
#               kind, to leave; remove the lane entry; then run herdr-worktree-prune --apply
#               in the lane's main checkout, which removes the merged, clean
#               worktrees. Exits with the prune's exit code. Under tuios, which
#               gives its workspaces no worktree, a workspace labelled <name> is
#               also closed. An argument holding a / is a worktree path, anything
#               else a lane name.
#   entry-less  a name or path with no lane file entry closes too, when an open herdr
#               workspace sits on that linked worktree path, or on exactly one linked
#               worktree of that name (under tuios only a path works). Refuses, changing
#               nothing but the origin/<default> ref, for the main checkout, several
#               linked worktrees of that name, a working claude agent, or any tree that
#               `herdr-worktree-prune --check <worktree>` would keep (a detached
#               HEAD, the default branch, a branch not merged into
#               origin/<default> (a squash or rebase merge reads as unmerged),
#               uncommitted changes, a submodule, a nested repo, a stash entry,
#               a lock), or a check that fails; the message carries prune's reason.
#               Otherwise the same close and prune, minus the entry remove.
#
# herdr-dev and herdr-worktree-prune run from this script's own folder.
# Exit 1: a stop above, or an unknown name (the known names are listed).

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
bin_dir="$(cd "$(dirname "$0")" && pwd)"
# $0 is a stow symlink, so the library is found from the script's real path.
# shellcheck source-path=SCRIPTDIR/../lib source=toolkit-tools.bash
. "$(dirname "$(readlink -f "$0")")/../lib/toolkit-tools.bash"
# shellcheck source-path=SCRIPTDIR/../lib source=main-checkout.bash
. "$(dirname "$(readlink -f "$0")")/../lib/main-checkout.bash"

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

fail() {
    echo "herdr-lane-resume: $*" >&2
    exit 1
}

# The folder with links followed; a folder that is gone comes back as given.
real_path() {
    (cd -P "$1" 2>/dev/null && pwd) || printf '%s\n' "$1"
}

# Print the entry that `lanes.py get $@` finds (a lane name, or --containing <path>) as JSON,
# or nothing when the lane file has none.
find_entry() {
    local reply
    reply=$(python3 "$lanes_cli" get "$@") || fail "lanes.py get $* failed"
    jq -c '.entry // empty' <<<"$reply" || fail "lanes.py get $* returned invalid JSON"
}

# Print the names of the lanes in the lane file on one line, or "none".
known_lanes() {
    local reply names
    reply=$(python3 "$lanes_cli" list) || fail "lanes.py list failed"
    names=$(jq -r '.lanes[].name' <<<"$reply" | paste -sd ' ' -)
    printf '%s\n' "${names:-none}"
}

# Print the entry of lane $1 as JSON, or stop with the known names when there is none.
lane_entry() {
    local entry names
    entry=$(find_entry "$1") || exit 1
    if [ -z "$entry" ]; then
        names=$(known_lanes) || exit 1
        fail "no lane named $1; known lanes: $names"
    fi
    printf '%s\n' "$entry"
}

# Print "<pane id> <status>" for each agent whose cwd is inside worktree $1.
# $2 is what the failure message says about the state: "nothing changed" before any close.
# $3 limits the rows to agents of that kind (for example "claude"); empty means every agent.
# session_pane.py decides which agents are inside the folder.
agents_in() {
    local agents rows outcome="${2:-nothing changed}" kind="${3:-}"
    agents=$(python3 "$session_pane" agents-in "$1" ${kind:+"$kind"} 2>&1) \
        || fail "$agents; $outcome"
    rows=$(jq -r '.[] | [.pane_id, (.agent_status // "")] | join(" ")' <<<"$agents") \
        || fail "session_pane.py agents-in printed an unexpected shape; $outcome"
    [ -z "$rows" ] || printf '%s\n' "$rows"
}

# Print one row per open workspace: id, label, checkout path and whether the checkout is a
# linked worktree (true or false), joined by the \x1f character.
workspace_rows() {
    local workspace_list rows
    workspace_list=$(herdr-api workspace list) || fail "herdr-api workspace list failed; nothing changed"
    rows=$(jq -r '.result.workspaces[] | [.workspace_id, .label, (.worktree.checkout_path // ""), (.worktree.is_linked_worktree // false | tostring)] | join("\u001f")' <<<"$workspace_list") \
        || fail "herdr-api workspace list has an unexpected shape; nothing changed"
    printf '%s\n' "$rows"
}

# Print the id of each workspace open on worktree $1. Under tuios, which gives its
# workspaces no worktree, a workspace labelled $2 counts as well.
workspaces_on() {
    local rows workspace_id label checkout linked
    rows=$(workspace_rows) || exit 1
    while IFS=$'\x1f' read -r workspace_id label checkout linked; do
        [ -n "$workspace_id" ] || continue
        if [ -n "$checkout" ] && [ "$(real_path "$checkout")" = "$1" ]; then
            printf '%s\n' "$workspace_id"
        elif [ -n "${TUIOS_SOCKET:-}" ] && [ "$label" = "$2" ]; then
            printf '%s\n' "$workspace_id"
        fi
    done <<<"$rows"
}

resume_lane() {
    local name="$1" entry wt main_checkout session brief live_pane open_ws opened ws

    entry=$(lane_entry "$name")
    wt=$(jq -r '.worktree' <<<"$entry")
    main_checkout=$(jq -r '.main_checkout' <<<"$entry")
    session=$(jq -r '.session_id' <<<"$entry")
    brief=$(jq -r '.brief' <<<"$entry")

    [ -d "$wt" ] || fail "worktree gone; run herdr-lane-resume --close $name"
    wt=$(real_path "$wt")
    [ -n "$session" ] \
        || fail "the fork never reported a session id; open the worktree and run claude there"

    live_pane=$(agents_in "$wt" | sed -n '1s/ .*//p')
    [ -z "$live_pane" ] || fail "lane is live in pane $live_pane"
    open_ws=$(workspaces_on "$wt" "$name" | sed -n 1p)
    [ -z "$open_ws" ] || fail "workspace $open_ws is already open on it; close it, then rerun"

    if [ -n "${TUIOS_SOCKET:-}" ]; then
        opened=$(herdr-api workspace create --cwd "$wt" --label "$name" --focus) \
            || fail "workspace create failed"
    else
        opened=$(herdr worktree open --cwd "$main_checkout" --path "$wt" --label "$name" --focus) \
            || fail "herdr worktree open failed"
    fi
    ws=$(jq -r '.result.workspace.workspace_id // empty' <<<"$opened")
    [ -n "$ws" ] || fail "open reply has no workspace id: $opened"
    # tuios ignores --focus, and herdr-dev's layout calls need the client on this workspace.
    if [ -n "${TUIOS_SOCKET:-}" ]; then
        herdr-api workspace focus "$ws" >/dev/null
    fi

    "$bin_dir/herdr-dev" --headless --resume "$wt" "$ws" "$session" "$brief"
}

# Close workspace $1 through the multiplexer this shell lives in.
close_workspace() {
    if [ -n "${TUIOS_SOCKET:-}" ]; then
        herdr-api workspace close "$1"
    else
        herdr workspace close "$1"
    fi
}

# Wait for the agents of worktree $1 to leave, 0.5 s apart, up to $2 seconds (a whole number).
# $3 ends the failure message.
wait_for_agents_to_leave() {
    local wait_seconds=$((10#$2)) attempt remaining
    for ((attempt = 0; attempt <= wait_seconds * 2; attempt++)); do
        remaining=$(agents_in "$1" "$3")
        [ -n "$remaining" ] || return 0
        if [ "$attempt" -lt $((wait_seconds * 2)) ]; then
            sleep 0.5
        fi
    done
    echo "herdr-lane-resume: an agent still runs in $1; the prune will keep it" >&2
}

# Print the seconds to wait for agents after a close. Called before any workspace closes,
# so a bad value changes nothing.
checked_close_wait() {
    local close_wait="${HERDR_LANE_CLOSE_WAIT:-10}"
    [[ "$close_wait" =~ ^[0-9]+$ ]] || fail "HERDR_LANE_CLOSE_WAIT must be a whole number of seconds, got: $close_wait"
    printf '%s\n' "$close_wait"
}

array_has() {
    local wanted="$1" item
    shift
    for item in "$@"; do
        [ "$item" = "$wanted" ] && return 0
    done
    return 1
}

# Print the checkout path of the one linked worktree whose folder name is $1, from the open
# workspaces. Refuses, changing nothing, on zero, several, the main checkout, or tuios.
match_workspace_name() {
    local name="$1" rows workspace_id label checkout linked resolved names
    local linked_matches=() plain_matches=()

    if [ -n "${TUIOS_SOCKET:-}" ]; then
        names=$(known_lanes) || exit 1
        fail "no lane file entry for $name, and under tuios a name cannot be matched to a worktree; pass the worktree path; known lanes: $names; nothing changed"
    fi
    rows=$(workspace_rows) || exit 1
    while IFS=$'\x1f' read -r workspace_id label checkout linked; do
        [ -n "$checkout" ] || continue
        resolved=$(real_path "$checkout")
        [ "$(basename "$resolved")" = "$name" ] || continue
        if [ "$linked" = "true" ]; then
            # Two workspaces on one worktree are one match.
            array_has "$resolved" ${linked_matches[@]+"${linked_matches[@]}"} || linked_matches+=("$resolved")
        else
            array_has "$resolved" ${plain_matches[@]+"${plain_matches[@]}"} || plain_matches+=("$resolved")
        fi
    done <<<"$rows"

    if [ "${#linked_matches[@]}" -gt 1 ]; then
        fail "several worktrees named $name have a workspace open: ${linked_matches[*]}; pass the worktree path; nothing changed"
    fi
    if [ "${#linked_matches[@]}" -eq 1 ]; then
        printf '%s\n' "${linked_matches[0]}"
        return 0
    fi
    if [ "${#plain_matches[@]}" -gt 0 ]; then
        fail "$name is the main checkout (${plain_matches[0]}), not a lane worktree; nothing changed"
    fi
    names=$(known_lanes) || exit 1
    fail "no lane named $name; known lanes: $names"
}

# Stops, changing nothing, unless herdr-worktree-prune --check (run from main checkout $2)
# says the state of worktree $1 lets the prune remove it. The refusal carries prune's reason.
prune_check_allows() {
    local wt="$1" main_checkout="$2" verdict_json verdict code reason

    verdict_json=$(cd "$main_checkout" && "$bin_dir/herdr-worktree-prune" --check "$wt") \
        || fail "herdr-worktree-prune --check $wt failed; nothing changed"
    verdict=$(jq -r '.verdict' <<<"$verdict_json") \
        || fail "herdr-worktree-prune --check printed an unexpected shape; nothing changed"
    [ "$verdict" != "remove" ] || return 0
    code=$(jq -r '.code' <<<"$verdict_json")
    reason=$(jq -r '.reason' <<<"$verdict_json")
    fail "herdr-worktree-prune would keep $wt ($code): $reason; nothing changed"
}

# Print the pane id of the first working claude agent inside worktree $1, or nothing.
working_agent_pane() {
    # awk reads all its input: an early exit would SIGPIPE agents_in and fail the pipeline.
    agents_in "$1" "nothing changed" claude | awk '$2 == "working" && !found { print $1; found = 1 }'
}

# Close workspaces $2 (ids, one per line), then wait up to $3 seconds for the agents of
# worktree $1 to leave. $4 ends the failure message when a close fails; $5 ends it when the
# agent check fails after the workspaces closed.
close_workspaces() {
    local wt="$1" workspace_ids="$2" close_wait="$3" outcome="$4" closed_outcome="$5" workspace_id
    for workspace_id in $workspace_ids; do
        close_workspace "$workspace_id" >/dev/null \
            || fail "could not close workspace $workspace_id; $outcome"
    done
    if [ -n "$workspace_ids" ]; then
        wait_for_agents_to_leave "$wt" "$close_wait" "$closed_outcome"
    fi
}

# Run herdr-worktree-prune --apply in main checkout $1 and return its exit code.
prune_main_checkout() {
    local prune_status=0
    (cd "$1" && "$bin_dir/herdr-worktree-prune" --apply) || prune_status=$?
    return "$prune_status"
}

# Close a merged lane that has no lane file entry: worktree $1 is a linked worktree with an
# open workspace and no working agent. Same sequence as close_lane minus the entry remove.
entryless_close() {
    local wt="$1" close_wait main_checkout name working workspace_ids

    close_wait=$(checked_close_wait) || exit 1
    [ -d "$wt" ] || fail "no lane file entry and no folder at $wt"
    wt=$(real_path "$wt")
    is_linked_worktree "$wt" || fail "$wt is not a linked worktree"
    if ! is_worktree_top "$wt"; then
        fail "$wt is not the top of a linked worktree; nothing changed"
    fi
    main_checkout=$(main_checkout_of "$wt") || exit 1

    name=$(basename "$wt")
    workspace_ids=$(workspaces_on "$wt" "$name") || exit 1
    [ -n "$workspace_ids" ] || fail "no herdr workspace is open on $wt; nothing changed; if an earlier close left the worktree, run herdr-worktree-prune --apply in $main_checkout"

    working=$(working_agent_pane "$wt")
    [ -z "$working" ] \
        || fail "$wt has a working agent in pane $working; wait for it to finish, then rerun"

    # The prune keeps what its own rules keep, so refuse before the workspace closes.
    prune_check_allows "$wt" "$main_checkout"

    close_workspaces "$wt" "$workspace_ids" "$close_wait" "nothing was pruned" "the workspaces are already closed and nothing was pruned"
    prune_main_checkout "$main_checkout"
}

# Close the lane named or located by $1: a lane file entry takes the entry path, none takes
# the entry-less path. An argument holding a / is a worktree path, anything else a lane name.
close_target() {
    local arg="$1" wt entry entry_worktree entry_name worktree

    if [[ "$arg" == */* ]]; then
        # A path that is gone cannot resolve: anchor a relative one so it names the same folder from any cwd.
        # os.path.realpath also folds ".." and symlinks in the part that exists (realpath -m is missing on macOS).
        [[ "$arg" == /* || -d "$arg" ]] || arg=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$PWD/$arg")
        wt=$(real_path "$arg")
        entry=$(find_entry --containing "$wt") || exit 1
        if [ -n "$entry" ]; then
            entry_worktree=$(jq -r '.worktree' <<<"$entry")
            if [ "$(real_path "$entry_worktree")" = "$wt" ]; then
                entry_name=$(jq -r '.name' <<<"$entry")
                close_lane "$entry_name"
                return
            fi
        fi
        entryless_close "$wt"
        return
    fi

    entry=$(find_entry "$arg") || exit 1
    if [ -n "$entry" ]; then
        close_lane "$arg"
        return
    fi
    # Its own line, so a refusal inside stops the script (an assignment keeps errexit).
    worktree=$(match_workspace_name "$arg")
    entryless_close "$worktree"
}

close_lane() {
    local name="$1" entry wt main_checkout working workspace_ids close_wait

    close_wait=$(checked_close_wait) || exit 1

    entry=$(lane_entry "$name")
    wt=$(jq -r '.worktree' <<<"$entry")
    main_checkout=$(jq -r '.main_checkout' <<<"$entry")
    [ ! -d "$wt" ] || wt=$(real_path "$wt")

    working=$(working_agent_pane "$wt")
    [ -z "$working" ] \
        || fail "lane $name has a working agent in pane $working; wait for it to finish, then rerun"

    workspace_ids=$(workspaces_on "$wt" "$name")
    close_workspaces "$wt" "$workspace_ids" "$close_wait" "the lane entry is kept and nothing was pruned" "the workspaces are already closed and the lane entry is kept"

    [ -d "$wt" ] || echo "herdr-lane-resume: worktree $wt is already gone; removing the entry" >&2
    python3 "$lanes_cli" remove "$name" >/dev/null

    if [ ! -d "$main_checkout" ]; then
        echo "herdr-lane-resume: main checkout $main_checkout is gone; nothing to prune"
        return 0
    fi
    prune_main_checkout "$main_checkout"
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --close)
        [ $# -eq 2 ] || fail "--close needs one lane name or worktree path"
        close_target "$2"
        ;;
    -*) echo "herdr-lane-resume: unknown option: $1" >&2; usage >&2; exit 1 ;;
    "") usage >&2; exit 1 ;;
    *)
        [ $# -eq 1 ] || fail "one lane name only"
        resume_lane "$1"
        ;;
esac
