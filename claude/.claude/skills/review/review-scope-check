#!/usr/bin/env bash
# review-scope-check — no-model check for review-scope
#
# usage: review-scope-check [tmpdir]
#   Builds one throwaway fixture repo per mode family under tmpdir (default:
#   $TMPDIR or /tmp), runs review-scope against each, and asserts the expected
#   sections. Prints one line per case and exits non-zero on the first failure.
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
scope="$here/review-scope"
work=$(mktemp -d "${1:-${TMPDIR:-/tmp}}/review-scope-check.XXXXXX")
trap 'rm -rf "$work"' EXIT
fails=0

if [ -z "${BRANCH_BASE_SCRIPT:-}" ] && [ -x "$here/branch-base" ]; then
  export BRANCH_BASE_SCRIPT="$here/branch-base"
fi

pass() { printf 'ok    %s\n' "$1"; }
fail() { printf 'FAIL  %s\n     %s\n' "$1" "$2"; fails=$((fails + 1)); }

assert() { # name haystack needle
  case "$2" in
    *"$3"*) pass "$1" ;;
    *) fail "$1" "missing: $3" ;;
  esac
}

refute() { # name haystack needle
  case "$2" in
    *"$3"*) fail "$1" "unexpected: $3" ;;
    *) pass "$1" ;;
  esac
}

newrepo() { # dir [branch]
  mkdir -p "$1" && git -C "$1" init -q -b "${2:-main}"
  git -C "$1" config user.email check@example.invalid
  git -C "$1" config user.name check
  printf 'one\n' >"$1/kept.txt"
  git -C "$1" add -A && git -C "$1" commit -qm base
}

# --- family 1: not a git repo -------------------------------------------------
mkdir -p "$work/plain"
out=$("$scope" root="$work/plain")
assert "not-a-repo: empty ROOT" "$out" "ROOT="
assert "not-a-repo: all sections present" "$out" "UNTRACKED="
[ "$(printf '%s\n' "$out" | wc -l)" = 8 ] && pass "not-a-repo: 8 lines" \
  || fail "not-a-repo: 8 lines" "got $(printf '%s\n' "$out" | wc -l)"

# --- family 2: worktree (unstaged + staged + untracked) -----------------------
newrepo "$work/wt"
printf 'one\ntwo\n' >"$work/wt/kept.txt"          # unstaged edit
printf 'x\n' >"$work/wt/staged.txt" && git -C "$work/wt" add staged.txt
printf 'y\n' >"$work/wt/new.txt"                  # untracked
out=$("$scope" root="$work/wt")
assert "worktree: repo root"      "$out" "ROOT=$work/wt"
assert "worktree: branch"         "$out" "BRANCH=main"
assert "worktree: unstaged file"  "$out" "kept.txt"
assert "worktree: staged file"    "$out" "staged.txt"
assert "worktree: untracked file" "$out" "new.txt"
assert "worktree: numstat row"    "$out" "1	0	kept.txt"
assert "worktree: shortstat"      "$out" "2 files changed"
refute "worktree: no diff text"   "$out" "@@"
refute "worktree: no added lines" "$out" "+two"

# --- family 3: staged only ----------------------------------------------------
out=$("$scope" root="$work/wt" mode=staged)
assert "staged: staged file"        "$out" "staged.txt"
files=${out#*FILES=}; files=${files%%NUMSTAT=*}
refute "staged: FILES holds only the staged file" "$files" "kept.txt"
refute "staged: no diff text"       "$out" "@@"

# --- family 4: path filter ----------------------------------------------------
newrepo "$work/pf"
mkdir -p "$work/pf/a" "$work/pf/b"
printf '1\n' >"$work/pf/a/f.txt"
printf '1\n' >"$work/pf/b/f.txt"
git -C "$work/pf" add -A && git -C "$work/pf" commit -qm two
printf '2\n' >>"$work/pf/a/f.txt"
printf '2\n' >>"$work/pf/b/f.txt"
out=$("$scope" root="$work/pf" paths=a)
assert "paths: included dir" "$out" "a/f.txt"
refute "paths: excluded dir" "$out" "b/f.txt"

# --- family 5: bad input ------------------------------------------------------
"$scope" mode=bogus >/dev/null 2>&1 && fail "bad mode: exit 2" "exited 0" || pass "bad mode: exit 2"
"$scope" nonsense=1 >/dev/null 2>&1 && fail "bad key: exit 2" "exited 0" || pass "bad key: exit 2"

# --- family 6: invocation log -------------------------------------------------
unset CLAUDE_TOOLKIT_TELEMETRY  # a session that exports it would turn the switch on for "switch absent" below
fakehome="$work/home"
mkdir -p "$fakehome/.claude"
[ -x "$here/../../scripts/telemetry/telemetry_enabled.sh" ] || fail "helper missing" "$here/../../scripts/telemetry/telemetry_enabled.sh"

if command -v ledger >/dev/null 2>&1; then
  ledger_root="$work/ledger-root"
  review_scope_rows() { # the worker runs first so the cache is not behind; its errors go to stderr
    AGENT_LEDGER_ROOT="$ledger_root" ledger worker --once >/dev/null || return
    AGENT_LEDGER_ROOT="$ledger_root" ledger query "select skill, caller from review_scope" | tail -n +2
  }

  # switch absent: no row
  AGENT_LEDGER_ROOT="$ledger_root" HOME="$fakehome" "$scope" root="$work/wt" caller=review >/dev/null
  [ -z "$(review_scope_rows)" ] && pass "log: switch absent, no row" || fail "log: switch absent, no row" "got: $(review_scope_rows)"
  export CLAUDE_TOOLKIT_TELEMETRY=1

  out=$(AGENT_LEDGER_ROOT="$ledger_root" HOME="$fakehome" "$scope" root="$work/wt" caller=review)
  refute "log: nothing on stdout" "$out" '"skill"'
  assert "log: scope still printed" "$out" "SHORTSTAT="
  rows=$(review_scope_rows)
  [ "$rows" = "$(printf 'review-loop\treview')" ] && pass "caller_writes_review_scope_row" \
    || fail "caller_writes_review_scope_row" "got: $rows"

  # no caller: no row
  AGENT_LEDGER_ROOT="$ledger_root" HOME="$fakehome" "$scope" root="$work/wt" >/dev/null
  [ "$(review_scope_rows | wc -l | tr -d ' ')" = 1 ] && pass "log: no caller, no row" \
    || fail "log: no caller, no row" "got: $(review_scope_rows)"
else
  printf 'skip  ledger not on PATH\n'
fi

# --- family 7: pushed feature branch --------------------------------------------
# push -u makes origin/feature the upstream; MERGE_BASE must still be the fork point
git init -q --bare -b main "$work/origin.git"
git clone -q "$work/origin.git" "$work/pushed" 2>/dev/null
git -C "$work/pushed" config user.email check@example.invalid
git -C "$work/pushed" config user.name check
git -C "$work/pushed" checkout -q -b main 2>/dev/null
printf 'one\n' >"$work/pushed/kept.txt"
git -C "$work/pushed" add -A && git -C "$work/pushed" commit -qm base
git -C "$work/pushed" push -q -u origin main
git -C "$work/pushed" remote set-head origin main >/dev/null 2>&1
fork=$(git -C "$work/pushed" rev-parse origin/main)
git -C "$work/pushed" checkout -q -b feature
printf 'f1\n' >"$work/pushed/f1.txt" && git -C "$work/pushed" add -A && git -C "$work/pushed" commit -qm f1
git -C "$work/pushed" push -q -u origin feature
printf 'f2\n' >"$work/pushed/f2.txt" && git -C "$work/pushed" add -A && git -C "$work/pushed" commit -qm f2
git -C "$work/pushed" push -q
tip=$(git -C "$work/pushed" rev-parse origin/feature)
out=$("$scope" root="$work/pushed")
assert "pushed branch: MERGE_BASE is the origin/main fork point" "$out" "MERGE_BASE=$fork"
refute "pushed branch: MERGE_BASE is not the origin/feature tip" "$out" "MERGE_BASE=$tip"

# --- family 8: default branch with an unpushed commit ---------------------------
git -C "$work/pushed" checkout -q main
printf 'm2\n' >"$work/pushed/m2.txt" && git -C "$work/pushed" add -A && git -C "$work/pushed" commit -qm m2
out=$("$scope" root="$work/pushed")
assert "default branch: MERGE_BASE is the pushed tip" "$out" "MERGE_BASE=$fork"

# --- family 9: branch-base missing or failing --------------------------------------
out=$(BRANCH_BASE_SCRIPT=/nonexistent "$scope" root="$work/pushed" base=HEAD 2>"$work/err.txt")
assert "no branch-base: MERGE_BASE empty" "$out" "MERGE_BASE=
"
assert "no branch-base: other sections still printed" "$out" "SHORTSTAT="
assert "no branch-base: reason on stderr" "$(cat "$work/err.txt")" "MERGE_BASE empty: not executable at /nonexistent"
out=$(BRANCH_BASE_SCRIPT=/bin/false "$scope" root="$work/pushed" base=HEAD 2>"$work/err.txt")
assert "failing branch-base: exit code on stderr" "$(cat "$work/err.txt")" "MERGE_BASE empty: branch-base exit 1"

newrepo "$work/nobase" trunk
git -C "$work/nobase" checkout -q -b topic
out=$("$scope" root="$work/nobase" 2>"$work/err.txt")
assert "no base found: MERGE_BASE empty" "$out" "MERGE_BASE=
"
assert "no base found: reason on stderr" "$(cat "$work/err.txt")" "MERGE_BASE empty: branch-base exit 1: no base found for topic"
refute "no base found: no instruction to ask the user" "$(cat "$work/err.txt")" "ask the user"
refute "no base found: no STOP prefix" "$(cat "$work/err.txt")" "STOP:"

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -S warning "$scope" && pass "shellcheck clean" || fail "shellcheck clean" "see output"
else
  printf 'skip  shellcheck not installed\n'
fi

printf '\n%s failure(s)\n' "$fails"
[ "$fails" -eq 0 ]
