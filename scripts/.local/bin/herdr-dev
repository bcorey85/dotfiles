#!/bin/bash
# Launch a coding layout for a project in a herdr workspace (a tuios session
# under tuios).
#
# Usage: herdr-dev [directory] [workspace_id] [claude_session] [start_prompt]
#   directory       defaults to cwd; all panes open there.
#   workspace_id    defaults to the workspace of the current pane (requires
#                   running inside herdr or tuios). herdr-project-open passes it
#                   explicitly so the layout lands in the workspace it just made.
#   claude_session  a Claude session id; the claude pane opens a fork of that
#                   conversation instead of a fresh one (herdr-worktree --fork).
#   start_prompt    free text; with claude_session, the forked session starts
#                   working on it at once. Any text up to 128 KiB is safe: it
#                   reaches the pane through a temp file, not the typed command
#                   line, and follows `--`. The file is removed only once claude
#                   exits cleanly, so a failed start keeps the brief.
#
# Prints the claude pane's id, then the command typed into it, one per line.
#
# Layout:
#   Tab 1 "code"     claude (40%) | nvim (60%). herdr auto-detects the claude
#                    process and adopts the pane as a managed agent, so it gets
#                    tab-bar status and `herdr agent read/prompt/wait` for free.
#   Tab 2 "console"  three equal shells for git / tests / logs. If the project
#                    has an mprocs config, pane 1 runs the service stack under
#                    mprocs instead of a bare shell. Config lookup order:
#                      1. <project>/mprocs.yaml
#                      2. ~/.config/mprocs/projects/<basename>.yaml
#
# send-text writes literal text without submitting; send-keys enter is the
# separate submit. Hence the run() helper. A fresh pane's shell can take bytes
# before its prompt is drawn, so start_in_fresh_pane() waits for the prompt and
# clears the input line before it types.
#
# Under tuios the layout calls need a client on the workspace. tuios splits the
# focused pane 50/50 whatever the --ratio, and opens a new tab untiled, so the
# tuios branches below resize the code tab and build the console natively.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

dir="${1:-.}"
dir="$(cd "$dir" && pwd)" || { echo "herdr-dev: no such directory: ${1:-.}" >&2; exit 1; }
ws="${2:-}"
claude_session="${3:-}"
start_prompt="${4:-}"

if [ -z "$ws" ]; then
    ws=$(herdr-api pane current 2>/dev/null | jq -r '.result.pane.workspace_id // empty')
fi
if [ -z "$ws" ]; then
    echo "herdr-dev: no workspace — pass one, or run inside herdr or tuios" >&2
    exit 1
fi

# Type a command into a pane and submit it.
run() {
    herdr-api pane send-text "$1" "$2" >/dev/null
    herdr-api pane send-keys "$1" enter >/dev/null
}

# Run a command in a pane whose shell just started. The wait is best effort: a
# prompt that never matches still gets the command after the timeout.
start_in_fresh_pane() {
    herdr-api pane wait-output "$1" --regex '\S' --timeout 10000 >/dev/null 2>&1 || true
    herdr-api pane send-keys "$1" ctrl+u >/dev/null
    run "$1" "$2"
}

# Split $1 and echo the new pane's id.
split() {
    herdr-api pane split "$1" --direction right --ratio "$2" --cwd "$dir" --no-focus \
        | jq -r '.result.pane.pane_id'
}

# The tuios session behind herdr workspace id w<12 hex>: the session whose id
# starts with those hex digits.
tuios_session() {
    local session_id_prefix="${ws#w}"

    tuios ls --json \
        | jq -r --arg id "$session_id_prefix" \
            '.[] | select((.id | gsub("-"; "")) | startswith($id)) | .name'
}

# Fill the focused, untiled console tab with three equal tiled columns.
build_tuios_console() {
    local session second_pane

    session=$(tuios_session)
    tuios set-layout -s "$session" --tiling true >/dev/null

    second_pane=$(tuios split-window right -s "$session" --json | jq -r '.window_id')
    tuios split-window right -s "$session" -w "$second_pane" >/dev/null

    # BSP leaves 50 | 25 | 25. Narrowing the first column by 1/6 of the width
    # gives 1/3 each, since the right half keeps its 50/50 split.
    herdr-api pane resize --direction left --amount 0.1667 --pane "$c1" >/dev/null
}

# ── Tab 1 "code": claude (40%) | nvim (60%) ─────────────────────────────────
code_tab=$(herdr-api workspace get "$ws" | jq -r '.result.workspace.active_tab_id')
agent=$(herdr-api pane list --workspace "$ws" \
    | jq -r --arg t "$code_tab" '.result.panes[] | select(.tab_id == $t) | .pane_id' | head -1)

herdr-api tab rename "$code_tab" code >/dev/null
herdr-api pane rename "$agent" claude >/dev/null
claude_cmd="claude"
if [ -n "$claude_session" ]; then
    claude_cmd="claude --resume $claude_session --fork-session"
    if [ -n "$start_prompt" ]; then
        # The pane shell would expand quotes, $ and backticks typed into it, so
        # the text travels in a file; the text is never re-parsed.
        prompt_file=$(mktemp)
        printf '%s' "$start_prompt" >"$prompt_file"
        claude_cmd="$claude_cmd -- \"\$(cat '$prompt_file')\" && rm -f '$prompt_file'"
    fi
fi
start_in_fresh_pane "$agent" "$claude_cmd"

editor=$(split "$agent" 0.4)
herdr-api pane rename "$editor" editor >/dev/null
run "$editor" "nvim ."

if [ -n "${TUIOS_SOCKET:-}" ]; then
    # 50 | 50 to 40 | 60: move the editor's left edge a tenth of the width.
    herdr-api pane resize --direction left --amount 0.1 --pane "$editor" >/dev/null
fi

# ── Tab 2 "console": three equal shells ─────────────────────────────────────
console=$(herdr-api tab create --workspace "$ws" --label console --cwd "$dir" --no-focus)
c1=$(jq -r '.result.root_pane.pane_id' <<<"$console")

if [ -n "${TUIOS_SOCKET:-}" ]; then
    console_tab=$(jq -r '.result.tab.tab_id' <<<"$console")
    herdr-api tab focus "$console_tab" >/dev/null
    build_tuios_console
else
    # 1/3 then half of the remaining 2/3 => three equal columns.
    c2=$(split "$c1" 0.3334)
    split "$c2" 0.5 >/dev/null
fi

mprocs_cfg=""
if [ -f "$dir/mprocs.yaml" ]; then
    mprocs_cfg="$dir/mprocs.yaml"
elif [ -f "$HOME/.config/mprocs/projects/$(basename "$dir").yaml" ]; then
    mprocs_cfg="$HOME/.config/mprocs/projects/$(basename "$dir").yaml"
fi
if [ -n "$mprocs_cfg" ] && command -v mprocs &>/dev/null; then
    run "$c1" "mprocs --config \"$mprocs_cfg\""
fi

# Land on the editor. `pane focus` is directional only — there is no
# focus-this-id form — so aim right from the claude pane.
herdr-api tab focus "$code_tab" >/dev/null
herdr-api pane focus --direction right --pane "$agent" >/dev/null

printf '%s\n' "$agent" "$claude_cmd"
