#!/bin/bash
# Create a git worktree as its own herdr workspace (a tuios session under
# tuios), laid out by herdr-dev.
#
# Usage: herdr-worktree [--fork --prompt-file <path> | --fork --prompt <text>]
#                       [--base <ref>] [branch]
#   branch        prompted for when omitted (the prefix+ctrl+w popup).
#   --fork        carry the Claude conversation running in this pane into the
#                 new workspace's claude pane, as a forked session. Needs a
#                 brief: --prompt-file or --prompt. The forked lane opens
#                 without the hunk pane (herdr-dev --headless).
#   --prompt-file the file holding the brief the forked session starts working
#                 on at once. Only with --fork.
#   --prompt      the brief as text, in place of --prompt-file.
#   --base        the ref to branch off. With --fork it defaults to HEAD, the
#                 branch the forked conversation was working on. Otherwise it
#                 defaults to origin's default branch, fetched first, or HEAD
#                 when the repo has no origin.
#
# The worktree lands beside the main checkout: <repo>-<TICKET-NUM> for a
# TICKET-NUM-desc branch, otherwise <repo>-<desc> (feature/ and fix/ dropped,
# remaining slashes as dashes). When that folder is taken, as by a second
# branch for one ticket, it is <repo>-<branch> instead.
# The branch is pushed to origin when that remote exists.
# Node dependencies are installed for each tracked package-lock.json or
# pnpm-lock.yaml at the worktree root or one folder down, before the panes
# start. Their output goes to herdr-worktree-install.log in the worktree's git
# dir; a failed install names the command and that log.
# A gitignored .python-version in the main checkout is linked into the new
# worktree when the worktree has none, so the gates find the pin there.
#
# With --fork, the run fails when the new claude pane shows no claude agent
# within HERDR_WORKTREE_FORK_TIMEOUT seconds (default 30). The error names the
# pane and the command to run there. Once the fork starts, herdr-worktree-watch
# checks the workspace HERDR_WORKTREE_WATCH_SECONDS later (default 120). If the
# workspace is gone it writes the recovery steps to herdr-worktree-watch.log in
# the worktree's git dir and shows a herdr notification that names that log (no
# notification under tuios). When the lane entry holds the fork's session id, the log
# holds one step, `1. herdr-lane-resume <worktree folder name>` (herdr and tuios alike).
# The steps below apply when the entry is missing or its session id is empty. With the
# fork's session id they are two:
#   1. herdr worktree open --cwd <main checkout> --path <worktree> --focus
#   2. herdr-dev --headless <worktree> <ws> <fork session id> '<resume prompt>'
# <ws> is the workspace id that step 1 prints (.result.workspace.workspace_id);
# the prompt is a short "go on", not the original brief. Under tuios step 1 is
#   1. herdr-api workspace create --cwd <worktree> --label <worktree folder name> --focus
# and step 2 starts with `herdr-api workspace focus <ws> >/dev/null && `.
# Without the session id, step 1 stays and step 2 is
# `CLAUDE_CODE_DISABLE_CRON=1 claude --resume` run in the worktree. The watcher is
# given this conversation's session id and keeps waiting while the pane reports it,
# so step 2 never names the parent.
# The watcher's own output goes to that log too.
#
# With --fork the run also writes a lane entry before herdr-dev starts: the brief,
# worktree, branch, main checkout and the name of the session that forked, in
# ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-lanes/<worktree folder name>.json (a
# relative XDG_STATE_HOME is ignored). The
# watcher fills in the fork's session id, and herdr-phase-change keeps the session id
# and brief current. A failed write warns and the fork still starts; recovery for that
# lane is then the steps above. `herdr-lane-resume <name>` reopens a lane from its entry.
# A run without --fork writes no entry.
#
# Every pane in the new workspace starts in the worktree, so popups that
# inherit the pane cwd (prefix+d, prefix+g, prefix+space, ...) see it too.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
bin_dir="$(cd "$(dirname "$0")" && pwd)"
# $0 is a stow symlink, so the library is found from the script's real path.
script_dir="$(dirname "$(readlink -f "$0")")"
# shellcheck source-path=SCRIPTDIR/../lib source=toolkit-tools.bash
. "$script_dir/../lib/toolkit-tools.bash"
# shellcheck source-path=SCRIPTDIR/../lib source=main-checkout.bash
. "$script_dir/../lib/main-checkout.bash"

fail() {
    echo "herdr-worktree: $*" >&2
    exit 1
}

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

fork=""
prompt=""
prompt_file=""
base=""
branch=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --fork) fork=1 ;;
        --prompt)
            [ $# -ge 2 ] || { echo "herdr-worktree: --prompt needs text" >&2; exit 1; }
            prompt="$2"
            shift
            ;;
        --prompt-file)
            [ $# -ge 2 ] || { echo "herdr-worktree: --prompt-file needs a path" >&2; exit 1; }
            prompt_file="$2"
            shift
            ;;
        --base)
            [ $# -ge 2 ] || { echo "herdr-worktree: --base needs a ref" >&2; exit 1; }
            base="$2"
            shift
            ;;
        -*) echo "herdr-worktree: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)
            [ -z "$branch" ] || { echo "herdr-worktree: one branch only" >&2; exit 1; }
            branch="$1"
            ;;
    esac
    shift
done

if [ -n "$prompt_file" ]; then
    [ -z "$prompt" ] || { echo "herdr-worktree: give --prompt or --prompt-file, not both" >&2; exit 1; }
    prompt=$(cat -- "$prompt_file")
fi

[ -z "$fork" ] || [ -n "$prompt" ] \
    || { echo "herdr-worktree: --fork needs a brief for the forked session: --prompt-file <path> or --prompt <text>" >&2; exit 1; }
[ -z "$prompt" ] || [ -n "$fork" ] \
    || { echo "herdr-worktree: --prompt and --prompt-file only work with --fork" >&2; exit 1; }

command -v herdr-api >/dev/null \
    || { echo "herdr-worktree: herdr-api is not on PATH; run ~/dotfiles/install/stow to link it into ~/.local/bin" >&2; exit 1; }

watch_seconds="${HERDR_WORKTREE_WATCH_SECONDS:-120}"
fork_timeout="${HERDR_WORKTREE_FORK_TIMEOUT:-30}"
if [ -n "$fork" ]; then
    # Checked before anything is created: a failure after the fork starts would
    # report a working fork as failed.
    missing_helpers=()
    for helper in detach herdr-worktree-watch; do
        [ -x "$bin_dir/$helper" ] || missing_helpers+=("$bin_dir/$helper")
    done
    if [ "${#missing_helpers[@]}" -gt 0 ]; then
        # The checkout is three folders above scripts/.local/bin/herdr-worktree, after following links.
        dotfiles_dir="$(cd -P "$script_dir/../../.." && pwd)"
        quoted_helpers="$(printf ' %q' "${missing_helpers[@]}")"
        echo "herdr-worktree: missing helpers:$quoted_helpers; link them with: stow -d $(printf '%q' "$dotfiles_dir") -t \"\$HOME\" -R scripts" >&2
        exit 1
    fi
    if [[ ! "$watch_seconds" =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "HERDR_WORKTREE_WATCH_SECONDS must be a whole number of seconds, got: $watch_seconds" >&2
        exit 1
    fi
    if [[ ! "$fork_timeout" =~ ^[1-9][0-9]*$ ]]; then
        echo "HERDR_WORKTREE_FORK_TIMEOUT must be a whole number of seconds, at least 1, got: $fork_timeout" >&2
        exit 1
    fi
fi

if [ -z "$branch" ]; then
    # fzf as a one-line prompt: Enter returns the typed text (exit 1, since
    # there is no list to match), Esc cancels (exit 130).
    fzf_status=0
    branch=$(fzf --reverse --print-query --info=hidden --prompt="branch> " </dev/null) \
        || fzf_status=$?
    [ "$fzf_status" -le 1 ] || exit 0
fi
[ -n "$branch" ] || { echo "herdr-worktree: no branch given" >&2; exit 1; }

checkout=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "herdr-worktree: not inside a git repo" >&2; exit 1; }
main_checkout=$(main_checkout_of "$checkout")

if [ -z "$base" ]; then
    base=HEAD
    # A fork carries this conversation's work on, so its lane starts from the
    # branch checked out here, unpushed commits included.
    if [ -z "$fork" ] && git remote get-url origin &>/dev/null; then
        default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) \
            || default_branch=""
        if [ -n "$default_branch" ]; then
            base="$default_branch"
            git fetch --quiet origin "${default_branch#origin/}" \
                || echo "herdr-worktree: fetch failed; branching off the local $base" >&2
        else
            echo "herdr-worktree: origin/HEAD unset; branching off HEAD (git remote set-head origin --auto fixes it)" >&2
        fi
    fi
fi

if [[ "$branch" =~ ^([A-Z]+-[0-9]+) ]]; then
    suffix="${BASH_REMATCH[1]}"
else
    suffix="${branch#feature/}"
    suffix="${suffix#fix/}"
    suffix="${suffix//\//-}"
fi
worktree_parent=$(dirname "$main_checkout")
repo=$(basename "$main_checkout")
worktree="$worktree_parent/$repo-$suffix"
[ ! -e "$worktree" ] || worktree="$worktree_parent/$repo-${branch//\//-}"
[ ! -e "$worktree" ] || { echo "herdr-worktree: $worktree already exists" >&2; exit 1; }

claude_session=""
if [ -n "$fork" ]; then
    claude_session=$(herdr-api pane current \
        | jq -r 'select(.result.pane.agent == "claude") | .result.pane.agent_session.value // empty')
    [ -n "$claude_session" ] || { echo "herdr-worktree: --fork needs a claude pane" >&2; exit 1; }
fi

# An entry left by an earlier lane of this name would keep its brief and report-to, because
# `lanes.py add` replaces an entry only when its worktree folder is gone and the folder is made next.
# No entry (exit 1) is the usual case; any other failure is reported by the add below.
label="$(basename "$worktree")"
if [ -n "$fork" ]; then
    python3 "$lanes_cli" remove "$label" >/dev/null 2>&1 || true
fi

# herdr prints its own error to stderr, so only name the step that failed.
# tuios answers no worktree.create, so under tuios git makes the worktree and
# the workspace opens on it.
if [ -n "${TUIOS_SOCKET:-}" ]; then
    git -C "$checkout" worktree add -b "$branch" "$worktree" "$base" \
        || { echo "herdr-worktree: git worktree add failed" >&2; exit 1; }
    created=$(herdr-api workspace create --cwd "$worktree" --label "$label" --focus) \
        || { echo "herdr-worktree: workspace create failed" >&2; exit 1; }
else
    # herdr makes worktrees only from the repo's main checkout, so a run from a
    # linked worktree hands it the main checkout. Resolve the base here first:
    # HEAD and relative refs mean something else in the main checkout.
    if [ "$checkout" != "$main_checkout" ]; then
        base=$(git rev-parse --verify "$base^{commit}") \
            || { echo "herdr-worktree: cannot resolve base $base" >&2; exit 1; }
    fi
    created=$(herdr worktree create --cwd "$main_checkout" --branch "$branch" --base "$base" \
        --path "$worktree" --label "$label" --focus) \
        || { echo "herdr-worktree: herdr worktree create failed" >&2; exit 1; }
fi
ws=$(jq -r '.result.workspace.workspace_id // empty' <<<"$created")
if [ -z "$ws" ]; then
    echo "herdr-worktree: create reply has no workspace id: $created" >&2
    exit 1
fi

# A gitignored .python-version is missing from a new worktree, and the gates need
# the main checkout's pin there. A tracked file is checked out already and git
# does not call it ignored, so only an untracked ignored pin gets the link.
if [ ! -e "$worktree/.python-version" ] && [ ! -L "$worktree/.python-version" ] \
    && [ -f "$main_checkout/.python-version" ] && git -C "$worktree" check-ignore -q .python-version; then
    ln -s "$main_checkout/.python-version" "$worktree/.python-version"
    echo "herdr-worktree: linked .python-version from $main_checkout" >&2
fi

# A new worktree has no node_modules, so install node dependencies for each
# lockfile at the root or one folder down before any pane runs repo tooling.
# A failed install warns with the command to run and does not stop the run.
lockfiles=$(git -C "$worktree" ls-files -- ':(glob)package-lock.json' ':(glob)pnpm-lock.yaml' \
    ':(glob)*/package-lock.json' ':(glob)*/pnpm-lock.yaml')
install_log=$(git -C "$worktree" rev-parse --path-format=absolute --git-path herdr-worktree-install.log)
while IFS= read -r lockfile; do
    [ -n "$lockfile" ] || continue
    package_dir="$worktree"
    [[ "$lockfile" != */* ]] || package_dir="$worktree/${lockfile%/*}"
    case "${lockfile##*/}" in
        package-lock.json) install_cmd=(npm ci --no-audit --no-fund) ;;
        pnpm-lock.yaml) install_cmd=(pnpm install --frozen-lockfile) ;;
    esac
    if ! command -v "${install_cmd[0]}" >/dev/null; then
        echo "herdr-worktree: ${install_cmd[0]} is not on PATH; install dependencies in $package_dir by hand" >&2
        continue
    fi
    echo "herdr-worktree: installing dependencies in $package_dir" >&2
    (cd "$package_dir" && "${install_cmd[@]}") </dev/null >>"$install_log" 2>&1 \
        || echo "herdr-worktree: dependency install failed (output in $install_log); run: cd $(printf '%q' "$package_dir") && $(printf '%q ' "${install_cmd[@]}")" >&2
done <<<"$lockfiles"

# tuios ignores create's --focus, and herdr-dev's layout calls need the client
# on this workspace.
herdr-api workspace focus "$ws" >/dev/null

# The lane entry lets herdr-lane-resume reopen the lane. A failed write must not stop
# the run: the workspace is already open, so it warns and the fork still starts.
if [ -n "$fork" ]; then
    reports_to=$(python3 "$session_pane" sender 2>/dev/null | jq -r '.name // empty' 2>/dev/null) || reports_to=""
    if ! add_error=$(printf '%s' "$prompt" | python3 "$lanes_cli" add --name "$label" --worktree "$worktree" \
        --main-checkout "$main_checkout" --branch "$branch" --reports-to "$reports_to" 2>&1 >/dev/null); then
        lane_file=$(python3 "$lanes_cli" path "$label" 2>/dev/null | jq -r '.file // empty' 2>/dev/null) || lane_file=""
        lane_file_note=""
        [ -z "$lane_file" ] || lane_file_note="; the lane file is $lane_file"
        echo "herdr-worktree: lane entry not written: $add_error$lane_file_note; herdr-lane-resume will not know this lane" >&2
    fi
fi

# herdr-dev prints the claude pane's id, then the command it typed there. A
# forked lane opens with the claude pane alone; a plain worktree keeps hunk.
dev_flags=()
[ -z "$fork" ] || dev_flags=(--headless)
layout=$("$bin_dir/herdr-dev" ${dev_flags[@]+"${dev_flags[@]}"} "$worktree" "$ws" "$claude_session" "$prompt")
claude_pane=$(sed -n 1p <<<"$layout")
claude_cmd=$(sed -n 2p <<<"$layout")

if git -C "$worktree" remote get-url origin &>/dev/null; then
    git -C "$worktree" push -u origin "$branch" \
        || echo "herdr-worktree: push failed; run git push -u origin $(printf '%q' "$branch")" >&2
fi

[ -n "$fork" ] || exit 0

# herdr adopts a pane as a claude agent once it detects the process.
for _ in $(seq "$fork_timeout"); do
    pane_agent=$(herdr-api pane get "$claude_pane" 2>/dev/null | jq -r '.result.pane.agent // empty') || pane_agent=""
    if [ "$pane_agent" = "claude" ]; then
        watch_log=$(git -C "$worktree" rev-parse --path-format=absolute --git-path herdr-worktree-watch.log)
        # The caller's process group can be torn down, so the watcher runs in its own session.
        # Its output goes to the watch log, so a failure of the launch or of the watcher stays readable.
        "$bin_dir/detach" "$bin_dir/herdr-worktree-watch" "$ws" "$worktree" "$main_checkout" "$claude_pane" "$claude_session" \
            </dev/null >>"$watch_log" 2>&1 &
        disown
        echo "herdr-worktree: watching workspace $ws for ${watch_seconds}s; recovery steps go to $watch_log if it closes" >&2
        exit 0
    fi
    sleep 1
done
echo "herdr-worktree: the fork did not start: pane $claude_pane shows no claude agent after ${fork_timeout}s. Run this in that pane: $claude_cmd" >&2
exit 1
