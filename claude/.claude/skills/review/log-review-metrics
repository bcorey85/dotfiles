#!/usr/bin/env bash
# log-review-metrics — one metrics row per /review run, written through `ledger write`
#
# usage: log-review-metrics key=value [key=value ...]
#   e.g. log-review-metrics iter=2 fix=1 fixed=2 skipped_fp=1 ask=0 result=PASS
#
# Every value is sent as a JSON string; `ledger write review_metrics` types it.
# `specialists=` and `fixed_classes=` are counts by name, as a JSON object
# (`{"code-reviewer":2}`) or as `name:count,name:count`; names are stored lowercase
# with underscores for hyphens (`code_reviewer`). `result=` takes the spaced
# words (PASS WITH WARNINGS, NEEDS CHANGES, NOT DISPATCHED); they are stored with
# underscores, and `PASS (NITS ONLY)` is stored as PASS_WITH_WARNINGS, as
# log-review-finding folds it. clean, residue and findings are stored as sent.
# date, schema_version, repo, session and desc are accepted and never stored; the
# writer adds the date, repo and session, and keys `branch=` into branch_key.
# With no `ledger` on PATH the write is skipped silently. A row `ledger write`
# refuses exits 2.
#
# An explicit out=<path> writes the row there as one JSONL line instead of to the
# ledger. The redirect writes only while the metrics switch is on.
set -euo pipefail

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
script_dir=$(dirname -- "${BASH_SOURCE[0]}")
# shellcheck source=../../scripts/_kv.sh
source "$script_dir/../../scripts/_kv.sh"
out=""

# The branch is read here, never trusted to the caller; a caller's own branch= still wins.
json=$(jq -cn --arg b "$(git branch --show-current 2>/dev/null || true)" \
  '{} + (if $b != "" then {branch: $b} else {} end)')

# specialists= and fixed_classes= are counts by name, not strings.
fold_counts_by_name() {
  case "$1" in
    specialists|fixed_classes) ;;
    *) return 1 ;;
  esac

  json=$(jq -c --arg k "$1" --arg v "$2" '
    .[$k] = (try ($v | fromjson | select(type == "object"))
             catch ($v | split(",") | map(select(. != "") | split(":") | {key: .[0], value: (.[1] // "0")}) | from_entries)
             // {})
    | .[$k] |= with_entries(.key |= (ascii_downcase | gsub("-"; "_")))' <<< "$json") || exit $?
}

# Every value may hold spaces here (result=PASS WITH WARNINGS).
kv_fold "*" fold_counts_by_name "$@"
[ -z "$kv_out_seen" ] || out="$kv_out"

# The caller's shell may leave ~ after = unexpanded (zsh does), so expand a
# bare ~ or a leading ~/ here (~user is left alone).
case "$out" in
  "~") out="$HOME" ;;
  "~/"*) out="$HOME/${out#"~/"}" ;;
esac

"$script_dir/../../scripts/telemetry_enabled.sh" 2>/dev/null || exit 0

if [ -n "$out" ]; then
  printf '%s\n' "$(jq -c '. + {date: (now | todate)}' <<< "$json")" >> "$out"
  echo "logged → $out"
  exit 0
fi

payload=$(jq -c '
  def result_verdict:
    (ascii_upcase | gsub("[_-]"; " ")) as $norm
    | if ($norm | test("^PASS WITH WARNINGS")) or $norm == "PASS (NITS ONLY)" then "PASS_WITH_WARNINGS"
    elif $norm == "PASS" then "PASS"
    elif $norm | test("^NEEDS CHANGES") then "NEEDS_CHANGES"
    elif $norm | test("^NOT DISPATCHED") then "NOT_DISPATCHED"
    else gsub(" "; "_") end;
  del(.desc)
  | (if .result then .result |= result_verdict else . end)
  | with_entries(.key |= (if . == "branch" then "branch_key" else . end))' <<< "$json")
printf '%s\n' "$payload" | bash "$script_dir/../../scripts/ledger-write" review_metrics
