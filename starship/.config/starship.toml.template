# Theme — owned by the `theme-mode` switcher. Starship has no include mechanism,
# but it re-reads its whole config every prompt, so theme-mode regenerates the
# REAL ~/.config/starship.toml (starship's default read path) from THIS template
# with the `palette =` line below swapped to `<family>-<mode>`. Because it writes
# starship's default path, EVERY running shell flips on its next prompt with no
# reload and no STARSHIP_CONFIG — the generated file is machine-local, so this
# tracked template never gets dirtied. Same source-of-truth model as ghostty/herdr.
#
# THIS is the template (stowed to ~/.config/starship.toml.template): if you edit
# it, re-run `theme-mode` (any invocation) to regenerate the live config, or the
# change won't show until the next theme switch.
#
# Palette names are `<family>-<mode>` (not bare `dark`/`light`) because the
# active palette now has two axes, family x mode — theme-mode's sed swaps the
# whole `<family>-<mode>` token, never just the mode half.
#
# NOTE: the root `palette`/`format` keys MUST come before any [palettes.*] table
# header — any key after a table header belongs to that table. Placed below a
# palette, `format` silently became palettes.<name>.format and starship fell
# back to the default `$all` format (which pulls in $aws et al.).
palette = "vitesse-dark"

format = """
$directory\
$git_branch\
$git_status\
$python\
$nodejs\
$cmd_duration\
$line_break\
$character"""

# vitesse dark (antfu's Vitesse, off-black #121212). `orange`/`peach` is
# vitesse orange #d4976c; `purple` is magenta #d9739f. `grey` is comment #5c6b5e.
[palettes.vitesse-dark]
red = "#cb7676"
orange = "#d4976c"
yellow = "#e6cc77"
green = "#4d9375"
blue = "#6394bf"
teal = "#5eaab5"
purple = "#d9739f"
fg = "#c8c5b8"
bg = "#121212"
grey = "#5c6b5e"

# vitesse light (antfu's Vitesse light, white #ffffff). Prompt colors are
# foreground-on-white, so the theme's own ANSI is the starting point but not the
# whole answer: green/blue/purple clear 4.5:1 as authored and are verbatim,
# while yellow #bda437 (~2.6:1), teal #2993a3 (~3.2:1) and red #ab5959 (~4.3:1)
# do not and are darkened. `grey` is the comment, lifted to #626e62 (nvim's
# light fixup #6b7a6b lands ~4.1:1 here, just under the floor).
[palettes.vitesse-light]
red = "#9e4d4d"
orange = "#a15d28"
yellow = "#7d6a1e"
green = "#1e754f"
blue = "#296aa3"
teal = "#1f7080"
purple = "#a13865"
fg = "#393a34"
bg = "#ffffff"
grey = "#626e62"

[directory]
style = "bold teal"
truncation_length = 3
truncate_to_repo = true

[git_branch]
format = " [$branch]($style)"
style = "blue"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "red"
ahead = " ↑${count}"
behind = " ↓${count}"
diverged = " ↑${ahead_count}↓${behind_count}"
modified = " ✗"
staged = " +"
untracked = " ?"
stashed = " ≡"

[python]
format = " [${virtualenv}]($style)"
style = "green"
detect_extensions = []

[nodejs]
format = " [ $version]($style)"
style = "green"

[cmd_duration]
min_time = 2_000
format = " [$duration]($style)"
style = "grey"

[character]
success_symbol = "[❯](bold teal)"
error_symbol = "[❯](bold red)"
