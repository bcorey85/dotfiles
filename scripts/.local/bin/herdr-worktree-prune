#!/usr/bin/env python3
"""Remove finished linked git worktrees, and optionally merged local branches.

Usage: herdr-worktree-prune [--apply] [--branches] [-h|--help]
       herdr-worktree-prune --check <path>

  (no option)  list only: one line per worktree it would remove (path, branch,
               size), one line per kept worktree with the reason, then totals.
               Removes nothing.
  --apply      remove exactly the listed worktrees: `git worktree remove` (never
               --force), then delete its branch. Right before each removal every
               condition is checked again; a tree that no longer passes is kept
               and reported. The end line is: removed N, freed bytes, kept N,
               failed N. A tree whose worktree went but whose branch could not
               be deleted counts as removed and as failed, with the reason.
               Exit 1 when any step failed.
  --branches   list merged local branches that have no worktree entry (a
               prunable entry counts as one). With --apply, delete each. Never
               the default branch, never a branch that a worktree entry has
               checked out, never the branch of a rebase or bisect in progress
               in a worktree whose folder exists (such a worktree shows as
               detached).

  --check <path>
               judge the one worktree at <path> by the conditions of its own
               state (everything below except the current worktree, open lane,
               process and herdr conditions, which a lane close clears itself).
               Prints one JSON object on stdout and exits 0:
               {"path", "branch", "verdict": "remove"|"keep", "code", "reason"}
               (code and reason are null on remove). It runs the same start-up
               fetch, and reads only the worktree list and the stashes. A path
               that is not a worktree entry of the repo, and any start-up
               failure, exit 1 with the message on stderr; a check that cannot
               run is a keep with code `cannot check`. A call with no path or
               extra arguments exits 2 with the usage.

A branch is deleted with `git update-ref -d refs/heads/<name> <tip>` on the tip
just checked as an ancestor of the compare ref, never forced: git refuses when
the tip moved in between. Then its `branch.<name>` config section is removed.
A branch whose tip is ahead of its own upstream is still deleted when the
compare ref holds it; its list line says so.

Run it from the main checkout or any linked worktree of a repo. Every mode
first runs `git fetch --quiet origin <default branch>` (list mode too: it
updates only the remote-tracking ref origin/<default branch>) and compares with
that ref. They stop, remove nothing and exit 1 when there is no git repo, no
origin remote, no refs/remotes/origin/HEAD (`git remote set-head origin
--auto`) or origin cannot be fetched.

A worktree is removed only when all of these hold; otherwise it is kept and one
reason is printed:
  - it is a linked worktree: not the main checkout, not the one the command
    runs from, not one that holds the working directory;
  - its folder exists, it is not locked, not detached, not bare;
  - its branch is not the default branch and its tip is an ancestor of the
    compare ref (a squash or rebase merge looks unmerged: check by hand);
  - git status is clean (ignored files do not count), no submodule, no nested
    repository at any depth inside an ignored folder;
  - no stash entry was made on its branch (an entry that names no branch counts
    when its first parent is the branch tip);
  - no live process has its working directory inside it;
  - no herdr workspace or agent is on it (`herdr-api workspace list` and
    `herdr-api agent list`; when one list does not answer, a note names it and
    the other checks still run; a list that failed is not asked again in the
    run, a list that answered is asked again before each removal);
  - it is not, and is not inside, an open lane's worktree (`lanes.py list`;
    when the list cannot be read every tree is kept as `cannot check`).
Never touched: refs/review-snapshots, refs/pull-keep-index, git gc, git
worktree prune (a worktree whose folder is gone is kept, and `git worktree
prune` clears its entry), git stash drop, git branch -D, any remote branch.
"""
from __future__ import annotations

import dataclasses
import json
import os
import pathlib
import sys

# The shared modules sit in scripts/.local/lib; resolve() follows a stow symlink back to the repo.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

from worktree_branches import (
    ahead_text, delete_branch, prune_branches,
)
from worktree_git import (
    PruneError, Repo, Tally, Worktree, git, inside, list_worktrees, real, run, show,
)

PROC_ROOT = "/proc"
FETCH_TIMEOUT_SECONDS = 120
HERDR_TIMEOUT_SECONDS = 20
LSOF_TIMEOUT_SECONDS = 60
USAGE_LINE = "usage: herdr-worktree-prune [--apply] [--branches] [-h|--help] | --check <path>"
SUBMODULE_MODE = "160000"
REMOTE_HEAD_PREFIX = "refs/remotes/origin/"

# Reason codes: the totals line counts kept trees by these.
MAIN_CHECKOUT = "main checkout"
CURRENT_TREE = "current worktree"
BARE = "bare"
FOLDER_GONE = "folder gone"
LOCKED = "locked"
DETACHED = "detached"
DEFAULT_BRANCH = "default branch"
NOT_MERGED = "not merged"
DIRTY = "uncommitted changes"
SUBMODULE = "submodule"
NESTED_REPO = "nested repo"
STASH = "stash entry"
PROCESS = "process running"
HERDR = "herdr workspace"
CANNOT_CHECK = "cannot check"
VANISHED = "no longer a worktree"
LANE_OPEN = "open lane"


@dataclasses.dataclass
class Keep:
    code: str
    text: str


@dataclasses.dataclass
class Stash:
    branch: str | None
    parent: str


@dataclasses.dataclass
class Process:
    pid: int
    name: str
    cwd: str


@dataclasses.dataclass
class Workspace:
    label: str
    checkout_path: str | None


@dataclasses.dataclass
class Herdr:
    workspaces: list[Workspace] | None
    agent_cwds: list[str] | None
    note: str | None = None


@dataclasses.dataclass
class World:
    """Everything the checks read, taken fresh before each tree is judged. A herdr list that failed earlier in the
    run is the exception: it stays unasked and its part of `herdr` is None."""
    worktrees: list[Worktree]
    stashes: list[Stash] | None
    processes: list[Process] | None
    herdr: Herdr
    notes: list[str]
    lanes: LaneRead


@dataclasses.dataclass
class RunState:
    """What one run remembers from one world to the next."""
    herdr_failures: dict[str, str] = dataclasses.field(default_factory=dict)  # failed list name -> why
    printed_notes: set[str] = dataclasses.field(default_factory=set)

    def print_new_notes(self, notes):
        for note in notes:
            if note in self.printed_notes:
                continue
            self.printed_notes.add(note)
            print(note, flush=True)


class HerdrUnavailableError(Exception):
    pass


def human_size(size):
    if size is None:
        return "size unknown"
    if size < 1024:
        return f"{size} B"
    value = float(size)
    for unit in ("KiB", "MiB", "GiB"):
        value /= 1024
        if value < 1024:
            return f"{value:.1f} {unit}"
    value /= 1024
    return f"{value:.1f} TiB"


def tree_size(path):
    """Bytes under `path` from `du -sk`, or None when du fails."""
    measured = run(["du", "-sk", path])
    if measured.returncode != 0:
        return None
    fields = measured.stdout.split()
    if not fields or not fields[0].isdigit():
        return None
    return int(fields[0]) * 1024


# ---- stash ----

def parse_stash_subject(subject):
    """The branch a stash subject names, or None.

    `WIP on <branch>: <hash> <subject>` and `On <branch>: <message>` name one; `(no branch)`, `autostash` and any
    other subject name none. Git forbids `:` in ref names, so the first `: ` ends the branch."""
    for prefix in ("WIP on ", "On "):
        if subject.startswith(prefix):
            name, separator, _ = subject[len(prefix):].partition(": ")
            if not separator or name == "(no branch)":
                return None
            return name
    return None


def read_stashes(main_dir):
    listed = git(main_dir, "stash", "list", "--format=%P%x09%gs")
    if listed.returncode != 0:
        return None
    stashes = []
    for line in listed.stdout.splitlines():
        parents, _, subject = line.partition("\t")
        first_parent = parents.split(" ")[0]
        branch = parse_stash_subject(subject)
        stashes.append(Stash(branch=branch, parent=first_parent))
    return stashes


# ---- processes ----

def proc_is_usable():
    try:
        os.readlink(f"{PROC_ROOT}/{os.getpid()}/cwd")
    except OSError:
        return False
    return True


def process_name(pid):
    try:
        return pathlib.Path(f"{PROC_ROOT}/{pid}/comm").read_text().strip() or "?"
    except OSError:
        return "?"


def processes_from_proc():
    processes = []
    for entry in os.listdir(PROC_ROOT):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            target = os.readlink(f"{PROC_ROOT}/{entry}/cwd")
        except OSError:
            continue  # another user's process, or one that just ended
        name = process_name(entry)
        cwd = real(target)
        processes.append(Process(int(entry), name, cwd))
    return processes


def processes_from_lsof():
    """Process working directories from `lsof -a -d cwd -F pcn`, or None when lsof does not answer."""
    asked = run(["lsof", "-a", "-d", "cwd", "-F", "pcn"], timeout=LSOF_TIMEOUT_SECONDS)
    if asked.returncode != 0 and not asked.stdout:
        return None
    processes = []
    pid = 0
    name = "?"
    for line in asked.stdout.splitlines():
        field, value = line[:1], line[1:]
        if field == "p" and value.isdigit():
            pid, name = int(value), "?"
        elif field == "c":
            name = value
        elif field == "n" and pid != os.getpid():
            cwd = real(value)
            processes.append(Process(pid, name, cwd))
    return processes


def read_processes():
    """Every live process's real working directory, or None when neither /proc nor lsof can say."""
    if proc_is_usable():
        return processes_from_proc()
    return processes_from_lsof()


# ---- herdr ----

def herdr_json(kind):
    env = dict(os.environ)
    env["PATH"] = f"{pathlib.Path.home() / '.local' / 'bin'}:{env.get('PATH', '')}"
    asked = run(["herdr-api", kind, "list"], env=env, timeout=HERDR_TIMEOUT_SECONDS)
    if asked.returncode != 0:
        raise HerdrUnavailableError(f"herdr-api {kind} list failed: {asked.stderr.strip() or asked.returncode}")
    try:
        return json.loads(asked.stdout)
    except ValueError as error:
        raise HerdrUnavailableError(f"herdr-api {kind} list printed no JSON: {error}") from error


def workspaces_from_json(parsed):
    try:
        found = []
        for entry in parsed["result"]["workspaces"]:
            tree = entry.get("worktree") or {}
            label = entry.get("label") or ""
            checkout_path = tree.get("checkout_path") or None
            found.append(Workspace(label=label, checkout_path=checkout_path))
        return found
    except (KeyError, TypeError, AttributeError) as error:
        raise HerdrUnavailableError(f"herdr-api workspace list has an unexpected shape: {error!r}") from error


def agent_cwds_from_json(parsed):
    try:
        return [entry["cwd"] for entry in parsed["result"]["agents"] if entry.get("cwd")]
    except (KeyError, TypeError, AttributeError) as error:
        raise HerdrUnavailableError(f"herdr-api agent list has an unexpected shape: {error!r}") from error


def ask_herdr_list(state, name, kind, read_answer):
    """One herdr list read by `read_answer`, or None when it failed now or earlier in the run.

    A failure is remembered in `state` and the list is never asked again, so a dead herdr costs one timeout."""
    if name in state.herdr_failures:
        return None
    try:
        parsed = herdr_json(kind)
        return read_answer(parsed)
    except HerdrUnavailableError as error:
        state.herdr_failures[name] = str(error)
        return None


def read_herdr(state):
    """Both herdr lists, each None when it failed; `note` names the failed lists and why.

    A list that answered is asked again on every call, so a workspace opened mid-run is seen."""
    workspaces = ask_herdr_list(state, "workspaces", "workspace", workspaces_from_json)
    agent_cwds = ask_herdr_list(state, "agents", "agent", agent_cwds_from_json)
    if not state.herdr_failures:
        return Herdr(workspaces, agent_cwds)
    names = " and ".join(state.herdr_failures)
    problems = "; ".join(state.herdr_failures.values())
    note = f"note: herdr {names} were not checked ({problems})"
    return Herdr(workspaces, agent_cwds, note)


# ---- lanes ----

def lanes_cli_path():
    return os.environ.get("HERDR_LANES_CLI") or os.path.expanduser("~/.claude/scripts/tools/lanes.py")


@dataclasses.dataclass
class LaneRead:
    worktrees: list[tuple[str, str]] | None
    problem: str = ""


def read_lanes():
    """The open lanes as (name, worktree) pairs from `lanes.py list`, or None with the reason."""
    asked = run([sys.executable, lanes_cli_path(), "list"], timeout=HERDR_TIMEOUT_SECONDS)
    if asked.returncode != 0:
        return LaneRead(None, f"lanes list failed: {asked.stderr.strip() or asked.returncode}")
    try:
        entries = json.loads(asked.stdout)["lanes"]
        return LaneRead([(entry["name"], entry["worktree"]) for entry in entries])
    except (ValueError, KeyError, TypeError) as error:
        return LaneRead(None, f"lanes list has an unexpected answer: {error!r}")


# ---- the world and the checks ----

def take_world(repo, state):
    notes = []
    worktrees = list_worktrees(repo.main_path)
    stashes = read_stashes(repo.main_path)
    if stashes:
        unnamed = sum(1 for stash in stashes if stash.branch is None)
        if unnamed:
            notes.append(f"note: {unnamed} stash entries name no branch; each keeps only the tree whose "
                         "branch tip is its first parent")
    processes = read_processes()
    herdr = read_herdr(state)
    if herdr.note is not None:
        notes.append(herdr.note)
    lanes = read_lanes()
    if lanes.worktrees is None:
        notes.append(f"note: open lanes were not checked ({lanes.problem})")
    return World(worktrees, stashes, processes, herdr, notes, lanes)


def check_main(repo, world, tree):
    if real(tree.path) == real(world.worktrees[0].path):
        return Keep(MAIN_CHECKOUT, "the main checkout")
    return None


def check_current(repo, world, tree):
    tree_real = real(tree.path)
    if inside(repo.cwd_real, tree_real):
        return Keep(CURRENT_TREE, "the command runs from this worktree")
    return None


def check_bare(repo, world, tree):
    if tree.bare:
        return Keep(BARE, "a bare repository entry")
    return None


def check_folder(repo, world, tree):
    if tree.prunable:
        return Keep(FOLDER_GONE, "the folder is gone; `git worktree prune` clears the entry")
    return None


def check_locked(repo, world, tree):
    if not tree.locked:
        return None
    detail = f": {tree.lock_reason}" if tree.lock_reason else ""
    return Keep(LOCKED, f"locked{detail}")


def check_detached(repo, world, tree):
    if tree.detached or tree.branch is None:
        return Keep(DETACHED, "detached HEAD (also a rebase or bisect in progress)")
    return None


def check_default(repo, world, tree):
    if tree.branch == repo.default_branch:
        return Keep(DEFAULT_BRANCH, f"checked out on the default branch {repo.default_branch}")
    return None


def check_lane_open(repo, world, tree):
    # Fail closed: with the lane list unread, an open lane's tree cannot be told from a finished one.
    if world.lanes.worktrees is None:
        return Keep(CANNOT_CHECK, f"the lane list could not be read: {world.lanes.problem}")
    tree_real = real(tree.path)
    for name, worktree in world.lanes.worktrees:
        if inside(tree_real, real(worktree)):
            return Keep(LANE_OPEN, f"lane {name} is open; herdr-lane-resume --close {name} closes it")
    return None


def check_merged(repo, world, tree):
    asked = git(repo.main_path, "merge-base", "--is-ancestor", tree.head, repo.compare_hash)
    if asked.returncode == 0:
        return None
    if asked.returncode != 1:
        return Keep(CANNOT_CHECK, f"git merge-base failed: {asked.stderr.strip()}")
    counted = git(repo.main_path, "rev-list", "--count", f"{repo.compare_hash}..{tree.head}")
    count = counted.stdout.strip() if counted.returncode == 0 else "an unknown number of"
    return Keep(NOT_MERGED, f"{count} commits not on {repo.compare_name}; a squash or rebase merge looks "
                            "the same, check by hand")


def check_tree_state(repo, world, tree):
    """Dirty, submodule and ignored nested repo, from one git status and one ls-files."""
    status = git(tree.path, "status", "--porcelain=v1", "-z", "--untracked-files=normal",
                 "--ignore-submodules=none", "--ignored")
    if status.returncode != 0:
        return Keep(CANNOT_CHECK, f"git status failed: {status.stderr.strip()}")
    entries = [entry for entry in status.stdout.split("\0") if entry]
    changes = [entry for entry in entries if not entry.startswith("!! ")]
    if changes:
        return Keep(DIRTY, f"uncommitted changes: {len(changes)} staged, modified or untracked entries")
    staged = git(tree.path, "ls-files", "-s", "-z")
    if staged.returncode != 0:
        return Keep(CANNOT_CHECK, f"git ls-files failed: {staged.stderr.strip()}")
    for entry in staged.stdout.split("\0"):
        if entry.startswith(SUBMODULE_MODE + " "):
            return Keep(SUBMODULE, f"holds a submodule: {entry.partition(chr(9))[2]}")
    for entry in entries:
        nested = find_nested_repo(tree.path, entry[3:])
        if nested is not None:
            return Keep(NESTED_REPO, f"holds an ignored nested repository: {nested}")
    return None


def find_nested_repo(tree_path, ignored):
    """The folder (relative to the tree, ending in `/`) of the first `.git` entry under the ignored folder, or None.

    `git status --ignored` prints an ignored folder with a trailing `/` and an ignored file without one; a file
    is skipped. Symlinks are not followed. A `.git` file or folder both count: git worktree remove would delete
    the repository with the folder."""
    if not ignored.endswith("/"):
        return None
    top = os.path.join(tree_path, ignored)
    for folder, subfolders, files in os.walk(top, followlinks=False):
        subfolders.sort()
        if ".git" in subfolders or ".git" in files:
            relative = os.path.relpath(folder, tree_path)
            return relative + "/"
    return None


def check_stash(repo, world, tree):
    if world.stashes is None:
        return Keep(CANNOT_CHECK, "cannot read the stash list")
    for stash in world.stashes:
        if stash.branch == tree.branch:
            return Keep(STASH, f"a stash entry was made on branch {tree.branch}")
        if stash.branch is None and stash.parent == tree.head:
            return Keep(STASH, "a stash entry sits on this branch's tip")
    return None


def check_process(repo, world, tree):
    if world.processes is None:
        return Keep(CANNOT_CHECK, "cannot check running processes")
    tree_real = real(tree.path)
    holders = sorted((proc for proc in world.processes if inside(proc.cwd, tree_real)), key=lambda proc: proc.pid)
    if holders:
        return Keep(PROCESS, f"process {holders[0].pid} ({holders[0].name}) has its working directory inside")
    return None


def check_herdr(repo, world, tree):
    tree_real = real(tree.path)
    folder = os.path.basename(tree.path.rstrip(os.sep))
    for workspace in world.herdr.workspaces or []:
        if workspace.checkout_path:
            checkout_real = real(workspace.checkout_path)
            if inside(checkout_real, tree_real):
                return Keep(HERDR, f"herdr workspace {workspace.label!r} is on this tree")
        if not workspace.checkout_path and workspace.label == folder:
            return Keep(HERDR, f"herdr workspace {workspace.label!r} carries this folder's name")
    for cwd in world.herdr.agent_cwds or []:
        cwd_real = real(cwd)
        if inside(cwd_real, tree_real):
            return Keep(HERDR, f"a herdr agent works inside it ({cwd})")
    return None


CHECKS = (check_main, check_current, check_bare, check_folder, check_locked, check_detached, check_default,
          check_lane_open, check_merged, check_tree_state, check_stash, check_process, check_herdr)


# Who or what is on a tree right now. A lane close clears these itself by closing the workspace.
OCCUPANCY_CHECKS = (check_current, check_lane_open, check_process, check_herdr)
TREE_STATE_CHECKS = tuple(check for check in CHECKS if check not in OCCUPANCY_CHECKS)


def evaluate(repo, world, tree, checks=CHECKS):
    """The one place that decides: the Keep for the first failing condition, or None when the tree may go."""
    for check in checks:
        keep = check(repo, world, tree)
        if keep is not None:
            return keep
    return None


# ---- start-up ----

def start_up():
    if git(None, "rev-parse", "--git-dir").returncode != 0:
        raise PruneError("not in a git repository")
    if git(None, "remote", "get-url", "origin").returncode != 0:
        raise PruneError("no origin: nothing to compare against")
    head = git(None, "symbolic-ref", "--quiet", REMOTE_HEAD_PREFIX + "HEAD")
    target = head.stdout.strip()
    if head.returncode != 0 or not target.startswith(REMOTE_HEAD_PREFIX):
        raise PruneError("origin/HEAD is not set: run `git remote set-head origin --auto`")
    default_branch = target[len(REMOTE_HEAD_PREFIX):]
    fetched = git(None, "fetch", "--quiet", "origin", default_branch, timeout=FETCH_TIMEOUT_SECONDS)
    if fetched.returncode != 0:
        raise PruneError(f"git fetch origin {default_branch} failed: {fetched.stderr.strip()}")
    resolved = git(None, "rev-parse", "--verify", "--quiet", f"{REMOTE_HEAD_PREFIX}{default_branch}^{{commit}}")
    if resolved.returncode != 0:
        raise PruneError(f"origin/{default_branch} does not resolve to a commit after the fetch")
    try:
        cwd = os.getcwd()
    except OSError as error:
        raise PruneError(f"cannot read the working directory: {error}") from error
    cwd_real = real(cwd)
    main_path = list_worktrees(None)[0].path
    return Repo(main_path, default_branch, f"origin/{default_branch}", resolved.stdout.strip(), cwd_real)


# ---- worktree mode ----

def describe(tree):
    if tree.bare:
        return "(bare)"
    return tree.branch if tree.branch else "(detached)"


def plan_trees(repo, world):
    """(tree, Keep or None) for every worktree, ordered by path."""
    return [(tree, evaluate(repo, world, tree)) for tree in sorted(world.worktrees, key=lambda tree: tree.path)]


def kept_breakdown(keeps):
    counts = {}
    for keep in keeps:
        counts[keep.code] = counts.get(keep.code, 0) + 1
    return ", ".join(f"{count} {code}" for code, count in counts.items())


def print_plan(repo, world, plan, state):
    print(f"compare ref: {repo.compare_name} ({repo.compare_hash[:8]})")
    state.print_new_notes(world.notes)
    removable = [(tree, tree_size(tree.path)) for tree, keep in plan if keep is None]
    for tree, size in removable:
        ahead = ahead_text(repo, tree.branch)
        print(f"remove  {show(tree.path)}  [{describe(tree)}]  {human_size(size)}{ahead}")
    keeps = [(tree, keep) for tree, keep in plan if keep is not None]
    for tree, keep in keeps:
        print(f"keep    {show(tree.path)}  [{describe(tree)}]  {keep.text}")
    known = sum(size for _, size in removable if size is not None)
    unknown = sum(1 for _, size in removable if size is None)
    suffix = f", {unknown} of unknown size" if unknown else ""
    print(f"would remove {len(removable)}, {known} bytes ({human_size(known)}){suffix}")
    breakdown = kept_breakdown([keep for _, keep in keeps])
    print(f"kept {len(keeps)}" + (f": {breakdown}" if breakdown else ""))
    return [tree for tree, _ in removable], len(keeps)


def recheck(repo, tree, state):
    """The Keep for `tree` judged on a fresh world, or None when it still may go.

    A note of the fresh world that was not printed yet in this run is printed here."""
    world = take_world(repo, state)
    state.print_new_notes(world.notes)
    for current in world.worktrees:
        if current.path == tree.path:
            return evaluate(repo, world, current), current
    return Keep(VANISHED, "the worktree entry is gone"), tree


def remove_one(repo, tree, tally, state):
    try:
        keep, current = recheck(repo, tree, state)
    except PruneError as error:
        print(f"failed  {show(tree.path)}: the re-check could not read git state: {error}", flush=True)
        tally.failed += 1
        return
    if keep is not None:
        print(f"kept    {show(tree.path)}  [{describe(tree)}]  changed since the list: {keep.text}")
        tally.kept += 1
        return
    size = tree_size(current.path)
    removal = git(repo.main_path, "worktree", "remove", current.path)
    if removal.returncode != 0:
        print(f"failed  {show(current.path)}: git worktree remove refused", flush=True)
        print(removal.stderr.strip(), file=sys.stderr)
        tally.failed += 1
        return
    tally.removed += 1
    tally.freed += size or 0
    print(f"removed {show(current.path)}  [{describe(current)}]  {human_size(size)}")
    delete_branch_after_removal(repo, current, tally)


def delete_branch_after_removal(repo, tree, tally):
    outcome = delete_branch(repo, tree.branch)
    if outcome.failure is not None:
        print(f"failed  branch {tree.branch} stays: {outcome.failure}. The worktree is gone.", flush=True)
        tally.failed += 1
        return
    print(f"deleted branch {tree.branch}")
    if outcome.warning is not None:
        print(outcome.warning)


def prune_worktrees(repo, apply):
    state = RunState()
    world = take_world(repo, state)
    plan = plan_trees(repo, world)
    removable, kept_count = print_plan(repo, world, plan, state)
    if not apply:
        return 0
    tally = Tally(kept=kept_count)
    for tree in removable:
        remove_one(repo, tree, tally, state)
    print(f"removed {tally.removed}, freed {tally.freed} bytes ({human_size(tally.freed)}), "
          f"kept {tally.kept}, failed {tally.failed}")
    return 1 if tally.failed else 0


# ---- check mode ----

def take_tree_world(repo):
    """The world for the tree-state checks: the worktree list and the stashes, nothing else is read."""
    unread = "not read in check mode"
    return World(list_worktrees(repo.main_path), read_stashes(repo.main_path), None, Herdr(None, None), [],
                 LaneRead(None, unread))


def check_path(repo, path):
    """Print the JSON verdict of the worktree at `path`, judged on its own state."""
    world = take_tree_world(repo)
    path_real = real(path)
    for tree in world.worktrees:
        if real(tree.path) != path_real:
            continue
        keep = evaluate(repo, world, tree, TREE_STATE_CHECKS)
        verdict = {"path": tree.path, "branch": tree.branch, "verdict": "remove", "code": None, "reason": None}
        if keep is not None:
            verdict.update({"verdict": "keep", "code": keep.code, "reason": keep.text})
        print(json.dumps(verdict))
        return 0
    raise PruneError(f"{path} is not a worktree of this repository")


# ---- command line ----

def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    checking = argv[:1] == ["--check"]
    if checking and len(argv) != 2:
        print("herdr-worktree-prune: --check takes one path", file=sys.stderr)
        print(USAGE_LINE, file=sys.stderr)
        return 2
    unknown = [] if checking else [arg for arg in argv if arg not in ("--apply", "--branches")]
    if unknown:
        print(f"herdr-worktree-prune: unknown argument: {unknown[0]}", file=sys.stderr)
        print(USAGE_LINE, file=sys.stderr)
        return 2
    sys.stdout.reconfigure(errors="backslashreplace")
    sys.stderr.reconfigure(errors="backslashreplace")
    try:
        repo = start_up()
        if checking:
            return check_path(repo, argv[1])
        if "--branches" in argv:
            return prune_branches(repo, "--apply" in argv)
        return prune_worktrees(repo, "--apply" in argv)
    except PruneError as error:
        print(f"herdr-worktree-prune: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
