#!/usr/bin/env bash
# tuicr-comments-consume — deterministic reader for tuicr review-session comments
# (used by /tuicr-cc). The tuicr-side twin of claude-comments-consume, with the
# same list/resolve contract so the two skills stay shaped alike.
#
# Comments live in tuicr's persisted review sessions, not in a file we own:
#   tuicr review list                       -> sessions for the checkout (JSON)
#   tuicr review comments --session <path>  -> that session's comments (JSON)
#
# WHY A SIDECAR: tuicr exposes list/add/comments but NO delete or mark-resolved,
# so a consumed comment cannot be cleared at the source — it stays visible in
# the TUI until cleared there by hand. Without dedup, every run would re-log the
# same escape and corrupt the flywheel's ground-truth side, so consumed comment
# ids are recorded here and filtered out on the next list. This is a
# double-logging guard, NOT a resolve: the TUI still shows the comment.
# Drop the sidecar if tuicr ever grows a real resolve.
#
# Modes:
#   list <repo-root>
#       Print un-consumed, fresh (<=48h by created_at) local_draft comments from
#       every local session for that checkout, as a JSON array:
#       [{id, session, path, line, end_line, comment_type, timestamp, body}]
#       `id` is tuicr's own comment uuid and is the handle for resolve.
#       Stale un-consumed comments are counted on stderr.
#   resolve <repo-root> <id>...
#       Append the given comment ids to the sidecar so later runs skip them.
#       Idempotent; unknown ids are recorded without complaint (a comment
#       cleared in the TUI between list and resolve is still a valid id).
set -euo pipefail

SIDECAR="${TUICR_CONSUMED_FILE:-$HOME/.claude/tuicr-consumed.txt}"
TTL_SECONDS=$((48 * 3600))

mode="${1:-}"
repo="${2:-}"
case "$mode" in list | resolve) ;; *)
  echo "usage: tuicr-comments-consume list|resolve <repo-root> [id...]" >&2
  exit 2
  ;;
esac
[ -n "$repo" ] || {
  echo "missing repo-root" >&2
  exit 2
}
shift 2
repo="${repo%/}"
[ -d "$repo" ] || {
  echo "no such repo-root: $repo" >&2
  exit 2
}

command -v jq >/dev/null || {
  echo "jq is required" >&2
  exit 1
}
command -v tuicr >/dev/null || {
  # No tuicr on this machine is not an error — the skill just has nothing to read.
  [ "$mode" = "list" ] && echo "[]"
  exit 0
}

if [ "$mode" = "resolve" ]; then
  [ "$#" -gt 0 ] || exit 0
  mkdir -p "$(dirname "$SIDECAR")"
  for id in "$@"; do
    # Anchored match so a uuid is never matched as a substring of another line.
    grep -qxF "$id" "$SIDECAR" 2>/dev/null || printf '%s\n' "$id" >>"$SIDECAR"
  done
  exit 0
fi

# ── list ────────────────────────────────────────────────────────────────────
# `tuicr review list` scopes to the checkout it is run from, so cd rather than
# filtering slugs by hand (slugs are owner/repo@branch/scope/sha — parsing them
# would re-implement tuicr's own repo resolution).
sessions="$(cd "$repo" && tuicr review list 2>/dev/null || true)"
if [ -z "$sessions" ] || [ "$(jq -r 'length' <<<"$sessions" 2>/dev/null || echo 0)" = "0" ]; then
  echo "[]"
  exit 0
fi

consumed_json='[]'
if [ -f "$SIDECAR" ]; then
  consumed_json="$(jq -R -s 'split("\n") | map(select(length > 0))' <"$SIDECAR")"
fi

now="$(date -u +%s)"
all='[]'
# Only local sessions: PR-mode comments belong to the forge thread, and posting
# state there is not ours to interpret.
while IFS= read -r sp; do
  [ -n "$sp" ] || continue
  cmts="$(tuicr review comments --session "$sp" 2>/dev/null || true)"
  [ -n "$cmts" ] || continue
  all="$(jq -c --argjson acc "$all" --arg session "$sp" '
    [ .[]
      | select(.lifecycle_state == "local_draft")
      | { id, session: $session, path, line: .start_line, end_line,
          comment_type, timestamp: .created_at, body: .content }
    ] as $new | $acc + $new
  ' <<<"$cmts")"
done < <(jq -r '.[] | select(.kind == "local") | .path' <<<"$sessions")

# created_at is RFC3339 with fractional seconds AND a numeric UTC offset
# ("2026-08-03T00:46:03.525939420+00:00"); jq's fromdate accepts neither. Trim
# the fraction, then fold the offset in by hand rather than assuming Z.
fresh="$(jq -c --argjson consumed "$consumed_json" --argjson now "$now" --argjson ttl "$TTL_SECONDS" '
  def epoch:
    sub("\\.[0-9]+"; "")
    | capture("^(?<base>.{19})(?<off>Z|[+-][0-9]{2}:[0-9]{2})$")
    | ((.base + "Z") | fromdate) as $t
    | if .off == "Z" then $t
      else
        ((.off[1:3] | tonumber) * 3600 + (.off[4:6] | tonumber) * 60) as $secs
        | if .off[0:1] == "-" then $t + $secs else $t - $secs end
      end;
  map(select(.id as $i | ($consumed | index($i)) | not))
  | map(. + { _age: ($now - (.timestamp | epoch)) })
' <<<"$all")"

stale="$(jq -r --argjson ttl "$TTL_SECONDS" '[.[] | select(._age > $ttl)] | length' <<<"$fresh")"
[ "$stale" -gt 0 ] && echo "$stale stale comment(s) (>48h) skipped" >&2

jq --argjson ttl "$TTL_SECONDS" '[.[] | select(._age <= $ttl) | del(._age)]' <<<"$fresh"
