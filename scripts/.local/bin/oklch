#!/usr/bin/env python3
"""oklch — OKLCH <-> hex conversion and WCAG contrast for theme palette work.

  oklch hex <#rrggbb> [bg]     print L C h, plus contrast against bg
  oklch lch <L> <C> <h> [bg]   print hex, plus contrast against bg
  oklch cr <#fg> <#bg>         print contrast ratio

bg defaults to the dredge ground. Out-of-gamut lch values are clipped to sRGB.
"""
import math
import sys

DEFAULT_BG = "#1c2023"


def oklch_to_hex(L, C, h):
    a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
    l_ = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m_ = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s_ = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    rgb = (4.0767416621 * l_ - 3.3077115913 * m_ + 0.2309699292 * s_,
           -1.2684380046 * l_ + 2.6097574011 * m_ - 0.3413193965 * s_,
           -0.0041960863 * l_ - 0.7034186147 * m_ + 1.7076147010 * s_)
    out = []
    for v in rgb:
        v = max(0.0, min(1.0, v))
        v = 12.92 * v if v <= 0.0031308 else 1.055 * v ** (1 / 2.4) - 0.055
        out.append(round(v * 255))
    return "#%02x%02x%02x" % tuple(out)


def hex_to_oklch(hx):
    c = [int(hx[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    r, g, b = [v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360


def lum(hx):
    c = [int(hx[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    c = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]


def cr(a, b):
    la, lb = lum(a), lum(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def norm(hx):
    hx = hx.lower()
    if not hx.startswith("#"):
        hx = "#" + hx
    if len(hx) != 7 or any(ch not in "0123456789abcdef" for ch in hx[1:]):
        sys.exit(f"oklch: not a #rrggbb colour: {hx}")
    return hx


def main(argv):
    if len(argv) < 2 or argv[0] not in ("hex", "lch", "cr"):
        sys.exit(__doc__.strip())
    cmd, args = argv[0], argv[1:]
    if cmd == "hex" and len(args) in (1, 2):
        hx = norm(args[0])
        bg = norm(args[1]) if len(args) == 2 else DEFAULT_BG
        L, C, h = hex_to_oklch(hx)
        print(f"{hx}  L {L:.3f}  C {C:.3f}  h {h:.1f}  {cr(hx, bg):.2f}:1 on {bg}")
    elif cmd == "lch" and len(args) in (3, 4):
        L, C, h = (float(v) for v in args[:3])
        bg = norm(args[3]) if len(args) == 4 else DEFAULT_BG
        hx = oklch_to_hex(L, C, h)
        print(f"{hx}  {cr(hx, bg):.2f}:1 on {bg}")
    elif cmd == "cr" and len(args) == 2:
        print(f"{cr(norm(args[0]), norm(args[1])):.2f}:1")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
