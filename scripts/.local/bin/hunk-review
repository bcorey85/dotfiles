#!/bin/bash
# Launch Hunk as a review surface, with the two things bare `hunk diff` lacks:
# durable comments and agent rationale.
#
# Bound to `prefix h` (tmux/.tmux.conf), which runs it on the current repo via
# tmux-host-popup. Also fine to run by hand.
#
# The --agent-context conditional below is not optional: `hunk diff
# --agent-context <path>` hard-fails with ENOENT when the sidecar is absent,
# which is most of the time.
#
# Two behaviours are folded in:
#
#   1. Agent rationale. If the agent that wrote the diff left a sidecar at
#      .git/hunk-agent-context.json, it is passed to hunk and per-hunk "why"
#      boxes render anchored to the lines they explain. The path is inside .git
#      deliberately: a sidecar in the worktree shows up as an untracked file in
#      the very diff it is annotating.
#
#   2. Durable comments. Hunk keeps review notes in daemon memory only
#      (upstream #113), so quitting discards them. A `hunk-notes watch` child
#      mirrors them into refs/notes/hunk-review while you read, and is torn
#      down with the TUI.
#
# Usage: hunk-review [PATH]        (defaults to the current directory)

set -uo pipefail

# tmux display-popup runs a non-login, non-interactive shell, so nothing that
# ~/.zshrc puts on PATH is present -- `prefix h` failed with 127 until this was
# added. Re-establish the two directories this script actually needs: the stow
# bin (hunk-notes) and whichever mise node install carries the hunk global.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) PATH="$HOME/.local/bin:$PATH" ;;
esac

if ! command -v hunk >/dev/null 2>&1; then
    for d in "$HOME/.local/share/mise/shims" \
        "$HOME/.local/share/mise/installs/node/lts/bin"; do
        if [ -x "$d/hunk" ]; then
            PATH="$d:$PATH"
            break
        fi
    done
fi
export PATH

command -v hunk >/dev/null 2>&1 || {
    printf 'hunk-review: hunk not found on PATH\n' >&2
    exit 127
}

repo="${1:-$PWD}"
cd "$repo" || {
    printf 'hunk-review: no such directory: %s\n' "$repo" >&2
    exit 1
}

git rev-parse --git-dir >/dev/null 2>&1 || {
    printf 'hunk-review: not a git repository: %s\n' "$repo" >&2
    exit 1
}

git_dir="$(git rev-parse --absolute-git-dir)"
context="$git_dir/hunk-agent-context.json"

# --theme nord: matches the rest of the terminal. Note that hunk does NOT
#   validate this -- an unrecognised name is silently ignored and you get the
#   default palette back, with no error. If the colours ever look wrong, check
#   the spelling here first.
# --agent-notes: hunk hides rationale boxes until you press `a`, which makes
#   them useless -- a note you have to remember to reveal is a note you read
#   after forming an opinion, if at all. `a` still toggles them back off.
# NOT --wrap, despite truncation being silent. Wrapping is fine on a normal
#   diff, but it black-screens the TUI outright on a large untracked set -- a
#   worktree with ~50 untracked files including a few 40-65k-char JSONL lines
#   renders nothing at all and stops responding to `q`. Reproduced against
#   round3/arm3; --no-wrap and --exclude-untracked each clear it, and a single
#   65k line on its own is fine, so the trigger is total wrapped row count, not
#   line length. `w` toggles wrapping per-session from the View menu, which is
#   the right place for it: opt in on the one hunk that needs it.
args=(diff --watch --theme nord --agent-notes)

# Fall back to the last commit when there is nothing unstaged. `hunk diff`
# follows `git diff` semantics -- unstaged only -- which is deliberate: staging
# a file in neogit makes it leave the review pane, so the index works as a free
# review ledger. But the moment the tree is fully committed that same rule
# renders "No files match the current filter" on a blank screen, which reads as
# a hung TUI rather than as an empty queue. Showing HEAD is the useful answer to
# "review what just happened", and the message says which of the two you got.
if git diff --quiet 2>/dev/null && git diff --cached --quiet 2>/dev/null; then
    printf 'hunk-review: working tree clean -- showing the last commit (%s)\n' \
        "$(git log -1 --format='%h %s' 2>/dev/null)" >&2
    args=(show HEAD --theme nord --agent-notes)
fi

[ -f "$context" ] && args+=(--agent-context "$context")

# Start the mirror before the TUI so a comment written in the first seconds is
# still captured. It exits on its own if no session ever registers.
#
# The tty is captured here and handed down: the watcher runs backgrounded with
# its stdio redirected, and under `prefix h` there is no TMUX_PANE to fall back
# on (display-popup does not export it), so this is the only reliable way for
# it to tell which hunk session is ours.
watch_pid=""
tty_dev="$(tty 2>/dev/null)"
case "$tty_dev" in /dev/*) ;; *) tty_dev="" ;; esac

if command -v hunk-notes >/dev/null 2>&1; then
    notes_args=(watch --repo "$repo" --interval 2)
    [ -n "$tty_dev" ] && notes_args+=(--tty "$tty_dev")
    hunk-notes "${notes_args[@]}" >/dev/null 2>&1 &
    watch_pid=$!
fi

cleanup() {
    # One last pass: the poll interval can miss a comment written in the final
    # seconds. Harmless no-op if the daemon has already dropped the session.
    [ -n "$watch_pid" ] && kill "$watch_pid" 2>/dev/null
    if command -v hunk-notes >/dev/null 2>&1; then
        dump_args=(dump --repo "$repo")
        [ -n "$tty_dev" ] && dump_args+=(--tty "$tty_dev")
        hunk-notes "${dump_args[@]}" >/dev/null 2>&1
    fi
    return 0
}
trap cleanup EXIT INT TERM

hunk "${args[@]}"
