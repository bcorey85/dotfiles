[include]
	path = ~/.gitconfig.local

[includeIf "gitdir:~/dotfiles/"]
	path = ~/.gitconfig.personal

[includeIf "gitdir:~/personal/"]
	path = ~/.gitconfig.personal

[includeIf "gitdir:~/vault/"]
	path = ~/.gitconfig.personal

[core]
	pager = delta --side-by-side

# Fugitive decides between a vim buffer and a real terminal by reading
# pager.<subcommand> only -- never core.pager. A string value routes `:Git diff`
# to termopen with the pager live; without one it renders into a plain vim
# buffer. Delta is named explicitly here so `:Git diff` gets the same
# side-by-side output as the terminal.
[pager]
	diff = delta --side-by-side
	show = delta --side-by-side
	log = delta --side-by-side

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	# Code stays the terminal's fg: the washes and changed words carry the diff.
	syntax-theme = none

# theme-mode writes this machine-local include: dark/light, the washes, changed
# words, moved code, line numbers and headers, from the family's hunk palette.
# It comes after [delta] so its values win. git skips it until theme-mode runs.
[include]
	path = ~/.config/delta/theme.gitconfig

[pull]
	rebase = true

[merge]
	conflictstyle = zdiff3
	tool = codediff

[diff]
	colorMoved = default
	# Treat a re-indented block (wrapped in an if, moved into a function) as
	# moved rather than rewritten — otherwise every refactor that changes nesting
	# shows up as a wall of add/remove.
	colorMovedWS = allow-indentation-change
[mergetool]
	keepBackup = false
[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff merge $MERGED\"
[status]
	showUntrackedFiles = all
