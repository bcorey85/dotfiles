#!/usr/bin/env python3
"""verify-log --rows <file|-> [--result NA] [--escapes-only]
verify-log review --result <PASS|PASS WITH WARNINGS|NEEDS CHANGES> --rows <file|-> [--findings <n>]

Logging half of /verify-branch. Reads the context verify-prep saved, and refuses to write unless a branch-wide review
covers the tree verify-prep measured and the tree has not changed since (exit 2: rerun verify-prep).

rows: a JSON list; each row {"item","verdict","file","line","evidence", optional "severity","guard","signoff"}.
Every criterion id verify-prep saved needs a verdict row naming it, `missing` included; any id with no row exits 2 and
writes nothing. The same holds for each ticket criterion, with or without a criteria file: it needs a row whose `item`
starts with its `Ticket #n` label (as verify-prep numbers them; leading markdown emphasis or code marks are allowed).
verdict is done|partial|missing|failed-check|needs-manual|overridden. partial, missing, failed-check and an
overridden row with no `signoff` are gaps. `line` is an integer or a range like "12-20" (the first number is kept).
Empty rows are an error unless --result NA, which logs a run row with no result and exits 3.
--escapes-only logs the escape rows of a run that was already logged in full; an escape logged once is not logged again.

review: logs the branch-wide code-reviewer run row (stamped with a fingerprint of the tree as it stands, so prep can
tell a later change) and one finding row per reviewer finding. --rows is a JSON list of
{"desc","file","line","actioned", optional "class","disposition"}; `actioned` is required and cannot be `none` on a
`fix` finding. A blocker is a finding whose `desc` starts with `[blocker]` (any case); its actioned must be `fixed`
or `skipped_fp`. A fix finding that is not a blocker may be deferred. --findings, when given, must equal its length.
A second review for a tree a row already covers exits 2.

Every value the loggers own (class, disposition, actioned, result, guard) is checked by the loggers themselves:
before the first write each row goes through its logger once with `--check` as the first argument, and a refusal
stops the run with nothing written.

Writes: one plan-verifier run row, one plan-drift finding row per gap, and (with a `guard`) one drift-gate escape
row per gap. Prints the checklist skeleton. Exit 0 logged, 2 loud failure, 3 verdict was N/A (not a pass).
"""
import json
import os
import pathlib
import re
import sys

sys.path[:0] = [str(pathlib.Path(__file__).resolve().parent / folder) for folder in (".", "../lib")]
import script_utils
import verify_common as vc

VERDICTS = ("done", "partial", "missing", "failed-check", "needs-manual", "overridden")
REVIEW_RESULTS = ("PASS", "PASS WITH WARNINGS", "NEEDS CHANGES")
LEADING_INT = re.compile(r"^\s*(\d+)")
BLOCKER_TAG = re.compile(rf"^\s*{script_utils.BLOCKER_TAG_PATTERN}", re.IGNORECASE)
BLOCKER_OUTCOMES = ("fixed", "skipped_fp")


def log_text(text, limit=200):
    # A log argument holds no double quote.
    return script_utils.one_line(text or "", limit).replace('"', "'")


def is_gap(row):
    if row["verdict"] in ("partial", "missing", "failed-check"):
        return True
    return row["verdict"] == "overridden" and not str(row.get("signoff") or "").strip()


def ids_without_verdict_row(rows, context):
    """The criteria-file ids prep saved that no verdict row names, in file order."""
    covered = set()
    for row in rows:
        covered.update(vc.AC_ID.findall(str(row["item"])))
    return [ac_id for ac_id in context["criteria"].get("ids", []) if ac_id not in covered]


def ticket_labels_without_verdict_row(rows, context):
    """The ticket criterion labels (`Ticket #2`) prep saved that no verdict row names, in ticket order. A label matches
    at the start of the row, at a word boundary, so `Ticket #1` is not found inside `Ticket #12` or mid-text."""
    item_texts = [str(row["item"]) for row in rows]
    return [label for label in context["criteria"].get("ticketLabels", [])
            if not any(re.match(r"[\s*_`]*" + re.escape(label) + r"\b", text) for text in item_texts)]


def parse_options(args, valued, flag_names=()):
    """({option: value}, {flags}) from args; an option in `valued` takes the next argument. Any other argument fails."""
    options = {}
    flags = set()
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in valued:
            if index + 1 >= len(args):
                raise vc.VerifyError(f"{arg} needs a value")
            options[arg] = args[index + 1]
            index += 2
        elif arg in flag_names:
            flags.add(arg)
            index += 1
        else:
            known = ", ".join([*valued, *flag_names])
            raise vc.VerifyError(f"unknown argument {arg!r}; this command takes {known}")
    return options, flags


def normalize_line(value, where):
    if value in (None, ""):
        return 0
    if isinstance(value, int) and not isinstance(value, bool):
        return value
    match = LEADING_INT.match(str(value))
    if not match:
        raise vc.VerifyError(f"{where}: line {value!r} is not an integer or a range like 12-20")
    return int(match.group(1))


def read_json_list(source, what):
    text = sys.stdin.read() if source == "-" else pathlib.Path(source).read_text()
    try:
        items = json.loads(text)
    except ValueError as error:
        raise vc.VerifyError(f"{what} are not valid JSON: {error}") from error
    if not isinstance(items, list):
        raise vc.VerifyError(f"{what} must be a JSON list")
    return items


def load_rows(source):
    rows = read_json_list(source, "rows")
    for index, row in enumerate(rows):
        if not isinstance(row, dict) or row.get("verdict") not in VERDICTS or not row.get("item"):
            raise vc.VerifyError(f"row {index} needs `item` and a verdict in {', '.join(VERDICTS)}")
        row["line"] = normalize_line(row.get("line"), f"row {index}")
    return rows


def load_review_findings(source):
    findings = read_json_list(source, "findings")
    for index, finding in enumerate(findings):
        if not isinstance(finding, dict) or not finding.get("desc") or not finding.get("file"):
            raise vc.VerifyError(f"finding {index} needs `desc` and `file`")
        if not finding.get("actioned"):
            raise vc.VerifyError(
                f"finding {index} needs `actioned`: what happened to it (a finding the reviewer reported "
                "is never logged without its outcome)"
            )
        finding.setdefault("class", "correctness")
        finding.setdefault("disposition", "fix")
        is_blocker = BLOCKER_TAG.match(str(finding["desc"]))
        if is_blocker and finding["actioned"] not in BLOCKER_OUTCOMES:
            raise vc.VerifyError(f"finding {index}: a blocker cannot be deferred or left open; fix it (or mark it "
                                 "skipped_fp) before logging the review")
        if finding["disposition"] == "fix" and finding["actioned"] == "none":
            raise vc.VerifyError(f"finding {index}: a `fix` finding cannot have actioned `none`; fix it, mark it "
                                 "skipped_fp, or defer it (not a blocker)")
        finding["line"] = normalize_line(finding.get("line"), f"finding {index}")
    return findings


def call_logger(argv, cwd):
    """None when the logger exited 0, else a neutral failure text. The caller says whether that blocks."""
    done = vc.run(argv, cwd=cwd)
    if done.returncode == 0:
        return None
    detail = (done.stderr.strip() or done.stdout.strip())[:400]
    return f"logger failed (exit {done.returncode}): {detail}"


def check_all(writes, cwd):
    """Run every logger call once with `--check` first. Nothing is written; one refusal stops the run."""
    for write in writes:
        argv = write["argv"]
        failure = call_logger([*argv[:2], "--check", *argv[2:]], cwd)
        if failure:
            raise vc.VerifyError(f"{failure}\n  rejected row: {write['label']}\n  nothing was written")


def write_all(writes, cwd, after_write=None):
    """Run every logger call in order. A failure stops the run and names the rows that were not logged."""
    for position, write in enumerate(writes):
        failure = call_logger(write["argv"], cwd)
        if failure:
            not_logged = "\n".join(f"  NOT logged: {pending['label']}" for pending in writes[position:])
            raise vc.VerifyError(f"{failure}\n{not_logged}")
        if after_write:
            after_write(write)


def finding_prefix(context, gate):
    return ["repo=" + context["repo"], "branch=" + context["branch"], "lane=verify", "scope=branch-exit",
            "phase=-", "iter=0", "gate=" + gate]


def require_current_review(context, top):
    """Exit 2 unless the tree is the one verify-prep measured and a branch-wide review row covers it."""
    if "fingerprint" not in context:
        raise vc.VerifyError("the saved verify-prep context has no tree fingerprint: rerun verify-prep")
    fingerprint = vc.branch_fingerprint(top, context["mergeBase"], context["excludeRel"])
    if fingerprint != context["fingerprint"]:
        raise vc.VerifyError("the tree changed since verify-prep measured it: rerun verify-prep")
    review = vc.review_state(context["repo"], context["branch"], fingerprint, context.get("reviewLoggedTree"))
    if not review["ran"]:
        raise vc.VerifyError(f"no branch-wide code review covers this tree ({review['reason']}): rerun verify-prep "
                             "and do its review step first")
    if not review["read"]:
        print(f"verify-log: review check read from this checkout's record: {review['reason']}", file=sys.stderr)


def log_review(args, context, top):
    options, _ = parse_options(args, ("--result", "--rows", "--findings"))
    result = options.get("--result")
    if result not in REVIEW_RESULTS:
        raise vc.VerifyError(f"review needs --result, one of {', '.join(REVIEW_RESULTS)}")
    findings = load_review_findings(options["--rows"]) if "--rows" in options else []
    declared = options.get("--findings")
    if declared is not None and not declared.isdigit():
        raise vc.VerifyError(f"--findings {declared!r} is not a count")
    if declared is not None and int(declared) != len(findings):
        raise vc.VerifyError(f"--findings {declared} but --rows holds {len(findings)} finding(s): log every finding")
    if declared is None and "--rows" not in options:
        raise vc.VerifyError("review needs --rows (a JSON list; [] when the reviewer found nothing)")

    fingerprint = vc.branch_fingerprint(top, context["mergeBase"], context["excludeRel"])
    review = vc.review_state(context["repo"], context["branch"], fingerprint, context.get("reviewLoggedTree"))
    if review["ran"]:
        raise vc.VerifyError(f"a branch-wide review row already covers this tree ({review['reason']}): nothing to "
                             "log. Rerun verify-prep. Change the tree (a fix) before logging another review.")

    logger = vc.script_path("LOG_REVIEW_FINDING_SCRIPT", "skills/review/log-review-finding")
    prefix = finding_prefix(context, vc.REVIEW_GATE)
    writes = [{"label": "code-reviewer run row",
               "argv": ["bash", logger, "kind=run", *prefix, f"n_findings={len(findings)}",
                        f"diff_loc={context['diff']['diffLoc']}", f"result={result}",
                        f"source={vc.REVIEW_MARKER}", f"tree={fingerprint}"]}]
    for finding in findings:
        writes.append({"label": f"finding: {log_text(finding['desc'], 80)}",
                       "argv": ["bash", logger, "kind=finding", *prefix, f"disposition={finding['disposition']}",
                                f"class={finding['class']}", f"file={finding['file']}", f"line={finding['line']}",
                                f"actioned={finding['actioned']}", f"desc={log_text(finding['desc'])}"]})
    check_all(writes, top)
    write_all(writes, top)

    context["reviewLoggedTree"] = fingerprint
    vc.save_context(vc.context_path(context["repo"], context["branch"]), context)
    print(f"logged code-reviewer branch-exit run row and {len(findings)} finding row(s)")
    return 0


def read_source(path, what):
    try:
        return pathlib.Path(path).read_text()
    except OSError as error:
        raise vc.VerifyError(f"{what} {path} cannot be read now: {error}") from error


def checklist(context, rows):
    """The review-packet skeleton. The ticket, the criteria file and the plan are read again here, so an edit since
    verify-prep reaches the checklist."""
    ticket_path = context["ticket"]
    ticket_entries = vc.ticket_criteria(read_source(ticket_path, "ticket"), ticket_path)
    manual_entries = []
    if context.get("criteriaPath"):
        _, manual_entries = vc.parse_criteria_file(read_source(context["criteriaPath"], "criteria file"),
                                            context["criteriaPath"])

    lines = ["## Smoke-test checklist (fill each steps: with concrete steps)"]
    for entry in ticket_entries:
        lines.append(f"- [ ] {entry['label']}: {entry['text']}\n      steps: <model>")
    for entry in manual_entries:
        lines.append(f"- [ ] (manual-only) {entry['id']}: {entry['text']}\n      steps: <model>")
    moved_notes = []
    if context["plan"]:
        plan_text = read_source(context["plan"], "plan")
        for item in vc.manual_items(plan_text, context["plan"]):
            if item["humanOnly"]:
                lines.append(f"- [ ] (human-only) {item['text']}\n      steps: <model>")
        moved_notes = vc.moved_phase_notes(plan_text, context["plan"])
    for row in rows:
        if row["verdict"] == "needs-manual":
            lines.append(f"- [ ] (needs-manual) {log_text(row['item'], 300)}\n      steps: <model>")
    if moved_notes:
        lines.append("")
        lines.append("## Moved phases (another ticket owns them; not checked on this branch)")
        lines.extend(f"- {note}" for note in moved_notes)
    lines.append("")
    lines.append("## Diff hotspots (read these first, skim the rest)")
    hotspots = context["diff"]["hotspots"]
    lines.extend(f"- {name}" for name in hotspots or ["none"])
    evidence = [row for row in rows if row["verdict"] == "done" and row.get("file")]
    if evidence:
        lines.append("")
        lines.append("## Evidence to jump to (nvim-jump, table order)")
        for row in evidence:
            lines.append(f"- {row['file']}:{row['line']}  {log_text(row['item'], 120)}")
    return "\n".join(lines)


def escape_key(row, context):
    return f"{log_text(row['item'])}\t{row.get('file') or context['planRel']}"


def plan_row_writes(rows, context, not_applicable, escapes_only):
    """(writes, gaps, need_guard, already_recorded): every logger call this run makes, in order."""
    finder = vc.script_path("LOG_REVIEW_FINDING_SCRIPT", "skills/review/log-review-finding")
    escaper = vc.script_path("LOG_ESCAPE_SCRIPT", "scripts/telemetry/log-escape")
    gaps = [row for row in rows if is_gap(row)]
    plan_rel = context["planRel"]
    writes = []

    if not escapes_only:
        prefix = finding_prefix(context, "plan-verifier")
        run_argv = [
            "bash",
            finder,
            "kind=run",
            *prefix,
            f"n_findings={len(gaps)}",
            f"diff_loc={context['diff']['diffLoc']}",
        ]
        if not not_applicable:
            run_argv.append(f"result={'NEEDS CHANGES' if gaps else 'PASS'}")
        writes.append({"label": "plan-verifier run row", "argv": run_argv, "marksLogged": True})
        for row in gaps:
            writes.append({"label": f"plan-drift finding: {log_text(row['item'], 80)}",
                           "argv": ["bash", finder, "kind=finding", *prefix, "disposition=fix", "class=plan-drift",
                                    f"file={row.get('file') or plan_rel}", f"line={row['line']}", "actioned=none",
                                    f"desc={log_text(row['item'])}"]})

    need_guard = []
    already_recorded = 0
    for row in gaps:
        if not row.get("guard"):
            need_guard.append(row)
            continue
        key = escape_key(row, context)
        if key in context["escapes"]:
            already_recorded += 1
            continue
        escape_argv = ["bash", escaper, f"repo={context['repo']}", "stage_found=verify", "gate_missed=drift-gate",
                      "class=plan-drift", "lane=eng-spec", f"guard={row['guard']}",
                      f"desc={log_text(row['item'])}", f"file={row.get('file') or plan_rel}"]
        if row.get("severity"):
            escape_argv.append(f"severity={row['severity']}")
        writes.append({"label": f"drift-gate escape: {log_text(row['item'], 80)}", "argv": escape_argv,
                       "escapeKey": key})
    return writes, gaps, need_guard, already_recorded


def log_rows(args, context, top):
    options, flags = parse_options(args, ("--rows", "--result"), ("--escapes-only",))
    if "--rows" not in options:
        raise vc.VerifyError("--rows is required (use `--rows -` for stdin)")
    if options.get("--result", "NA") != "NA":
        raise vc.VerifyError(f"--result {options['--result']!r}: only NA is accepted (the verdict comes from the rows)")
    not_applicable = "--result" in options
    escapes_only = "--escapes-only" in flags

    if escapes_only and not context.get("logged"):
        raise vc.VerifyError("--escapes-only follows a full run of this prep context, and none was logged: "
                      "run verify-log --rows without it")
    if not escapes_only and context.get("logged"):
        raise vc.VerifyError("this prep context was already logged; rerun verify-prep first, or pass --escapes-only")
    require_current_review(context, top)

    rows = load_rows(options["--rows"])
    if not_applicable and rows:
        raise vc.VerifyError("--result NA takes empty rows: the gate had nothing to check")
    if not rows and not not_applicable:
        raise vc.VerifyError("rows are empty: pass --result NA if the plan gave the gate nothing to check")
    absent_ids = [] if not_applicable else ids_without_verdict_row(rows, context)
    absent_labels = [] if not_applicable else ticket_labels_without_verdict_row(rows, context)
    if absent_ids or absent_labels:
        absent = [*absent_ids, *absent_labels]
        raise vc.VerifyError(
            f"no verdict row for {', '.join(absent)}: send a verdict for every criterion id and every ticket "
            "criterion (named `Ticket #n` at the start of `item`), `missing` included. Nothing was written"
        )

    writes, gaps, need_guard, already_recorded = plan_row_writes(rows, context, not_applicable, escapes_only)
    packet = checklist(context, rows) if not gaps and not not_applicable and not escapes_only else None
    check_all(writes, top)

    state_path = vc.context_path(context["repo"], context["branch"])

    def record(write):
        if write.get("marksLogged"):
            context["logged"] = True
        if write.get("escapeKey"):
            context["escapes"].append(write["escapeKey"])
        vc.save_context(state_path, context)

    write_all(writes, top, record)

    if escapes_only:
        print(f"escapes logged: {len(writes)}")
        if already_recorded:
            print(f"escapes already recorded, not logged again: {already_recorded}")
        for row in need_guard:
            print(f"  NEEDS GUARD (ratchet, escape-ratchet.md): {log_text(row['item'], 120)}")
        return 0

    counts = {verdict: sum(1 for row in rows if row["verdict"] == verdict) for verdict in VERDICTS}
    print(f"verdicts: {len(rows)} items " + ", ".join(f"{k}={v}" for k, v in counts.items()))
    if already_recorded:
        print(f"escapes already recorded, not logged again: {already_recorded}")
    if not_applicable:
        print(
            "N/A: no criteria in scope. This is NOT a pass: the gate did not run. Tell the user; do not report "
            "completeness."
        )
        return 3
    if gaps:
        print(f"GAPS: {len(gaps)} (logged as plan-drift findings). List them for the user, then offer /fix or /code.")
        for row in need_guard:
            print(f"  NEEDS GUARD (ratchet, escape-ratchet.md): {log_text(row['item'], 120)}")
        if need_guard:
            print("  Rerun with the guards added to those rows and --escapes-only to log the escapes.")
        return 0
    print("CLEAN. The packet needs the bare /refactor check, then:")
    print(packet)
    return 0


def main(argv):
    if not argv:
        raise vc.VerifyError("usage: verify-log --rows <file|-> | verify-log review --result R --rows <file|->")
    top = vc.repo_top(os.getcwd())
    repo = script_utils.repo_name(top)
    branch = vc.require_branch(top)
    context = vc.load_context(vc.context_path(repo, branch))
    context.setdefault("escapes", [])

    if argv[0] == "review":
        return log_review(argv[1:], context, top)
    return log_rows(argv, context, top)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except vc.VerifyError as error:
        vc.die(error)
