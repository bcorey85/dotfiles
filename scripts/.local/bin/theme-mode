        role_extra=$(cat <<EOF
"entity.other.inherited-class"      = "$desc"
"support.class"                     = "$desc"
"meta.function-call entity.name.function" = "$act"
"new.expr entity.name.type"         = "$act"
"new.expr entity.name.function"     = "$act"
"meta.function.decorator.python"    = "$act"
"meta.object-literal.key"           = "$bind"
"keyword.control.return.shell"      = "$exit_fg"
"keyword.control.flow.ts"           = "$exit_fg"
"keyword.control.flow.tsx"          = "$exit_fg"
"keyword.control.flow.js"           = "$exit_fg"
"keyword.control.trycatch.ts"       = "$kw"
"storage.type.sql"                  = "$desc"
"heading.1.markdown entity.name.section.markdown" = "$heading1"
"heading.1.markdown punctuation.definition.heading.markdown" = "$heading1"
EOF
        )
      fi
