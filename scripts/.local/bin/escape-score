#!/bin/bash
# Status-right segment: escapes you caught in the last 7 days.
#
# An "escape" is a defect the automated gates passed and a human caught anyway
# (~/.claude/review-escapes.jsonl, written by /fix, /cc, /refactor, /verify and
# manual /escape). Every row is one time you beat the machine.
#
# This exists as a scoreboard, not as telemetry — /audit review already reads
# the same file for calibration. The point is reward shaping: spawning another
# agent pane pays out instantly and visibly, while reading a diff pays out
# slowly and invisibly, so the editor lane loses on reward even when it is the
# better use of attention. A number that ticks up when you find something the
# loop missed gives reading the same shape: uncertain payoff, visible score.
#
# Shown even at 0, on purpose: a zero you can see is a prompt to go hunting,
# where a hidden segment only appears after you have already scored. Flip the
# `[ "$count" -gt 0 ] ||` guard at the bottom if the zero starts nagging.
#
# Colors are ANSI palette names so they track the active terminal theme (same
# reason as workmux-attention). Armed into status-right by
# tmux-arm-escape-segment; no background because this is ambient score, not an
# alert — backgrounds in this bar mean "something needs you now".

WINDOW_DAYS=7
SRC="${REVIEW_ESCAPES_FILE:-$HOME/.claude/review-escapes.jsonl}"
CACHE="$HOME/.cache/escape-score"

command -v jq >/dev/null 2>&1 || exit 0
[ -f "$SRC" ] || exit 0

# mtime, portably: GNU stat wants -c, BSD/macOS stat wants -f.
mtime="$(stat -c %Y "$SRC" 2>/dev/null || stat -f %m "$SRC" 2>/dev/null)" || exit 0
now="$(date +%s)"

# Cache keyed on the log's mtime AND wall time: the count can change with no
# new rows, because the 7-day window slides old ones off the back. 10 minutes
# of staleness on a weekly counter is invisible; recomputing every status tick
# (1s while an agent is waiting) is not free once this file has real volume.
if [ -f "$CACHE" ]; then
  read -r c_mtime c_at c_count <"$CACHE" 2>/dev/null || true
  if [ "$c_mtime" = "$mtime" ] && [ $((now - ${c_at:-0})) -lt 600 ]; then
    count="$c_count"
  fi
fi

if [ -z "${count:-}" ]; then
  cutoff=$((now - WINDOW_DAYS * 86400))
  # Line-at-a-time (jq -R + fromjson?) rather than slurping: one malformed row
  # should cost that row, not the whole segment. Rows predating the `date`
  # field, or with an unparseable one, drop out the same way.
  count="$(
    jq -R 'fromjson? // empty | .date // empty | fromdateiso8601? // empty' <"$SRC" 2>/dev/null |
      awk -v cut="$cutoff" '$1 > cut { n++ } END { print n + 0 }'
  )"
  [ -n "$count" ] || count=0
  mkdir -p "$(dirname "$CACHE")"
  printf '%s %s %s\n' "$mtime" "$now" "$count" >"$CACHE" 2>/dev/null || true
fi

printf '#[fg=magenta,bold] 🎯 %s #[default] ' "$count"
exit 0
