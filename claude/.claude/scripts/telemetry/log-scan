#!/usr/bin/env bash
# log-scan — write one scan_run row through `ledger write` per deterministic-scan RUN.
#
# Why this exists: a scan that is never scored is unfalsifiable. The review_escape
# rows record what a HUMAN caught downstream; the review rows record what the
# review loop caught. Neither records whether a scan fired, whether what it
# printed was real, or whether it ran at all. Without these rows, "we added a
# dead-code scan" can never be checked against "did it ever catch anything," and
# a scan that produces nothing but noise looks exactly like a scan that keeps the
# tree clean.
#
# The number that matters:
#   candidates → confirmed  is PRECISION. A scan whose confirmed/candidates
#     ratio collapses is training its reader to skim, and should be tightened
#     or retired. Log the dismissals honestly — a run with 12 candidates and 0
#     confirmed is the single most valuable row in this file.
#
# There is no recall number. The escape-side field that was meant to carry it is
# retired and was never populated, so a scan's misses are not measured anywhere.
# Precision here can retire a noisy scan; it can never justify keeping one.
#
# The exit code answers "did it run", never "did it pass" — those came apart the
# first time a grep-family scan was logged, because grep exits 1 on a clean tree:
#   exit=0  ran, printed rows
#   exit=1  ran, printed nothing — a PASS, and candidates=0 confirmed=0
#   exit=2  DID NOT RUN. Log it. An unlogged non-run is indistinguishable from a
#           clean tree, which is how a broken scan survives.
# Both 0 and 1 therefore require the counts. A ran-and-found-nothing row with no
# counts reads as an error row, which silently deletes the precision denominator.
#
# usage: log-scan key=value [key=value ...]
#   required:
#     scan=acceptance-stub|prohibition|other
#       prohibition = a banned pattern that must not appear at all (a plan's
#       "git grep <X> returns zero hits" criterion). candidates is the hit
#       count, so a passing run is exit=1 with candidates=0.
#     stage=branch-recap|code-phase|refactor|manual
#     exit=<the scan's actual exit code — see above>
#   required when the scan RAN (exit=0 or exit=1):
#     candidates=<rows the scan printed>
#     confirmed=<rows you judged real after reading them>
#   optional:
#     fixed=<confirmed rows actually fixed this run>
#     fp=<candidates dismissed as false positives>
#     note="one line — what the confirmed ones were, or why all were dismissed"
#       accepted for the caller's own record; never stored
#     branch=<branch name>   sent as branch_key (a keyed hash)
#
# Every value is sent as a JSON string; `ledger write` types it, stores an
# unknown scan or stage as `other`, and adds date, repo and session. With no
# `ledger` on PATH `ledger-write` drops the row and
# prints one stderr line. A row `ledger write` refuses exits 2.
set -euo pipefail

script_dir=$(dirname -- "${BASH_SOURCE[0]}")
# shellcheck source=../lib/_kv.sh
source "$script_dir/../lib/_kv.sh"
kv_help_exit "${BASH_SOURCE[0]}" "$@"

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

json='{}'
kv_fold "note" "" "$@"

need() {
  local f; f=$(jq -r --arg k "$1" '.[$k] // ""' <<< "$json")
  [ -n "$f" ] && return 0
  echo "refusing to log: $1= is required." >&2
  exit 1
}
need scan; need stage; need exit

code=$(jq -r '.exit' <<< "$json")
if [ "$code" = "0" ] || [ "$code" = "1" ]; then
  need candidates; need confirmed
  c=$(jq -r '.candidates' <<< "$json"); f=$(jq -r '.confirmed' <<< "$json")
  if [ "$f" -gt "$c" ] 2>/dev/null; then
    echo "refusing to log: confirmed ($f) exceeds candidates ($c)." >&2
    exit 1
  fi
  if [ "$code" = "1" ] && [ "$c" != "0" ]; then
    echo "refusing to log: exit=1 means the scan ran and printed nothing, so candidates must be 0 (got $c)." >&2
    echo "If the scan errored rather than passing, log exit=2 — that is the did-not-run code." >&2
    exit 1
  fi
fi

"$script_dir/telemetry_enabled.sh" 2>/dev/null || exit 0

payload=$(jq -c 'del(.note) | with_entries(.key |= ({"branch": "branch_key"}[.] // .))' <<< "$json")
printf '%s\n' "$payload" | bash "$script_dir/ledger-write" scan_run
