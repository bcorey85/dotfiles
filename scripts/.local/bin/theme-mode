"variable.parameter.function.js"    = "$param"
"variable.interpolation"            = "$var"
"variable.language.rust"            = "$vbi"
"entity.name.variable.field.cs"     = "$mem"
"entity.name.variable.local.cs"     = "$var"
"meta.definition.variable.name.java" = "$var"
"support.variable.dom"              = "$var"
"support.variable.object.node"      = "$typ"
"support.variable.object.process"   = "$typ"
"support.type.object.console"       = "$typ"
"support.variable.magic.python"     = "$vbi"
"entity.name.section.markdown"      = "$text"
"punctuation.definition.heading.markdown" = "$punct"
"punctuation.definition.list.begin.markdown" = "$punct"
"beginning.punctuation.definition.list.markdown" = "$punct"
"punctuation.definition.metadata.markdown" = "$punct"
"punctuation.definition.string.begin.markdown" = "$punct"
"punctuation.definition.string.end.markdown" = "$punct"
"punctuation.section.embedded"      = "$esc"
"constant.other.character-class.regexp" = "$esc"
"constant.character.entity"         = "$esc"
"keyword.other.unit"                = "$num"
"meta.function.c"                   = "$text"
"meta.function.cpp"                 = "$text"
"text.variable"                     = "$var"
"support.function.any-method"       = "$call"
"support.function.console"          = "$call"
"support.function.std.rust"         = "$fn"
"meta.require"                      = "$fn"
"keyword.other.special-method"      = "$fn"
"meta.function-call.generic.python" = "$call"
"meta.function-call.php"            = "$fn"
"meta.function.decorator.python"    = "$fn"
"meta.method.java"                  = "$fn"
"meta.method.groovy"                = "$fn"
"keyword.operator.expression.import" = "$kw"
"entity.other.attribute-name.id"    = "$attr"
"entity.name.section"               = "$text"
"entity.name.goto-label.php"        = "$text"
"string.other.link.title.markdown"  = "$typ"
"string.other.link.description.markdown" = "$typ"
"support.type.type.flowtype"        = "$typ"
EOF
  fi
  } | drop_overridden_scopes "${extra:-}"
  if [ -n "${extra:-}" ]; then
    printf '%s\n' "$extra"
  fi
}

hunk_set_block() { # <file> <block-or-empty> — replace theme-mode's marked block
  # Drops any prior marked block (markers inclusive), then appends the fresh one
  # at EOF. Empty content just clears it (the builtin path). The [custom_theme]
  # table lands after hunk's bare keys, keeping the same "tables sort last"
  # invariant hunk_set relies on.
  local file="$1" content="$2" tmp
  tmp="$(mktemp)"
  awk -v b="$HUNK_BLOCK_BEGIN" -v e="$HUNK_BLOCK_END" '
    $0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip { print }
  ' "$file" >"$tmp"
  if [ -n "$content" ]; then
    { echo "$HUNK_BLOCK_BEGIN"; printf '%s\n' "$content"; echo "$HUNK_BLOCK_END"; } >>"$tmp"
  fi
  mv "$tmp" "$file"
}

hunk_set() { # <file> <key> <toml-value> — set a top-level key, preserving the rest
  # Anchored so it only ever touches the top-level key, never a same-named key
  # inside one of hunk's tables ([vcs], [pager], [custom_theme], ...). Those
  # tables all sort after the bare keys hunk writes, so appending stays legal
  # TOML: a new key added below a table header would silently join that table.
  local file="$1" key="$2" value="$3"
  if grep -q "^$key = " "$file" 2>/dev/null; then
    sed -i.bak "s|^$key = .*|$key = $value|" "$file" && rm -f "$file.bak"
  elif grep -q '^\[' "$file" 2>/dev/null; then
    sed -i.bak "1i\\
$key = $value" "$file" && rm -f "$file.bak"
  else
    printf '%s = %s\n' "$key" "$value" >>"$file"
  fi
}

hunk_leak_scopes() { # <base> <block> -> scope lines that out-rank the base's deeper selectors
  # Empty, with a warning, when hunk, its node or the base theme is missing:
  # the block still applies, with the base leaking through.
  local hunk_bin hunk_root node_bin
  hunk_bin="$(mise which hunk 2>/dev/null || command -v hunk)" || return 0
  hunk_root="$(dirname "$(readlink -f "$hunk_bin")")/.."
  node_bin="$(dirname "$hunk_bin")/node"
  [ -x "$node_bin" ] || node_bin="$(command -v node)" || return 0
  printf '%s\n' "$2" |
    "$node_bin" "$HOME/.local/bin/hunk-theme-leaks" "$hunk_root/dist/npm/main.js" "$1" ||
    echo "theme-mode: hunk base theme leaks not closed (hunk-theme-leaks failed)" >&2
}

hunk_apply() { # <family> <mode> — point hunk's config at the family's theme
  local base custom cfg
  base="$(hunk_theme "$1" "$2")"
  cfg="$HOME/.config/hunk/config.toml"
  # No template here, unlike herdr/starship: hunk WRITES this file itself
  # (the in-app View menu persists theme, wrap, line numbers and more), so
  # regenerating it would silently drop the user's other preferences. Set only
  # the keys this script owns, and create the file when there is none.
  mkdir -p "$(dirname "$cfg")"
  [ -f "$cfg" ] || : >"$cfg"

  # A family with a custom block selects theme="custom" and inherits syntax from
  # `base`; one without falls back to the plain builtin. Set the bare keys before
  # appending the [custom_theme] table so they stay above it (bare keys first).
  custom="$(hunk_custom_theme "$1" "$2" "$base")"
  if [ -n "$custom" ]; then
    hunk_set "$cfg" theme '"custom"'
  elif [ -n "$base" ]; then
    hunk_set "$cfg" theme "\"$base\""
  else
    return 0
  fi
  # A builtin (or a syntax-only custom block) paints its own background, a step
  # off the terminal's, so let the terminal show through. A full custom block
  # already carries the terminal's background, and transparency there turns
  # popup panels see-through: hunk 0.23 leaves the diff text visible in the
  # spaces of the selection and note popups.
  if [[ "$custom" == *$'\n'"background "* ]]; then
    hunk_set "$cfg" transparent_background false
    # A full block owns all syntax colour, so the base's deeper selectors
    # (`keyword.operator.expression.delete` over our `keyword.operator.expression`)
    # must not win. The block ends in [custom_theme.syntax_scopes], so the
    # extra lines join that table.
    local leak_scopes
    leak_scopes="$(hunk_leak_scopes "$base" "$custom")"
    if [ -n "$leak_scopes" ]; then
      custom="$custom"$'\n'"$leak_scopes"
    fi
  else
    hunk_set "$cfg" transparent_background true
  fi
  # Write (or clear, when empty) the [custom_theme] table so hunk's diff/syntax
  # colors match nvim's exactly. The builtin base is close on syntax but
  # its diff/chrome colors differ from the family's, which this block overrides.
  hunk_set_block "$cfg" "$custom"
  # No reload: hunk reads its config at launch, and the session daemon exposes
  # no config command. Running reviews keep their colors; the next one flips.
}

DELTA_THEME="$HOME/.config/delta/theme.gitconfig"

toml_string() { # <toml> <key> -> the top-level key's string value, empty when absent
  printf '%s\n' "$1" | sed -n "s/^$2 *= \"\(.*\)\"\$/\1/p"
}

delta_apply() { # <family> <mode> — write delta's include from the hunk diff palette
  local base custom
  base="$(hunk_theme "$1" "$2")"
  custom="$(hunk_custom_theme "$1" "$2" "$base")"

  local added_bg removed_bg added_word removed_word moved_added moved_removed
  local added_sign removed_sign line_number border text
  added_bg="$(toml_string "$custom" addedBg)"
  removed_bg="$(toml_string "$custom" removedBg)"
  added_word="$(toml_string "$custom" addedContentBg)"
  removed_word="$(toml_string "$custom" removedContentBg)"
  moved_added="$(toml_string "$custom" movedAddedBg)"
  moved_removed="$(toml_string "$custom" movedRemovedBg)"
  added_sign="$(toml_string "$custom" addedSignColor)"
  removed_sign="$(toml_string "$custom" removedSignColor)"
  line_number="$(toml_string "$custom" lineNumberFg)"
  border="$(toml_string "$custom" border)"
  text="$(toml_string "$custom" text)"

  mkdir -p "$(dirname "$DELTA_THEME")"
  cat >"$DELTA_THEME" <<EOF
# Written by theme-mode — do not edit. Colours are quoted: a bare # starts a comment.
[delta]
	$2 = true
EOF

  # A family whose hunk block is syntax-only keeps delta's own colours for the mode.
  if [ -z "$added_bg" ]; then
    return 0
  fi

  # git marks moved code bold magenta (from) and bold cyan (to); delta passes
  # those through raw unless mapped.
  cat >>"$DELTA_THEME" <<EOF
	minus-style = "syntax $removed_bg"
	minus-emph-style = "syntax $removed_word"
	plus-style = "syntax $added_bg"
	plus-emph-style = "syntax $added_word"
	map-styles = "bold purple => syntax $moved_removed, bold cyan => syntax $moved_added"
	line-numbers-minus-style = "$removed_sign"
	line-numbers-plus-style = "$added_sign"
	line-numbers-zero-style = "$line_number"
	line-numbers-left-style = "$border"
	line-numbers-right-style = "$border"
	file-style = "bold $text"
	file-decoration-style = "$border ul"
	hunk-header-decoration-style = "$border ul"
EOF
}

