#!/usr/bin/env bash
# log-review-finding — per-finding and per-run telemetry for every review gate.
#
# The `review_metrics` ledger type records one aggregate row per /review run: disposition
# counts, no per-finding detail. That answers "how loud was this run" and
# nothing else. Two questions it cannot answer:
#
#   - What did a gate catch that no other gate caught? (needs file:line)
#   - What is a gate's denominator? (needs the silent runs recorded too)
#
# This writer carries both. Two row kinds, discriminated by `kind`, sent through
# `ledger-write` as two ledger row types: `review_run` for kind=run and
# `review_finding` for kind=finding. Both are written whatever the metrics switch
# says, except under a caller's out= redirect (see below).
#
#   kind=run      one per GATE DISPATCH, including dispatches that found
#                 nothing. The silent runs are the denominator; a log that
#                 only records findings makes every gate look perfect.
#   kind=finding  one per finding that gate emitted, with file:line so rows
#                 join against each other and against the review_escape rows.
#
# usage: log-review-finding kind=run|finding key=value [key=value ...]
#
#   COMMON
#     repo=<basename>
#     branch=<git branch>
#     lane=eng-spec|code|verify|stage|test-audit|other|none
#     scope=phase|branch-exit|standalone
#       phase       gate ran at a /code phase boundary, on that phase's diff
#       branch-exit gate ran in a closing phase, on the whole-branch diff
#       standalone  direct invocation, no enclosing loop
#     phase=<index|name>          (omit it when scope is not `phase`; a "-" or empty value is dropped)
#     iter=<N>                    review-loop iteration this dispatch belongs to
#     gate=code-reviewer|smell-reviewer|smell-reviewer-deep
#         |security-reviewer|security-reviewer-deep|perf-reviewer
#         |perf-reviewer-deep|complexity-reviewer|complexity-reviewer-deep
#         |test-intent-reviewer|test-reviewer|plan-verifier|drift-gate|stage
#       The literal agent name dispatched, so the sonnet and opus tiers of the
#       same reviewer stay separable. Never collapse them.
#
#   kind=run ONLY
#     n_findings=<n>              0 for a silent run — the point of the row.
#       n_findings=null stores JSON null: the dispatch ran and its report
#       could not be counted. Never write 0 for a report that was not counted.
#     diff_loc=<n>                lines the gate actually read (git diff
#       --shortstat on its scope, insertions+deletions). Review-defect-detection
#       degrades with the size of the change under review, so a gate's yield is
#       uninterpretable without it. Measure it; do not estimate it.
#     diff_base=<ref>             in place of diff_loc: this script measures it, from
#       the merge-base of <ref> and HEAD to the working tree, untracked files
#       included. Refused with diff_loc, on a finding row, or for a ref git cannot
#       resolve. Never stored.
#     result=PASS|PASS WITH WARNINGS|NEEDS CHANGES|NOT DISPATCHED   (optional)
#       Case and -/_ spelling are normalized, and the words gates reach for when
#       none of the four fit are folded in: clean and intent-aligned are PASS,
#       findings, gaps and residue are NEEDS CHANGES. Anything else is passed to
#       `ledger write`, which stores it as `other`.
#
#   kind=finding ONLY
#     disposition=fix|ask|nit       what the reviewer said should happen
#     blocker=yes|no                (optional, `fix` only) advancing with it
#                                   in place ships the defect — set
#                                   automatically when fix_induced=bug
#     class=bug|smell|duplication|complexity|plan-drift|test-gap|weak-assertion
#          |security|perf|correctness|docs|other  (same vocabulary as review_escape,
#                                                  so the two logs cross-tabulate)
#       perf = query/IO cost (N+1, unbounded query, missing index, over-fetch,
#       serial awaits, per-item round-trip). perf-reviewer's findings go here,
#       never under `other` — under `other` they cannot be told apart from
#       anyone else's and the gate's recall is uncomputable.
#       docs = the prose is wrong about the code: a stale or misleading comment,
#       a rationale that cites the wrong quantity, a doc contradicting the
#       behaviour it describes, comment volume against the file's own cap. The
#       code may be correct — that is what separates it from `bug`.
#       other = last resort, and it is read as one. A run whose findings are
#       mostly `other` has told the analysis nothing about what the gate catches.
#     file=<path>                 repo-relative
#       file=unlocated: the finding names no file (a plan promise with no test).
#       The row is sent with no file and no line; refused with a line=.
#     line=<n>                    0 when the finding names no line
#       gate=test-intent-reviewer refuses a finding row with no file, or a file
#       and no line above 0: each of its findings names a test file:line, or is
#       file=unlocated.
#     actioned=fixed|skipped_fp|deferred|ask|none
#       fixed      code changed because of this finding
#       skipped_fp judged a false positive
#       deferred   real, moved to the branch-exit triage queue
#       ask        needs a human decision
#       none       not yet dispositioned
#     desc="one line"
#     fix_induced=yes|no|bug      (optional) the finding names code a previous
#       fix in this loop introduced, not code the coder originally wrote.
#       `bug` sets blocker=yes.
#     source=round|class|gate   (review-loop `fix` rows) where the finding came
#       from: a full review, an open class member at the round cap, or the
#       execution gate. Only class may defer. A code-reviewer `fix` row with
#       actioned=deferred at scope phase or standalone is refused without one.
#     ask_decided_by=user|session  (optional, ask outcome rows) who ruled on the ask:
#       the user, or the session itself when the repo hands ask decisions to it.
#       A ledger build that refuses the field gets the row without it.
#
# Every value is sent as a JSON string, except n_findings=null, which is sent as JSON null; `ledger write` types it. The row goes to
# `ledger write review_run|review_finding`, which adds the date, repo and session,
# keys `file=` and `branch=` into path_key and branch_key, and holds the deferred
# queue. desc, date, schema_version, repo, session, kind and out are accepted and
# never stored. A caller's out=<path> redirect is a metrics write: it happens only
# while the metrics switch is on (CLAUDE_TOOLKIT_TELEMETRY=1).
#
# Prints finding_id=<id> (run_id=<id> for a run row). The id is minted here unless
# the caller passes finding_id= or run_id=. A later row for the same finding_id
# supersedes the earlier one, so an ask outcome passes the id its ask row printed.
# An ask outcome (actioned=ask with ask_outcome=) with no finding_id writes nothing,
# prints one stderr line and exits 0. With no `ledger` on PATH `ledger-write` appends the
# row to ~/.claude/review-findings.jsonl (kind=finding or run), prints one stderr line
# and everything else runs as before. A row `ledger write` refuses exits 2.
#
# A row logged on a dirty tree carries snapshot=<sha>: a commit on HEAD of that tree, untracked
# files included, kept under refs/review-snapshots/<id>. A later row for the same id sends the
# commit its first row saved. The user's index and working tree are not touched. Snapshot refs
# older than 90 days are deleted when a new one is saved. A ledger build that refuses the field
# gets the row without it, and the ref is deleted.
set -euo pipefail

script_dir=$(dirname -- "${BASH_SOURCE[0]}")
# shellcheck source=../../scripts/lib/_kv.sh
source "$script_dir/../../scripts/lib/_kv.sh"
kv_help_exit "${BASH_SOURCE[0]}" "$@"

# --check as the first argument runs every validation below, writes nothing, ignores the
# telemetry switch and exits 0 when the arguments would be logged.
check_only=""
if [ "${1:-}" = "--check" ]; then
  check_only=1
  shift
fi

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

# The branch is read here, never trusted to the caller; a caller's own branch= still
# wins. head and dirty name the tree the gate saw.
head=$(git rev-parse HEAD 2>/dev/null || true)
dirty=""
[[ -n "$head" ]] && { [[ -n "$(git status --porcelain 2>/dev/null)" ]] && dirty=1 || dirty=0; }
json=$(jq -cn \
  --arg b "$(git branch --show-current 2>/dev/null || true)" \
  --arg h "$head" --arg d "$dirty" \
  '{}
   + (if $b != "" then {branch: $b} else {} end)
   + (if $h != "" then {head: $h, dirty: $d} else {} end)')

# Prints the tree of the working tree, untracked files included, built in a temp index seeded
# from the real one. The user's index is not touched.
working_tree_tree() {
  local real_index temp_index tree
  real_index=$(git rev-parse --git-path index) || return 1
  temp_index=$(mktemp) || return 1
  if [ -f "$real_index" ]; then cp -- "$real_index" "$temp_index"; else rm -f -- "$temp_index"; fi

  tree=$(GIT_INDEX_FILE=$temp_index git add -A && GIT_INDEX_FILE=$temp_index git write-tree) || tree=""
  rm -f -- "$temp_index"
  [ -n "$tree" ] || return 1
  printf '%s\n' "$tree"
}

# Prints insertions + deletions from the merge-base of $1 and HEAD to the working tree.
measure_diff_loc() {
  local merge_base tree
  merge_base=$(git merge-base "$1" HEAD 2>/dev/null) || return 1
  tree=$(working_tree_tree) || return 1

  git diff --numstat "$merge_base" "$tree" | awk '$1 != "-" { lines += $1 + $2 } END { print lines + 0 }'
}

swallowed_pair=$'[ \t\n\r\f\v][A-Za-z_][A-Za-z0-9_]*='

# kv_fold sends every value as a string; this hook handles these values itself.
# file=<path>: a path may hold spaces, so kv_fold's space refusal is off for it. It is
#   refused here when it holds a line break, or whitespace followed by name= (the shape
#   of a swallowed pair). A clean path is left to the default string fold.
# n_findings=null: a run whose report could not be counted; folded to JSON null, which
#   `ledger write` stores as SQL NULL, never 0.
# phase=- or an empty phase: no phase; the key is dropped, since phase is a token in
#   the registry and "-" or empty would be refused.
fold_writer_special_values() {
  if [ "$1" = file ]; then
    if [[ $2 == *$'\n'* || $2 == *$'\r'* || $2 =~ $swallowed_pair ]]; then
      echo "refusing to log: file= holds a line break or whitespace then a name=: '$2'" >&2
      echo "Quote each key=value separately; only desc= and result= (and a file= path with no line break and no whitespace then name=) may contain spaces." >&2
      exit 1
    fi
    return 1
  fi
  if [ "$1" = n_findings ] && [ "$2" = null ]; then
    json=$(jq -c '.n_findings = null' <<< "$json")
    return 0
  fi
  if [ "$1" = phase ] && { [ "$2" = "-" ] || [ -z "$2" ]; }; then
    return 0
  fi
  return 1
}

# Only desc, result and file are free text. A space in any other value means the caller
# quoted too much and swallowed the following key=value pairs into this one — which
# is how repo= ends up holding branch, lane, scope, phase and iter, destroying every
# join key /audit review needs. Fail loud.
kv_fold "desc result file" fold_writer_special_values "$@"
redirected=$kv_out_seen

kind=$(jq -r '.kind // ""' <<< "$json")
gate=$(jq -r '.gate // ""' <<< "$json")

case "$kind" in
  run|finding) ;;
  "") echo "refusing to log: kind=run|finding is required." >&2; exit 1 ;;
  *)  echo "refusing to log: kind=$kind is not run|finding" >&2; exit 1 ;;
esac

[ -n "$gate" ] || { echo "refusing to log: gate=<agent name> is required." >&2; exit 1; }

# The repo is not set here: `ledger write` derives it from the cwd, and names a
# linked worktree by its main checkout.

# `result` is the gate's verdict, reported as a distribution. It was collecting
# disposition words ("fix", "clean", "gaps", "actioned") instead — each one a
# bucket of size 1 reading as a verdict the reviewer never gave. Free text
# belongs in desc=.
#
# Rejecting outright loses the row, because telemetry never blocks the caller:
# the gates with no natural PASS/NEEDS CHANGES vocabulary (plan-verifier,
# test-intent-reviewer, test-reviewer) then log no run row at all and lose their
# denominator. So spelling and the known synonyms are folded in, and a value
# that maps to none goes to `ledger write` as given, which stores it as `other`.
if [ "$kind" = run ]; then
  res=$(jq -r '.result // ""' <<< "$json")
  norm=$(printf '%s' "$res" | tr '[:lower:]' '[:upper:]' | tr '_-' '  ')
  case "$norm" in
    "") mapped="" ;;
    "PASS WITH WARNINGS"* | "PASS (NITS ONLY)") mapped="PASS_WITH_WARNINGS" ;;
    PASS | CLEAN* | "INTENT ALIGNED") mapped="PASS" ;;
    "NEEDS CHANGES"* | FINDINGS | GAPS | "GAPS FOUND" | RESIDUE) mapped="NEEDS_CHANGES" ;;
    "NOT DISPATCHED"*) mapped="NOT_DISPATCHED" ;;
    *) mapped="$res" ;;
  esac
  if [ "$mapped" != "$res" ]; then
    [ -z "$mapped" ] || echo "note: result=$res logged as $mapped" >&2
    json=$(jq -c --arg r "$mapped" '.result = $r' <<< "$json")
  fi
fi

if [ "$kind" = finding ]; then
  # Only the literal 'bug' promotes the row to blocker=yes; any other
  # fix_induced value goes to `ledger write` as given.
  fi_val=$(jq -r '.fix_induced // ""' <<< "$json")
  [ "$fi_val" != bug ] || json=$(jq -c '.blocker = "yes"' <<< "$json")

  # The review loop sends every `fix` finding to a coder but an open class
  # member at the round cap. A deferred row goes to a branch-exit queue that most
  # branches never read, so a wrong deferral drops the finding.
  source=$(jq -r '.source // ""' <<< "$json")
  disposition=$(jq -r '.disposition // ""' <<< "$json")
  actioned=$(jq -r '.actioned // ""' <<< "$json")
  scope=$(jq -r '.scope // ""' <<< "$json")
  if [ "$disposition" = fix ] && [ "$actioned" = deferred ]; then
    loop_row=no
    [ "$gate" = code-reviewer ] && { [ "$scope" = phase ] || [ "$scope" = standalone ]; } && loop_row=yes
    if [ -n "$source" ] && [ "$source" != class ] \
      || { [ -z "$source" ] && [ "$loop_row" = yes ]; }; then
      echo "refusing to log: a review-loop fix finding defers only as an open class member at the" >&2
      echo "round cap (source=class). A full review's and the execution gate's fix findings get a" >&2
      echo "coder at any iter. Dispatch one, then log the row with actioned=fixed." >&2
      exit 1
    fi
  fi
fi

# A run row with no n_findings is the failure mode that silently destroys the
# denominator: it looks logged and counts as nothing.
if [ "$kind" = run ] && [ "$(jq -r 'has("n_findings")' <<< "$json")" != true ]; then
  echo "refusing to log: kind=run needs n_findings=<n> (0 for a silent run, null for an uncounted report)." >&2
  exit 1
fi

# A typed diff_loc is a guess at the size of the change the gate read; diff_base has it measured.
diff_base=$(jq -r '.diff_base // ""' <<< "$json")
if [ -n "$diff_base" ]; then
  [ "$kind" = run ] || { echo "refusing to log: diff_base= belongs on a kind=run row." >&2; exit 1; }
  if [ "$(jq -r 'has("diff_loc")' <<< "$json")" = true ]; then
    echo "refusing to log: pass diff_base=<ref> or diff_loc=<n>, not both." >&2
    exit 1
  fi
  if ! diff_loc=$(measure_diff_loc "$diff_base"); then
    echo "refusing to log: cannot measure diff_loc from diff_base=$diff_base (no merge-base with HEAD)." >&2
    exit 1
  fi
  json=$(jq -c --arg n "$diff_loc" 'del(.diff_base) | .diff_loc = $n' <<< "$json")
fi

# file=unlocated says the finding names no file; a guessed file would join it to the wrong code.
if [ "$kind" = finding ]; then
  file=$(jq -r '.file // ""' <<< "$json")
  line=$(jq -r '.line // ""' <<< "$json")
  if [ "$file" = unlocated ]; then
    [ -z "$line" ] || { echo "refusing to log: file=unlocated takes no line=." >&2; exit 1; }
    json=$(jq -c 'del(.file)' <<< "$json")
  elif [ "$gate" = test-intent-reviewer ] && { [ -z "$file" ] || ! [[ $line =~ ^[1-9][0-9]*$ ]]; }; then
    echo "refusing to log: a test-intent-reviewer finding names its test file= and line= (above 0), or is file=unlocated." >&2
    exit 1
  fi
fi

# An ask outcome supersedes its ask row by finding_id. Without one it would add a
# second finding to every count, so nothing is written. This runs before minting: a
# refused call mints no id and prints no finding_id=.
if [ "$kind" = finding ] \
  && [ "$(jq -r '.actioned // ""' <<< "$json")" = ask ] \
  && [ -n "$(jq -r '.ask_outcome // ""' <<< "$json")" ] \
  && [ -z "$(jq -r '.finding_id // ""' <<< "$json")" ]; then
  echo "log-review-finding: ask outcome without finding_id, not logged" >&2
  exit 0
fi

[ -z "$check_only" ] || exit 0

SNAPSHOT_REFS=refs/review-snapshots
SNAPSHOT_KEEP_DAYS=90
ledger_write="$script_dir/../../scripts/telemetry/ledger-write"

# Prints a commit on HEAD of the working tree.
save_snapshot() {
  local tree
  tree=$(working_tree_tree) || return 1

  git commit-tree "$tree" -p "$head" -m "review snapshot $id"
}

prune_snapshots() {
  local now cutoff
  now=$(date +%s)
  cutoff=$(( now - SNAPSHOT_KEEP_DAYS * 86400 ))
  git for-each-ref --format='%(committerdate:unix) %(refname)' "$SNAPSHOT_REFS/" \
    | awk -v cutoff="$cutoff" '$1 < cutoff { print "delete " $2 }' \
    | git update-ref --stdin
}

# Sends $1 to the ledger writer and keeps what it printed on stderr in writer_stderr.
send_row() {
  local rc=0
  { writer_stderr=$(printf '%s\n' "$1" | bash "$ledger_write" "review_$kind" 2>&1 >&3); } 3>&1 || rc=$?
  return "$rc"
}

id_key=run_id
[ "$kind" = finding ] && id_key=finding_id
id=$(jq -r --arg k "$id_key" '.[$k] // ""' <<< "$json")
if [ -z "$id" ]; then
  id=$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
  json=$(jq -c --arg k "$id_key" --arg v "$id" '.[$k] = $v' <<< "$json")
fi

if [ -n "$redirected" ] && ! "$script_dir/../../scripts/telemetry/telemetry_enabled.sh" 2>/dev/null; then
  echo "$id_key=$id"
  exit 0
fi

snapshot_ref="$SNAPSHOT_REFS/$id"
snapshot=$(git rev-parse -q --verify "$snapshot_ref^{commit}" 2>/dev/null || true)
if [ -z "$snapshot" ] && [ "$dirty" = 1 ]; then
  if snapshot=$(save_snapshot) && git update-ref "$snapshot_ref" "$snapshot"; then
    prune_snapshots
  else
    echo "log-review-finding: could not save the reviewed tree; the row is logged without snapshot" >&2
    snapshot=""
  fi
fi
[ -z "$snapshot" ] || json=$(jq -c --arg s "$snapshot" '.snapshot = $s' <<< "$json")

# desc is free text and never stored. file and branch go to the writer raw; it keys
# them (path_key, branch_key) and drops a dash or empty value. With no ledger, they are
# stored raw in the local jsonl file.
payload=$(jq -c '
  del(.desc, .kind)
  | with_entries(.key |= (if . == "file" then "path_key" elif . == "branch" then "branch_key" else . end))' <<< "$json")

write_rc=0
send_row "$payload" || write_rc=$?

# An older ledger build refuses a field it does not know. Drop each refused optional field and
# retry, so the row still lands. The writer names one field per refusal, so allow one retry per field.
for _retry in 1 2; do
  [ "$write_rc" -eq 2 ] || break
  refused_field=""
  for optional_field in snapshot ask_decided_by; do
    [[ $writer_stderr == *"field_unknown $optional_field"* ]] && refused_field=$optional_field
  done
  [ -n "$refused_field" ] || break
  [ "$refused_field" != snapshot ] || git update-ref -d "$snapshot_ref"
  echo "note: this ledger build does not store $refused_field; the row is logged without it" >&2
  payload=$(jq -c --arg f "$refused_field" 'del(.[$f])' <<< "$payload")
  write_rc=0
  send_row "$payload" || write_rc=$?
done

[ -z "$writer_stderr" ] || printf '%s\n' "$writer_stderr" >&2
[ "$write_rc" -eq 0 ] || exit "$write_rc"

echo "$id_key=$id"
