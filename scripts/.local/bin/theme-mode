#!/bin/bash
# theme-mode — single source of truth for the theme FAMILY and light/dark MODE
# across herdr + neovim + ghostty + claude code.
#
# State files (read by every consumer):
#   ~/.cache/theme-mode    dark|light
#   ~/.cache/theme-family  family name (see families() below)
#
# Consumers:
#   - nvim:    lua/config/theme-sync.lua polls both files (~1s) and applies
#              the family's colorscheme + overrides
#   - ghostty: this script writes ~/.config/ghostty/theme-switch.conf
#              (machine-local include, same pattern as local.conf), then
#              SIGUSR2s the running ghostty to reload it (1.2+; ctrl+shift+,
#              still works by hand). Only USR2 — any other signal crashes it.
#   - claude:  this script writes .theme (mode only) into ~/.claude/settings.json
#              via jq (correct key on Claude Code >= 2.1.119; older builds kept it
#              in ~/.claude.json). This sets the theme for the NEXT session — a
#              running session does NOT repaint live: Claude Code reloads the
#              settings value but never re-renders the TUI on a theme change, and
#              its `auto` OSC 11 detection only samples at launch (and the
#              multiplexer mangles it). No supported live-flip lever exists (see anthropics/claude-code
#              #33899); restart or run /theme by hand to see it in an open session.
#   - herdr:   this script regenerates the REAL ~/.config/herdr/config.toml from
#              the stowed ~/.config/herdr/config.toml.template (substituting the
#              __THEME_MODE_PALETTE__ marker with herdr_palette() below), then
#              runs `herdr server reload-config` so attached clients repaint
#              live. Same template contract as starship: the generated config is
#              machine-local, so a toggle never dirties the tracked file. herdr
#              has no include mechanism, so the WHOLE file is regenerated —
#              anything herdr writes to config.toml itself (e.g. `herdr config
#              reset-keys`) is overwritten on the next toggle. herdr's own
#              auto_switch is deliberately off: it keys off the terminal's
#              reported appearance rather than ~/.cache/theme-mode.
#   - starship: this script regenerates the REAL ~/.config/starship.toml from
#              the stowed ~/.config/starship.toml.template with the active
#              `palette =` line swapped to `<family>-<mode>` — a two-axis
#              swap, not mode-only. Starship has no include but re-reads its
#              config every prompt from that default path, so EVERY running
#              shell flips on its next prompt — no reload, no STARSHIP_CONFIG.
#              The generated file is machine-local (not stowed), so the
#              tracked template is never dirtied. Edit the template => re-run
#              theme-mode to refresh the live config.
#
# Usage:
#   theme-mode [dark|light|toggle]    flip mode, keep family (default: toggle)
#   theme-mode use <family> [mode]    switch family, keep mode unless given
#   theme-mode list                   known families
#   theme-mode status                 current family + mode
#
# Adding a family = five touchpoints, kept in sync by hand:
#   1. families() + ghostty_theme() below
#   2. FAMILIES table in nvim lua/config/theme-sync.lua
#   3. a ghostty theme (builtin name, or custom file in ghostty/themes/)
#   4. herdr_palette() below (herdr's [theme.custom] token block)
#   5. hunk_theme() below — pick the closest of hunk's builtins; a family with
#      no good match maps to nothing and hunk keeps whatever it had
#
# Also needed, not part of the six but easy to miss:
#   - starship.toml.template: add a `[palettes.<family>-dark]` /
#     `[palettes.<family>-light]` pair for the new family
#   - zsh/.zshrc: its fresh-machine bootstrap copies starship.toml.template
#     verbatim, so it must stay in sync with the template's default palette
#     name (this already caused one bug, fixed separately)
#   - DEFAULT_FAMILY must be kept in sync across three sites: this script's own
#     DEFAULT_FAMILY var, theme-sync.lua's default, and starship.toml.template's
#     root `palette =` line
set -euo pipefail

MODE_FILE="$HOME/.cache/theme-mode"
FAMILY_FILE="$HOME/.cache/theme-family"
GHOSTTY_SWITCH="$HOME/.config/ghostty/theme-switch.conf"
DEFAULT_FAMILY="flume"

families() { printf '%s\n' flexoki flume sequoia tempus gruvbox horizon; }

ghostty_theme() { # <family> <mode> -> ghostty theme name
  # flexoki's two are ghostty builtins (spaces and all), so no custom themes/
  # file — apply() writes `theme = <name>`. "Flexoki Light"/"Flexoki Dark" match
  # nvim's palette.
  case "$1:$2" in
    flexoki:light)     echo "Flexoki Light" ;;
    flexoki:*)         echo "Flexoki Dark" ;;
    # Not ghostty builtins — custom files in ghostty/themes/. apply() writes
    # `config-file`.
    # flume: mira dark / mesa light — custom files in ghostty/themes/.
    flume:light)        echo "flume-mesa" ;;
    flume:*)            echo "flume-mira" ;;
    # sequoia: night dark / rise light — custom files in ghostty/themes/.
    sequoia:light)      echo "sequoia-light" ;;
    sequoia:*)          echo "sequoia-dark" ;;
    # tempus: classic dark / day light — custom files in ghostty/themes/.
    tempus:light)       echo "tempus-light" ;;
    tempus:*)           echo "tempus-dark" ;;
    # gruvbox: material medium/mix dark / light — custom files in ghostty/themes/.
    gruvbox:light)      echo "gruvbox-light" ;;
    gruvbox:*)          echo "gruvbox-dark" ;;
    # horizon: dark #1c1e26 / light #fdf0ed — custom files in ghostty/themes/.
    horizon:light)      echo "horizon-light" ;;
    horizon:*)          echo "horizon-dark" ;;
  esac
}

hunk_theme() { # <family> <mode> -> the hunk BUILTIN a custom theme inherits from
  # hunk's [custom_theme] `base` inherits syntax (and any unset colours) from a
  # bundled theme; hunk_custom_theme() then overrides the diff/chrome colours on
  # top. This picks that base — the closest shipped theme for the family's
  # syntax. If a family sets no custom block, this id is used directly as
  # `theme =`. The ids live in the installed package's dist/npm/opentui/
  # themes.d.ts (`hunk diff --help` has no list). vitesse is the closest
  # warm/muted base for the scopes hunk_custom_theme does not override (nearly
  # none — it sets all 11 syntax slots + all diff/chrome colours per family).
  case "$1:$2" in
    flexoki:light)     echo "vitesse-light" ;;
    flexoki:*)         echo "vitesse-dark" ;;
    flume:light)        echo "vitesse-light" ;;
    flume:*)            echo "vitesse-dark" ;;
    sequoia:light)      echo "vitesse-light" ;;
    sequoia:*)          echo "vitesse-dark" ;;
    tempus:light)       echo "vitesse-light" ;;
    tempus:*)           echo "vitesse-dark" ;;
    gruvbox:light)      echo "vitesse-light" ;;
    gruvbox:*)          echo "vitesse-dark" ;;
    horizon:light)      echo "vitesse-light" ;;
    horizon:*)          echo "vitesse-dark" ;;
  esac
}

# theme-mode owns exactly this delimited block inside hunk's self-written
# config.toml; hunk_set_block strips only what is between the markers, never
# hunk's own keys/tables.
HUNK_BLOCK_BEGIN="# >>> theme-mode custom_theme (do not edit inside markers)"
HUNK_BLOCK_END="# <<< theme-mode custom_theme"

hunk_custom_theme() { # <family> <mode> <base> -> a [custom_theme] TOML table, or nothing
  # Overrides hunk's diff line/sign/syntax colours to the EXACT values nvim
  # paints under this family, since no bundled hunk theme reproduces them. Diff
  # backgrounds are the family accent blended subtly over its panel bg (readable
  # full-line washes, not a solid-accent wall). `base` above supplies uncovered
  # scopes; keys here (camelCase, matching hunk's CUSTOM_THEME_COLOR_KEYS) win
  # over it. comment is the same contrast-lifted grey nvim uses per family.
  # Syntax is emitted as [custom_theme.syntax_scopes] (TextMate selectors); the
  # 11 named roles below expand to the scope sets in the table at the bottom.
  local bg panel panelAlt border accent accentMuted text muted addedBg removedBg
  local ctxBg sAdd sRem lnFg badgeAdd badgeRem badgeNeu fRename fMod fUntracked note
  local kw str num fn typ punct op
  case "$1:$2" in
    flexoki:light)
      # flexoki light (dawn): paper #fffcf0 canvas. Diff bgs are the accent
      # blended ~12% over base-50 #f2f0e5 (subtle, readable full-line washes —
      # not flexoki's solid-accent DiffAdd, which is a wall in a diff viewer).
      # comment is the contrast-lifted grey nvim uses (base-600 #6f6e69 ~4.9:1).
      bg="#fffcf0"; panel="#f2f0e5"; panelAlt="#e6e4d9"; border="#cecdc3"
      accent="#5e409d"; accentMuted="#b7b5ac"; text="#403e3c"; muted="#6f6e69"
      addedBg="#e1e2cb"; removedBg="#ead9ce"; ctxBg="#fffcf0"
      sAdd="#66800b"; sRem="#af3029"; lnFg="#b7b5ac"
      badgeAdd="#66800b"; badgeRem="#af3029"; badgeNeu="#205ea6"
      fRename="#5e409d"; fMod="#ad8301"; fUntracked="#878580"; note="#f2f0e5"
      # flexoki accents: keyword magenta, string green, number orange, fn blue,
      # type cyan; identifiers/operators stay neutral tx (#403e3c).
      kw="#a02f6f"; str="#66800b"; num="#bc5215"; fn="#205ea6"; typ="#24837b"; punct="#878580"; op="#403e3c"
      ;;
    flexoki:*)
      # flexoki dark (moon): black #100f0f canvas. Diff bgs are the accent
      # blended ~12% over base-950 #1c1b1a. comment is base-500 #878580 (~5.3:1).
      bg="#100f0f"; panel="#1c1b1a"; panelAlt="#282726"; border="#403e3c"
      accent="#8b7ec8"; accentMuted="#575653"; text="#cecdc3"; muted="#878580"
      addedBg="#292a1e"; removedBg="#32211f"; ctxBg="#100f0f"
      sAdd="#879a39"; sRem="#d14d41"; lnFg="#575653"
      badgeAdd="#879a39"; badgeRem="#d14d41"; badgeNeu="#4385be"
      fRename="#8b7ec8"; fMod="#d0a215"; fUntracked="#878580"; note="#1c1b1a"
      # flexoki accents: keyword magenta, string green, number orange, fn blue,
      # type cyan; identifiers/operators stay neutral tx (#cecdc3).
      kw="#ce5d97"; str="#879a39"; num="#da702c"; fn="#4385be"; typ="#3aa99f"; punct="#878580"; op="#cecdc3"
      ;;
    flume:light)
      # flume mesa (warm cream #f3ede8) — the family's light half. comment
      # #706878 (~5:1 on paper).
      bg="#f3ede8"; panel="#ece5df"; panelAlt="#ddd6e0"; border="#c8c0ca"
      accent="#3f7180"; accentMuted="#d3ccd5"; text="#413b49"; muted="#706878"
      addedBg="#e0e8dc"; removedBg="#eadadd"; ctxBg="#f3ede8"
      sAdd="#557245"; sRem="#934d5b"; lnFg="#a39ba8"
      badgeAdd="#557245"; badgeRem="#934d5b"; badgeNeu="#3f7180"
      fRename="#72518f"; fMod="#815f1d"; fUntracked="#706878"; note="#ece5df"
      # flume roles: keyword purple, string green, number/boolean rust, fn teal,
      # type yellow, operator neutral text.
      kw="#72518f"; str="#557245"; num="#9b5146"; fn="#3f7180"; typ="#815f1d"; punct="#625b69"; op="#413b49"
      ;;
    flume:*)
      # flume mira (violet-charcoal #24212f) — the family's dark half. comment
      # lifted to #a29bb0 (~5.5:1; stock #918a9a ~4.7:1).
      bg="#24212f"; panel="#292634"; panelAlt="#353142"; border="#4b485a"
      accent="#72b5bf"; accentMuted="#596073"; text="#d9d4df"; muted="#a29bb0"
      addedBg="#2a3735"; removedBg="#402a35"; ctxBg="#24212f"
      sAdd="#84b39f"; sRem="#dd789b"; lnFg="#5b6070"
      badgeAdd="#84b39f"; badgeRem="#dd789b"; badgeNeu="#72a8c7"
      fRename="#b69bd2"; fMod="#d8a36b"; fUntracked="#a29bb0"; note="#292634"
      # flume roles: keyword purple, string green, number/boolean rust, fn cyan
      # accent, type yellow, operator neutral text.
      kw="#b69bd2"; str="#84b39f"; num="#e49a7b"; fn="#72b5bf"; typ="#d8a36b"; punct="#9d96aa"; op="#d9d4df"
      ;;
    sequoia:light)
      # sequoia rise (warm cream #ede9e4). comment lifted from stock subtle
      # #8a8880 (~2.8:1) to #625f58 (~4.6:1). red kept muted (no amplify).
      bg="#ede9e4"; panel="#e3e0da"; panelAlt="#d5d2cc"; border="#cac7c1"
      accent="#a85080"; accentMuted="#cac7c1"; text="#2c2c2a"; muted="#625f58"
      addedBg="#dde6d5"; removedBg="#eeddd6"; ctxBg="#ede9e4"
      sAdd="#488828"; sRem="#c03838"; lnFg="#b0ada6"
      badgeAdd="#488828"; badgeRem="#c03838"; badgeNeu="#3868a8"
      fRename="#a85080"; fMod="#9a7828"; fUntracked="#625f58"; note="#e3e0da"
      # sequoia roles: keyword pink (lily), string green, number orange (honey),
      # fn blue (denim), type teal (baja), operator neutral fg.
      kw="#a85080"; str="#488828"; num="#a86828"; fn="#3868a8"; typ="#2a8868"; punct="#625f58"; op="#2c2c2a"
      ;;
    sequoia:*)
      # sequoia night (neutral #141414). comment lifted from stock subtle
      # #5d5d5d (~2.8:1) to #808080 (~4.6:1). red #c05050 used as-is, not
      # brightened — saturated red reads rough.
      bg="#141414"; panel="#1a1a1a"; panelAlt="#242424"; border="#2d2d2d"
      accent="#b080b0"; accentMuted="#5d5d5d"; text="#b0b0b5"; muted="#808080"
      addedBg="#1a231a"; removedBg="#2a1c1c"; ctxBg="#141414"
      sAdd="#90a870"; sRem="#c05050"; lnFg="#5d5d5d"
      badgeAdd="#90a870"; badgeRem="#c05050"; badgeNeu="#6a9dcc"
      fRename="#b080b0"; fMod="#c09070"; fUntracked="#808080"; note="#1a1a1a"
      # sequoia roles: keyword pink (lily), string green, number orange (honey),
      # fn blue (denim), type teal (baja), operator neutral fg.
      kw="#b080b0"; str="#90a870"; num="#c09070"; fn="#6a9dcc"; typ="#6aab9a"; punct="#808080"; op="#b0b0b5"
      ;;
    tempus:light)
      # tempus day (Prot's WCAG-tuned warm-cream light #f8f2e5). comment = fgalt
      # #68607d. Diff bgs are washes over bgalt #e7e3d7. red softened to brick
      # #a3352a (stock col1 #c81000 is high-saturation red).
      bg="#f8f2e5"; panel="#e7e3d7"; panelAlt="#dcd7c9"; border="#d0cbba"
      accent="#8050a7"; accentMuted="#d0cbba"; text="#464340"; muted="#68607d"
      addedBg="#dde7cf"; removedBg="#f0e0cf"; ctxBg="#f8f2e5"
      sAdd="#107410"; sRem="#a3352a"; lnFg="#b0a99a"
      badgeAdd="#107410"; badgeRem="#a3352a"; badgeNeu="#385dc4"
      fRename="#8050a7"; fMod="#806000"; fUntracked="#68607d"; note="#e7e3d7"
      # tempus roles: keyword purple, string blue, number rust-orange, fn rose,
      # type teal, operator neutral fg.
      kw="#8050a7"; str="#0f64c4"; num="#b24000"; fn="#b63052"; typ="#007070"; punct="#68607d"; op="#464340"
      ;;
    tempus:*)
      # tempus classic (Prot's WCAG-tuned dark #232323). Palette already legible;
      # comment = fgalt #949d9f. Diff bgs are washes over bgalt #312e30.
      bg="#232323"; panel="#312e30"; panelAlt="#3a3739"; border="#444142"
      accent="#d58888"; accentMuted="#6b6868"; text="#aeadaf"; muted="#949d9f"
      addedBg="#283026"; removedBg="#332a24"; ctxBg="#232323"
      sAdd="#8c9e3d"; sRem="#d4823d"; lnFg="#6b6868"
      badgeAdd="#8c9e3d"; badgeRem="#d4823d"; badgeNeu="#6e9cb0"
      fRename="#d58888"; fMod="#b1942b"; fUntracked="#949d9f"; note="#312e30"
      # tempus roles: keyword pink, string blue, number blue, fn warm-rose,
      # type green, operator neutral fg.
      kw="#d58888"; str="#8e9cc0"; num="#6e9cb0"; fn="#b58d88"; typ="#6da280"; punct="#949d9f"; op="#aeadaf"
      ;;
    gruvbox:light)
      # gruvbox-material medium/mix light (#fbf1c7). Verbatim upstream — no mods.
      # comment #928374. Diff washes over bg1 #eee0b7.
      bg="#fbf1c7"; panel="#eee0b7"; panelAlt="#ddccab"; border="#ddcca0"
      accent="#af2528"; accentMuted="#ddcca0"; text="#514036"; muted="#928374"
      addedBg="#e6e6c0"; removedBg="#f2dcc0"; ctxBg="#fbf1c7"
      sAdd="#72761e"; sRem="#af2528"; lnFg="#a89984"
      badgeAdd="#72761e"; badgeRem="#af2528"; badgeNeu="#266b79"
      fRename="#924f79"; fMod="#b4730e"; fUntracked="#928374"; note="#eee0b7"
      # gruvbox roles: keyword red, string/fn green, number purple, type orange,
      # const aqua, operator fg.
      kw="#af2528"; str="#72761e"; num="#924f79"; fn="#72761e"; typ="#b4730e"; punct="#514036"; op="#514036"
      ;;
    gruvbox:*)
      # gruvbox-material medium/mix dark (#282828). Verbatim upstream — no mods
      # (keyword red #f2594b kept as authored). comment #928374. Diff washes
      # over bg1 #32302f.
      bg="#282828"; panel="#32302f"; panelAlt="#3c3836"; border="#45403d"
      accent="#f2594b"; accentMuted="#504945"; text="#e2cca9"; muted="#928374"
      addedBg="#282d1e"; removedBg="#32241f"; ctxBg="#282828"
      sAdd="#b0b846"; sRem="#f2594b"; lnFg="#504945"
      badgeAdd="#b0b846"; badgeRem="#f2594b"; badgeNeu="#80aa9e"
      fRename="#d3869b"; fMod="#e9b143"; fUntracked="#928374"; note="#32302f"
      # gruvbox roles: keyword red, string/fn green, number pink, type yellow,
      # const aqua, operator fg.
      kw="#f2594b"; str="#b0b846"; num="#d3869b"; fn="#b0b846"; typ="#e9b143"; punct="#e2cca9"; op="#e2cca9"
      ;;
    horizon:light)
      # horizon.nvim light (#fdf0ed). comment lifted to #6e6664. Diff washes use
      # the theme's own diff bgs.
      bg="#fdf0ed"; panel="#fadad1"; panelAlt="#f9cbbe"; border="#f9cec3"
      accent="#8a31b9"; accentMuted="#f9cec3"; text="#06060c"; muted="#6e6664"
      addedBg="#e4eee3"; removedBg="#fcdedf"; ctxBg="#fdf0ed"
      sAdd="#178f6a"; sRem="#da103f"; lnFg="#989290"
      badgeAdd="#178f6a"; badgeRem="#da103f"; badgeNeu="#1d8991"
      fRename="#8a31b9"; fMod="#af5427"; fUntracked="#1eb980"; note="#fadad1"
      # horizon light roles: keyword amethyst, string tango, number thunderbird,
      # func elm, type jaffa.
      kw="#8a31b9"; str="#f6661e"; num="#dc3318"; fn="#1d8991"; typ="#f77d26"; punct="#333333"; op="#333333"
      ;;
    horizon:*)
      # horizon.nvim dark (#1c1e26). comment lifted to #6c6f93. Diff washes use
      # the theme's own diff bgs.
      bg="#1c1e26"; panel="#232530"; panelAlt="#2e303e"; border="#1a1c23"
      accent="#a86ec9"; accentMuted="#6c6f93"; text="#bbbbbb"; muted="#6c6f93"
      addedBg="#1a3432"; removedBg="#4a2024"; ctxBg="#1c1e26"
      sAdd="#0fb67b"; sRem="#b3344c"; lnFg="#4c4d53"
      badgeAdd="#0fb67b"; badgeRem="#b3344c"; badgeNeu="#26bbd9"
      fRename="#a86ec9"; fMod="#fab38e"; fUntracked="#27d797"; note="#232530"
      # horizon dark roles: keyword purple, string tan, number apricot, func
      # turquoise, type sand.
      kw="#a86ec9"; str="#e4a88a"; num="#f09483"; fn="#24a1ad"; typ="#e4b28e"; punct="#bbbbbb"; op="#bbbbbb"
      ;;
    *) return 0 ;;
  esac
  cat <<EOF
[custom_theme]
base             = "$3"
background       = "$bg"
panel            = "$panel"
panelAlt         = "$panelAlt"
border           = "$border"
accent           = "$accent"
accentMuted      = "$accentMuted"
text             = "$text"
muted            = "$muted"
addedBg          = "$addedBg"
removedBg        = "$removedBg"
movedAddedBg     = "$addedBg"
movedRemovedBg   = "$removedBg"
contextBg        = "$ctxBg"
addedContentBg   = "$addedBg"
removedContentBg = "$removedBg"
contextContentBg = "$ctxBg"
addedSignColor   = "$sAdd"
removedSignColor = "$sRem"
lineNumberBg     = "$ctxBg"
lineNumberFg     = "$lnFg"
selectedHunk     = "$border"
badgeAdded       = "$badgeAdd"
badgeRemoved     = "$badgeRem"
badgeNeutral     = "$badgeNeu"
fileNew          = "$sAdd"
fileDeleted      = "$sRem"
fileRenamed      = "$fRename"
fileModified     = "$fMod"
fileUntracked    = "$fUntracked"
noteBorder       = "$border"
noteBackground   = "$note"
noteTitleBackground = "$border"
noteTitleText    = "$text"

# Syntax scopes — the active family's palette, so hunk's code body reads
# identically to nvim's, not the base builtin above (which it overrides).
# TextMate selectors (the named-role [custom_theme.syntax] block is
# deprecated); scope sets mirror hunk's own legacy role->scope translation.
[custom_theme.syntax_scopes]
"source"                            = "$text"
"keyword"                           = "$kw"
"keyword.operator"                  = "$op"
"string"                            = "$str"
"comment"                           = "$muted"
"punctuation.definition.comment"    = "$muted"
"constant.numeric"                  = "$num"
"entity.name.function"              = "$fn"
"support.function"                  = "$fn"
"variable.function"                 = "$fn"
"entity.name.type"                  = "$typ"
"entity.name.class"                 = "$typ"
"support.type"                      = "$typ"
"support.class"                     = "$typ"
"variable"                          = "$text"
"variable.other.property"           = "$text"
"support.variable.property"         = "$text"
"punctuation"                       = "$punct"
EOF
}

hunk_set_block() { # <file> <block-or-empty> — replace theme-mode's marked block
  # Drops any prior marked block (markers inclusive), then appends the fresh one
  # at EOF. Empty content just clears it (the builtin path). The [custom_theme]
  # table lands after hunk's bare keys, keeping the same "tables sort last"
  # invariant hunk_set relies on.
  local file="$1" content="$2" tmp
  tmp="$(mktemp)"
  awk -v b="$HUNK_BLOCK_BEGIN" -v e="$HUNK_BLOCK_END" '
    $0 == b { skip = 1; next } $0 == e { skip = 0; next } !skip { print }
  ' "$file" >"$tmp"
  if [ -n "$content" ]; then
    { echo "$HUNK_BLOCK_BEGIN"; printf '%s\n' "$content"; echo "$HUNK_BLOCK_END"; } >>"$tmp"
  fi
  mv "$tmp" "$file"
}

hunk_set() { # <file> <key> <toml-value> — set a top-level key, preserving the rest
  # Anchored so it only ever touches the top-level key, never a same-named key
  # inside one of hunk's tables ([vcs], [pager], [custom_theme], ...). Those
  # tables all sort after the bare keys hunk writes, so appending stays legal
  # TOML: a new key added below a table header would silently join that table.
  local file="$1" key="$2" value="$3"
  if grep -q "^$key = " "$file" 2>/dev/null; then
    sed -i.bak "s|^$key = .*|$key = $value|" "$file" && rm -f "$file.bak"
  elif grep -q '^\[' "$file" 2>/dev/null; then
    sed -i.bak "1i\\
$key = $value" "$file" && rm -f "$file.bak"
  else
    printf '%s = %s\n' "$key" "$value" >>"$file"
  fi
}

hunk_apply() { # <family> <mode> — point hunk's config at the family's theme
  local base custom cfg
  base="$(hunk_theme "$1" "$2")"
  cfg="$HOME/.config/hunk/config.toml"
  # No template here, unlike herdr/starship: hunk WRITES this file itself
  # (the in-app View menu persists theme, wrap, line numbers and more), so
  # regenerating it would silently drop the user's other preferences. Set only
  # the keys this script owns, and create the file when there is none.
  mkdir -p "$(dirname "$cfg")"
  [ -f "$cfg" ] || : >"$cfg"

  # A family with a custom block selects theme="custom" and inherits syntax from
  # `base`; one without falls back to the plain builtin. Set the bare keys before
  # appending the [custom_theme] table so they stay above it (bare keys first).
  custom="$(hunk_custom_theme "$1" "$2" "$base")"
  if [ -n "$custom" ]; then
    hunk_set "$cfg" theme '"custom"'
  elif [ -n "$base" ]; then
    hunk_set "$cfg" theme "\"$base\""
  else
    return 0
  fi
  # Without this, hunk paints its chrome with the builtin's own background,
  # which sits a step off the terminal's in dark mode and reads as a gray box
  # inside the black. Letting the terminal show through matches whatever
  # ghostty/herdr already painted, in both modes, with no second palette to
  # keep in sync.
  hunk_set "$cfg" transparent_background true
  # Write (or clear, when empty) the [custom_theme] table so hunk's diff/syntax
  # colors match nvim's exactly. The builtin vitesse base is close on syntax but
  # its diff/chrome colors differ from the family's, which this block overrides.
  hunk_set_block "$cfg" "$custom"
  # No reload: hunk reads its config at launch, and the session daemon exposes
  # no config command. Running reviews keep their colors; the next one flips.
}

herdr_palette() { # <family> <mode> -> the [theme] + [theme.custom] TOML block
  # herdr's token namespace is catppuccin-derived; `name` picks the BASE theme
  # and [theme.custom] overrides individual tokens on top of it. Dark uses the
  # one-dark base, light the one-light base, so any token not listed here keeps
  # a sensible light/dark default rather than a fixed dark one.
  local base_name accent panel_bg surface_dim surface0 surface1 overlay0 overlay1
  local text subtext0 green yellow red blue teal peach
  case "$1:$2" in
    flexoki:light)
      # flexoki light (dawn), paper #fffcf0 — matches nvim/ghostty. Muted greys
      # collapse to base-600 #6f6e69 (~4.9:1 on paper); overlay0 is a muted
      # FOREGROUND so it stays darker than the backgrounds. peach = orange-600.
      base_name="one-light"
      accent="#5e409d" panel_bg="#f2f0e5" surface_dim="#dad8ce"
      surface0="#cecdc3" surface1="#b7b5ac"
      overlay0="#6f6e69" overlay1="#6f6e69"
      text="#100f0f" subtext0="#6f6e69"
      green="#66800b" yellow="#ad8301" red="#af3029"
      blue="#205ea6" teal="#205ea6" peach="#bc5215"
      ;;
    flexoki:*)
      # flexoki dark (moon), black #100f0f — matches nvim/ghostty. overlay1/
      # subtext0 is base-500 #878580 (comment lifted to ~5.3:1); peach = the
      # distinct orange-400 rather than duplicating yellow.
      base_name="one-dark"
      accent="#8b7ec8" panel_bg="#1c1b1a" surface_dim="#343331"
      surface0="#403e3c" surface1="#575653"
      overlay0="#575653" overlay1="#878580"
      text="#cecdc3" subtext0="#878580"
      green="#879a39" yellow="#d0a215" red="#d14d41"
      blue="#4385be" teal="#4385be" peach="#da702c"
      ;;
    flume:light)
      # flume mesa (warm cream #f3ede8) — comment #706878 (~5:1 on paper).
      base_name="one-light"
      accent="#3f7180" panel_bg="#ece5df" surface_dim="#ddd6e0"
      surface0="#d0c8ce" surface1="#c8c0ca"
      overlay0="#706878" overlay1="#706878"
      text="#413b49" subtext0="#706878"
      green="#557245" yellow="#815f1d" red="#934d5b"
      blue="#3f7180" teal="#356f80" peach="#9b5146"
      ;;
    flume:*)
      # flume mira (violet-charcoal #24212f) — comment lifted to #a29bb0.
      base_name="one-dark"
      accent="#72b5bf" panel_bg="#292634" surface_dim="#323043"
      surface0="#353142" surface1="#4b485a"
      overlay0="#5b6070" overlay1="#a29bb0"
      text="#d9d4df" subtext0="#a29bb0"
      green="#84b39f" yellow="#d8a36b" red="#dd789b"
      blue="#72a8c7" teal="#8ac8cf" peach="#e49a7b"
      ;;
    sequoia:light)
      # sequoia rise (warm cream #ede9e4) — comment lifted to #625f58 (~4.6:1).
      base_name="one-light"
      accent="#a85080" panel_bg="#e3e0da" surface_dim="#d5d2cc"
      surface0="#cac7c1" surface1="#bcb9b3"
      overlay0="#625f58" overlay1="#625f58"
      text="#2c2c2a" subtext0="#625f58"
      green="#488828" yellow="#9a7828" red="#c03838"
      blue="#3868a8" teal="#2a8868" peach="#a86828"
      ;;
    sequoia:*)
      # sequoia night (neutral #141414) — comment lifted to #808080 (~4.6:1).
      base_name="one-dark"
      accent="#b080b0" panel_bg="#1a1a1a" surface_dim="#242424"
      surface0="#2d2d2d" surface1="#383838"
      overlay0="#5d5d5d" overlay1="#808080"
      text="#b0b0b5" subtext0="#808080"
      green="#90a870" yellow="#bfa878" red="#c05050"
      blue="#6a9dcc" teal="#6aab9a" peach="#c09070"
      ;;
    tempus:light)
      # tempus day (Prot WCAG-tuned warm-cream #f8f2e5) — comment = fgalt #68607d.
      base_name="one-light"
      accent="#8050a7" panel_bg="#e7e3d7" surface_dim="#dcd7c9"
      surface0="#d0cbba" surface1="#c4bfae"
      overlay0="#68607d" overlay1="#68607d"
      text="#464340" subtext0="#68607d"
      green="#107410" yellow="#806000" red="#a3352a"
      blue="#385dc4" teal="#007070" peach="#b24000"
      ;;
    tempus:*)
      # tempus classic (Prot WCAG-tuned dark #232323) — comment = fgalt #949d9f.
      base_name="one-dark"
      accent="#d58888" panel_bg="#312e30" surface_dim="#3a3739"
      surface0="#444142" surface1="#4e4b4c"
      overlay0="#6b6868" overlay1="#949d9f"
      text="#aeadaf" subtext0="#949d9f"
      green="#8c9e3d" yellow="#b1942b" red="#d4823d"
      blue="#6e9cb0" teal="#6da280" peach="#d0913d"
      ;;
    gruvbox:light)
      # gruvbox-material medium/mix light (#fbf1c7) — comment #928374. Verbatim.
      base_name="one-light"
      accent="#af2528" panel_bg="#eee0b7" surface_dim="#ddccab"
      surface0="#e6d5a8" surface1="#ddcca0"
      overlay0="#928374" overlay1="#928374"
      text="#514036" subtext0="#928374"
      green="#72761e" yellow="#b4730e" red="#af2528"
      blue="#266b79" teal="#477a5b" peach="#b4730e"
      ;;
    gruvbox:*)
      # gruvbox-material medium/mix dark (#282828) — comment #928374. Verbatim,
      # keyword red #f2594b kept as authored.
      base_name="one-dark"
      accent="#f2594b" panel_bg="#32302f" surface_dim="#3c3836"
      surface0="#45403d" surface1="#504945"
      overlay0="#7c6f64" overlay1="#928374"
      text="#e2cca9" subtext0="#928374"
      green="#b0b846" yellow="#e9b143" red="#f2594b"
      blue="#80aa9e" teal="#8bba7f" peach="#e9b143"
      ;;
    horizon:light)
      # horizon.nvim light (#fdf0ed) — comment lifted to #6e6664.
      base_name="one-light"
      accent="#8a31b9" panel_bg="#fadad1" surface_dim="#f7d3c9"
      surface0="#f9cbbe" surface1="#f4bdb0"
      overlay0="#8e8886" overlay1="#6e6664"
      text="#06060c" subtext0="#6e6664"
      green="#178f6a" yellow="#af5427" red="#da103f"
      blue="#1d8991" teal="#1eaeae" peach="#f6661e"
      ;;
    horizon:*)
      # horizon.nvim dark (#1c1e26) — comment lifted to #6c6f93.
      base_name="one-dark"
      accent="#a86ec9" panel_bg="#232530" surface_dim="#2a2c38"
      surface0="#2e303e" surface1="#3d3f52"
      overlay0="#5b5f78" overlay1="#6c6f93"
      text="#bbbbbb" subtext0="#6c6f93"
      green="#29d398" yellow="#fab795" red="#e95678"
      blue="#26bbd9" teal="#59e1e3" peach="#f09483"
      ;;
  esac

  # Sidebar focus contrast — deviations from the stock family values above:
  #   surface_dim = the FOCUSED agent/workspace row's background bar. At the
  #     stock canvas value it sat ~1.05:1 against panel_bg, so the focused row
  #     read as unmarked. Both modes push it clear of panel_bg instead. It also
  #     tints inactive pane borders, scrollbar tracks, and sidebar separators.
  #   surface0 = nav-mode selection bg; kept a step above surface_dim so
  #     selection still outranks focus. surface1 = drag.
  #   text/subtext0 = focused vs unfocused agent name. Dark widens the gap;
  #     light leaves subtext0 at the 4.5:1 floor documented above.
  #   overlay0 = NOT a border color despite the name — herdr uses it as the
  #     muted FOREGROUND for sidebar chrome (the "spaces"/"agents" headers, the
  #     sort label, new/menu, the per-row agent name, inactive tab labels,
  #     scrollbar thumbs), much of it DIM on top. So light needs it DARKER than
  #     panel_bg, not lighter; a border-grey there erases the whole sidebar.
  #     Keep it between overlay1/subtext0 and the backgrounds on both sides.
  cat <<EOF
[theme]
name = "$base_name"
auto_switch = false

[theme.custom]
accent      = "$accent"
panel_bg    = "$panel_bg"
surface_dim = "$surface_dim"
surface0    = "$surface0"
surface1    = "$surface1"
overlay0    = "$overlay0"
overlay1    = "$overlay1"
text        = "$text"
subtext0    = "$subtext0"
mauve       = "$accent"
green       = "$green"
yellow      = "$yellow"
red         = "$red"
blue        = "$blue"
teal        = "$teal"
peach       = "$peach"
EOF
}

herdr_apply() { # <family> <mode> — regenerate the live config, reload the server
  local tmpl="$HOME/.config/herdr/config.toml.template"
  local cfg="$HOME/.config/herdr/config.toml"
  [ -f "$tmpl" ] || return 0

  # Same contract as starship: the stowed file is the TEMPLATE and the real
  # config is machine-local, so toggling never dirties the tracked file. herdr
  # has no include mechanism, hence full regeneration rather than a fragment.
  local tmp palette_file
  tmp="$(mktemp)"
  palette_file="$(mktemp)"
  herdr_palette "$1" "$2" >"$palette_file"
  # awk, not sed: the palette is multi-line and contains #/& which sed's
  # replacement would mangle. The block is read from a FILE via getline, not
  # passed with -v: macOS's awk rejects a newline inside a -v assignment
  # ("newline in string"), which silently left the mac with no config.toml at
  # all while gawk/mawk on Linux accepted it.
  awk -v pf="$palette_file" '
    /^# __THEME_MODE_PALETTE__$/ {
      while ((getline line < pf) > 0) print line
      close(pf); next
    }
    { print }
  ' "$tmpl" >"$tmp" && mv "$tmp" "$cfg" || { rm -f "$tmp" "$palette_file"; return 0; }
  rm -f "$palette_file"

  # No-op (non-zero, swallowed) when no server is running.
  command -v herdr >/dev/null 2>&1 && herdr server reload-config >/dev/null 2>&1 || true
}

current_mode() { cat "$MODE_FILE" 2>/dev/null | tr -d '[:space:]'; }
current_family() {
  local f
  f="$(cat "$FAMILY_FILE" 2>/dev/null | tr -d '[:space:]')"
  families | grep -qx "$f" && echo "$f" || echo "$DEFAULT_FAMILY"
}

apply() { # <family> <mode> — write state and repaint herdr + ghostty
  local family="$1" mode="$2"
  mkdir -p "$(dirname "$MODE_FILE")"
  printf '%s\n' "$mode" >"$MODE_FILE"     # nvim picks these up
  printf '%s\n' "$family" >"$FAMILY_FILE" # via its own watcher

  # ghostty: machine-local include; wins over the fallback `theme =` line
  # because config-file includes are processed after the main config.
  #
  # Custom themes are pulled in by ABSOLUTE PATH, not by name. `theme = <name>`
  # resolves against a themes/ dir inside whatever ghostty considers its config
  # directory — on macOS that's ~/Library/Application Support/com.mitchellh.ghostty/,
  # NOT the stowed ~/.config/ghostty/, so every custom theme 404s there while
  # builtins keep working. A theme file is just a config fragment (palette /
  # background / foreground), so config-file loads it identically on any
  # platform. Builtins have no file on disk and still go through `theme =`.
  mkdir -p "$(dirname "$GHOSTTY_SWITCH")"
  local theme custom
  theme="$(ghostty_theme "$family" "$mode")"
  custom="$(dirname "$GHOSTTY_SWITCH")/themes/$theme"
  {
    echo "# Written by theme-mode — do not edit. Reload ghostty: ctrl+shift+,"
    if [ -f "$custom" ]; then
      echo "config-file = $custom"
    else
      echo "theme = $theme"
    fi
  } >"$GHOSTTY_SWITCH"

  # Ghostty reloads its config on SIGUSR2 (1.2+). Without this the include above
  # sits on disk until you hit ctrl+shift+, by hand. USR2 ONLY — ghostty crashes
  # on any other signal. macOS runs the same binary name from the app bundle.
  if command -v pkill >/dev/null 2>&1; then
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi

  # Claude Code: push the mode into ~/.claude/settings.json so the NEXT session
  # opens in it. A running session does NOT repaint — Claude Code reloads the
  # settings value but never re-renders the TUI on a `theme` change (known gap,
  # anthropics/claude-code #33899), and its `auto` OSC 11 detection only samples
  # at launch (and the multiplexer mangles it), so a flip never reaches an open
  # session. `light`/`dark` are valid theme values, so $mode drops straight in.
  # To see it live in an open session, run /theme by hand.
  local claude_settings="$HOME/.claude/settings.json"
  if command -v jq >/dev/null 2>&1 && [ -f "$claude_settings" ]; then
    local claude_tmp
    claude_tmp="$(mktemp)"
    if jq --arg t "$mode" '.theme = $t' "$claude_settings" >"$claude_tmp" 2>/dev/null; then
      mv "$claude_tmp" "$claude_settings"
    else
      rm -f "$claude_tmp"
    fi
  fi

  # Starship: no include mechanism, but it re-reads its whole config every prompt
  # from its default path ~/.config/starship.toml. Regenerate that REAL file (not
  # a symlink — it's machine-local) from the stowed template with the active
  # `palette =` line swapped to `$family-$mode`, so EVERY running shell flips on
  # its next prompt with no reload. Only the top-level `palette = ` line matches
  # the anchored sed — the [palettes.*] headers are untouched. The palette names
  # in the template are `<family>-<mode>` (e.g. flume-dark), so this is a two-
  # axis swap now, not mode-only.
  local starship_tmpl="$HOME/.config/starship.toml.template"
  local starship_cfg="$HOME/.config/starship.toml"
  if [ -f "$starship_tmpl" ]; then
    sed "s/^palette = .*/palette = \"$family-$mode\"/" "$starship_tmpl" >"$starship_cfg"
  fi

  # herdr: regenerate ~/.config/herdr/config.toml from the stowed template with
  # the active palette, then reload the running server. No-op without herdr.
  herdr_apply "$family" "$mode"

  # hunk: one builtin theme id per family x mode, edited in place. No-op for a
  # family with no mapping.
  hunk_apply "$family" "$mode"

  echo "$family $mode"
}

arg="${1:-toggle}"
case "$arg" in
  dark | light) apply "$(current_family)" "$arg" ;;
  toggle)
    [ "$(current_mode)" = "light" ] && mode="dark" || mode="light"
    apply "$(current_family)" "$mode"
    ;;
  use)
    family="${2:-}"
    if ! families | grep -qx "$family"; then
      echo "unknown family: '$family' (see: theme-mode list)" >&2
      exit 2
    fi
    mode="${3:-$(current_mode)}"
    case "$mode" in dark | light) : ;; *) mode="dark" ;; esac
    apply "$family" "$mode"
    ;;
  list) families ;;
  status) echo "$(current_family) $(current_mode)" ;;
  *)
    echo "usage: theme-mode [dark|light|toggle] | use <family> [mode] | list | status" >&2
    exit 2
    ;;
esac
