#!/bin/bash
# Create a git worktree as its own herdr workspace (a tuios session under
# tuios), laid out by herdr-dev.
#
# Usage: herdr-worktree [--fork --prompt-file <path> | --fork --prompt <text>]
#                       [--base <ref>] [branch]
#   branch        prompted for when omitted (the prefix+ctrl+w popup).
#   --fork        carry the Claude conversation running in this pane into the
#                 new workspace's claude pane, as a forked session. Needs a
#                 brief: --prompt-file or --prompt.
#   --prompt-file the file holding the brief the forked session starts working
#                 on at once. Only with --fork.
#   --prompt      the brief as text, in place of --prompt-file.
#   --base        the ref to branch off. Defaults to origin's default branch,
#                 fetched first, or HEAD when the repo has no origin.
#
# The worktree lands beside the main checkout: <repo>-<TICKET-NUM> for a
# TICKET-NUM-desc branch, otherwise <repo>-<desc> (feature/ and fix/ dropped,
# remaining slashes as dashes). When that folder is taken, as by a second
# branch for one ticket, it is <repo>-<branch> instead.
# The branch is pushed to origin when that remote exists.
# Node dependencies are installed for each tracked package-lock.json or
# pnpm-lock.yaml at the worktree root or one folder down, before the panes
# start. Their output goes to herdr-worktree-install.log in the worktree's git
# dir; a failed install names the command and that log.
#
# With --fork, the run fails when the new claude pane shows no claude agent
# within HERDR_WORKTREE_FORK_TIMEOUT seconds (default 30). The error names the
# pane and the command to run there.
#
# Every pane in the new workspace starts in the worktree, so popups that
# inherit the pane cwd (prefix+d, prefix+g, prefix+space, ...) see it too.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
bin_dir="$(cd "$(dirname "$0")" && pwd)"

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; }

fork=""
prompt=""
prompt_file=""
base=""
branch=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --fork) fork=1 ;;
        --prompt)
            [ $# -ge 2 ] || { echo "herdr-worktree: --prompt needs text" >&2; exit 1; }
            prompt="$2"
            shift
            ;;
        --prompt-file)
            [ $# -ge 2 ] || { echo "herdr-worktree: --prompt-file needs a path" >&2; exit 1; }
            prompt_file="$2"
            shift
            ;;
        --base)
            [ $# -ge 2 ] || { echo "herdr-worktree: --base needs a ref" >&2; exit 1; }
            base="$2"
            shift
            ;;
        -*) echo "herdr-worktree: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)
            [ -z "$branch" ] || { echo "herdr-worktree: one branch only" >&2; exit 1; }
            branch="$1"
            ;;
    esac
    shift
done

if [ -n "$prompt_file" ]; then
    [ -z "$prompt" ] || { echo "herdr-worktree: give --prompt or --prompt-file, not both" >&2; exit 1; }
    prompt=$(cat -- "$prompt_file")
fi

[ -z "$fork" ] || [ -n "$prompt" ] \
    || { echo "herdr-worktree: --fork needs a brief for the forked session: --prompt-file <path> or --prompt <text>" >&2; exit 1; }
[ -z "$prompt" ] || [ -n "$fork" ] \
    || { echo "herdr-worktree: --prompt and --prompt-file only work with --fork" >&2; exit 1; }

command -v herdr-api >/dev/null \
    || { echo "herdr-worktree: herdr-api is not on PATH; run ~/dotfiles/install/stow to link it into ~/.local/bin" >&2; exit 1; }

if [ -z "$branch" ]; then
    # fzf as a one-line prompt: Enter returns the typed text (exit 1, since
    # there is no list to match), Esc cancels (exit 130).
    fzf_status=0
    branch=$(fzf --reverse --print-query --info=hidden --prompt="branch> " </dev/null) \
        || fzf_status=$?
    [ "$fzf_status" -le 1 ] || exit 0
fi
[ -n "$branch" ] || { echo "herdr-worktree: no branch given" >&2; exit 1; }

checkout=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "herdr-worktree: not inside a git repo" >&2; exit 1; }
main_checkout=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

if [ -z "$base" ]; then
    base=HEAD
    if git remote get-url origin &>/dev/null; then
        default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) \
            || default_branch=""
        if [ -n "$default_branch" ]; then
            base="$default_branch"
            git fetch --quiet origin "${default_branch#origin/}" \
                || echo "herdr-worktree: fetch failed; branching off the local $base" >&2
        else
            echo "herdr-worktree: origin/HEAD unset; branching off HEAD (git remote set-head origin --auto fixes it)" >&2
        fi
    fi
fi

if [[ "$branch" =~ ^([A-Z]+-[0-9]+) ]]; then
    suffix="${BASH_REMATCH[1]}"
else
    suffix="${branch#feature/}"
    suffix="${suffix#fix/}"
    suffix="${suffix//\//-}"
fi
worktree_parent=$(dirname "$main_checkout")
repo=$(basename "$main_checkout")
worktree="$worktree_parent/$repo-$suffix"
[ ! -e "$worktree" ] || worktree="$worktree_parent/$repo-${branch//\//-}"
[ ! -e "$worktree" ] || { echo "herdr-worktree: $worktree already exists" >&2; exit 1; }

claude_session=""
if [ -n "$fork" ]; then
    claude_session=$(herdr-api pane current \
        | jq -r 'select(.result.pane.agent == "claude") | .result.pane.agent_session.value // empty')
    [ -n "$claude_session" ] || { echo "herdr-worktree: --fork needs a claude pane" >&2; exit 1; }
fi

# herdr prints its own error to stderr, so only name the step that failed.
# tuios answers no worktree.create, so under tuios git makes the worktree and
# the workspace opens on it.
label="$(basename "$worktree")"
if [ -n "${TUIOS_SOCKET:-}" ]; then
    git -C "$checkout" worktree add -b "$branch" "$worktree" "$base" \
        || { echo "herdr-worktree: git worktree add failed" >&2; exit 1; }
    created=$(herdr-api workspace create --cwd "$worktree" --label "$label" --focus) \
        || { echo "herdr-worktree: workspace create failed" >&2; exit 1; }
else
    # herdr makes worktrees only from the repo's main checkout, so a run from a
    # linked worktree hands it the main checkout. Resolve the base here first:
    # HEAD and relative refs mean something else in the main checkout.
    if [ "$checkout" != "$main_checkout" ]; then
        base=$(git rev-parse --verify "$base^{commit}") \
            || { echo "herdr-worktree: cannot resolve base $base" >&2; exit 1; }
    fi
    created=$(herdr worktree create --cwd "$main_checkout" --branch "$branch" --base "$base" \
        --path "$worktree" --label "$label" --focus) \
        || { echo "herdr-worktree: herdr worktree create failed" >&2; exit 1; }
fi
ws=$(jq -r '.result.workspace.workspace_id' <<<"$created")

# A new worktree has no node_modules, so install node dependencies for each
# lockfile at the root or one folder down before any pane runs repo tooling.
# A failed install warns with the command to run and does not stop the run.
lockfiles=$(git -C "$worktree" ls-files -- ':(glob)package-lock.json' ':(glob)pnpm-lock.yaml' \
    ':(glob)*/package-lock.json' ':(glob)*/pnpm-lock.yaml')
install_log=$(git -C "$worktree" rev-parse --path-format=absolute --git-path herdr-worktree-install.log)
while IFS= read -r lockfile; do
    [ -n "$lockfile" ] || continue
    package_dir="$worktree"
    [[ "$lockfile" != */* ]] || package_dir="$worktree/${lockfile%/*}"
    case "${lockfile##*/}" in
        package-lock.json) install_cmd=(npm ci --no-audit --no-fund) ;;
        pnpm-lock.yaml) install_cmd=(pnpm install --frozen-lockfile) ;;
    esac
    if ! command -v "${install_cmd[0]}" >/dev/null; then
        echo "herdr-worktree: ${install_cmd[0]} is not on PATH; install dependencies in $package_dir by hand" >&2
        continue
    fi
    echo "herdr-worktree: installing dependencies in $package_dir" >&2
    (cd "$package_dir" && "${install_cmd[@]}") </dev/null >>"$install_log" 2>&1 \
        || echo "herdr-worktree: dependency install failed (output in $install_log); run in $package_dir: ${install_cmd[*]}" >&2
done <<<"$lockfiles"

# tuios ignores create's --focus, and herdr-dev's layout calls need the client
# on this workspace.
herdr-api workspace focus "$ws" >/dev/null

# herdr-dev prints the claude pane's id, then the command it typed there.
layout=$("$bin_dir/herdr-dev" "$worktree" "$ws" "$claude_session" "$prompt")
claude_pane=$(sed -n 1p <<<"$layout")
claude_cmd=$(sed -n 2p <<<"$layout")

if git -C "$worktree" remote get-url origin &>/dev/null; then
    git -C "$worktree" push -u origin "$branch" \
        || echo "herdr-worktree: push failed; run git push -u origin $branch" >&2
fi

[ -n "$fork" ] || exit 0

# herdr adopts a pane as a claude agent once it detects the process.
fork_timeout="${HERDR_WORKTREE_FORK_TIMEOUT:-30}"
for _ in $(seq "$fork_timeout"); do
    pane_agent=$(herdr-api pane get "$claude_pane" 2>/dev/null | jq -r '.result.pane.agent // empty') || pane_agent=""
    [ "$pane_agent" != "claude" ] || exit 0
    sleep 1
done
echo "herdr-worktree: the fork did not start: pane $claude_pane shows no claude agent after ${fork_timeout}s. Run this in that pane: $claude_cmd" >&2
exit 1
