#!/bin/bash
# Drive a running nvim from a Claude Code session: open FILE at LINE in the
# instance whose cwd contains the file. Lets a skill walkthrough (peer-review
# findings, eng-spec research, /stage read queue) move the editor to each
# file:line as it is discussed instead of making the user type the path.
#
# Socket discovery: nvim auto-listens on $XDG_RUNTIME_DIR/nvim.PID.0 when that
# is set (0.12+), else $TMPDIR/nvim.$USER/*/nvim.PID.0; both are searched.
# Among live instances, pick the one whose getcwd() is the longest prefix of
# FILE's absolute path; NVIM_JUMP_SOCKET overrides. Read-only on the buffer —
# only :edit, cursor motion and highlights, never text.
#
# --note shades LINE..END and shows TEXT above it (nvim's util/jump_note.lua);
# each --note belongs to the location after it. Several locations make a list:
# nvim opens the first, ]k/[k step through it, and the next jump replaces it.
# --push nests the new list inside the current one instead; [K in nvim drops
# back to the outer list. <Esc> in nvim dismisses the note.
#
# Usage: nvim-jump [--push] [--note TEXT] FILE[:LINE[-END]] [LINE]
#        nvim-jump [--push] [--note TEXT] FILE:LINE [--note TEXT] FILE:LINE ...
#        nvim-jump --where               # file:line under the cursor
#        nvim-jump --list                # live instances and their cwd
#
# Exit 0 on jump, 1 no instance owns the file, 2 nvim not running / bad args.

set -euo pipefail

usage() { sed -n '19,22p' "$0"; exit 2; }

sockets() {
    local s pid
    for s in "${XDG_RUNTIME_DIR:-/nonexistent}"/nvim.*.0 "${TMPDIR:-/tmp}"/nvim."$USER"/*/nvim.*.0 /tmp/nvim."$USER"/*/nvim.*.0; do
        [ -S "$s" ] || continue
        pid=${s##*/nvim.}; pid=${pid%.0}
        kill -0 "$pid" 2>/dev/null && echo "$s"
    done | sort -u
}

cwd_of() { nvim --server "$1" --remote-expr 'getcwd()' 2>/dev/null; }

# $1 as a Vim double-quoted string literal.
vim_str() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "${s//$'\n'/\\n}"
}

# The live instance whose cwd is the longest prefix of path $1.
owner_of() {
    local s cwd owner=${NVIM_JUMP_SOCKET:-} best=-1
    if [ -z "$owner" ]; then
        while read -r s; do
            cwd=$(cwd_of "$s") || continue
            case "$1" in "$cwd"/*) [ ${#cwd} -gt $best ] && { best=${#cwd}; owner=$s; } ;; esac
        done < <(sockets)
    fi
    echo "$owner"
}

if [ "${1:-}" = "--list" ]; then
    while read -r s; do printf '%s\t%s\n' "$(cwd_of "$s")" "$s"; done < <(sockets)
    exit 0
fi

if [ "${1:-}" = "--where" ]; then
    sock=$(owner_of "$(pwd -P)/")
    [ -n "$sock" ] || { echo "no nvim instance owns $(pwd -P) (nvim-jump --list)" >&2; exit 1; }
    nvim --server "$sock" --remote-expr 'expand("%:p") . ":" . line(".")'
    echo
    exit 0
fi

# Parallel arrays, one entry per location. A bare LINE sets the previous
# location's line; a trailing --note goes to the last location.
files=(); lines=(); notes=()
pending_note=
push=v:false
while [ $# -gt 0 ]; do
    if [ "$1" = --push ]; then
        push=v:true; shift; continue
    fi
    if [ "$1" = --note ]; then
        [ $# -ge 2 ] || usage
        pending_note=$2; shift 2; continue
    fi
    if [[ $1 =~ ^[0-9]+(-[0-9]+)?$ && ${#files[@]} -gt 0 ]]; then
        lines[${#lines[@]}-1]=$1
    else
        case "$1" in
            *:[0-9]*) files+=("${1%:*}"); lines+=("${1##*:}") ;;
            *) files+=("$1"); lines+=(1) ;;
        esac
        notes+=("$pending_note"); pending_note=
    fi
    shift
done
[ ${#files[@]} -ge 1 ] || usage
[ -z "$pending_note" ] || notes[${#notes[@]}-1]=$pending_note

jumps=
for i in "${!files[@]}"; do
    first=${lines[$i]%-*}; last=${lines[$i]#*-}
    [[ $first =~ ^[0-9]+$ && $last =~ ^[0-9]+$ ]] || { echo "bad line: ${lines[$i]}" >&2; exit 2; }
    file=$(cd "$(dirname "${files[$i]}")" 2>/dev/null && pwd -P)/$(basename "${files[$i]}") || { echo "no such file: ${files[$i]}" >&2; exit 1; }
    files[$i]=$file
    jumps+="${jumps:+, }{\"file\": $(vim_str "$file"), \"first\": $first, \"last\": $last, \"note\": $(vim_str "${notes[$i]}")}"
done
file=${files[0]}; line=${lines[0]}

sock=$(owner_of "$file")
[ -n "$sock" ] || { echo "no nvim instance owns $file (nvim-jump --list)" >&2; exit 1; }

# <C-\><C-n> exits any mode (insert/visual/cmdline) before the command.
nvim --server "$sock" --remote-send "<C-\\><C-n>:edit +${line%-*} $(printf '%q' "$file")<CR>zz"
# Every jump replaces the last list unless --push; one location with no --note
# and no --push only clears it.
note_error=$(nvim --server "$sock" --remote-expr "luaeval('select(2, pcall(function(a) return require(\"util.jump_note\").show(a.jumps, a.push) end, _A))', {'jumps': [$jumps], 'push': $push})" 2>&1) || true
list_hint=
[ ${#files[@]} -eq 1 ] || list_hint=" (1/${#files[@]}, ]k/[k for the rest)"
[ -z "$list_hint${notes[0]}" ] || [ -z "$note_error" ] || echo "note not shown: $note_error" >&2
echo "$(cwd_of "$sock") -> ${file#"$(cwd_of "$sock")"/}:$line$list_hint"
