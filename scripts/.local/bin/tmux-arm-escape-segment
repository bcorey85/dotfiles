#!/bin/bash
# Prepend the escape-score segment to tmux status-right, idempotently.
# Theme files own (and overwrite) status-right, so this must re-run after any
# theme source — call sites: .tmux.conf startup (run-shell, queued after the
# theme source) and theme-mode's apply(). Same contract as
# tmux-arm-workmux-segment; both prepend, so whichever arms last sits leftmost.
# No-ops on machines with no escape log yet.

export PATH="$HOME/.local/bin:$PATH"
command -v tmux >/dev/null 2>&1 || exit 0
[ -f "${REVIEW_ESCAPES_FILE:-$HOME/.claude/review-escapes.jsonl}" ] || exit 0

sr="$(tmux show-option -gqv status-right 2>/dev/null)" || exit 0
case "$sr" in
  *escape-score*) ;; # already armed
  *) tmux set-option -g status-right "#(~/.local/bin/escape-score)$sr" ;;
esac
