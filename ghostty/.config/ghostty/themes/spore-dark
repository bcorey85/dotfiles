# spore "softest" (linhusp/spore.nvim, mossy #101d1a) — DARK-ONLY; theme-mode
# maps both modes to this one file. Upstream ships no terminal extras and the
# palette has no blue or magenta, so ANSI is hand-mapped from lua/spore/palette
# run through the softest desaturation profile: 1 clay, 2 grass, 3 sand,
# 4 moss, 5 seed, 6 tree, 7/15 fg, 0 float_bg, 8 bark. The profile flattens
# everything toward the canvas on purpose, so the bright slots repeat the
# normals rather than inventing lifted colours the theme does not have.
# Selection is the theme's Visual (tree on the canvas).
background = #101d1a
foreground = #968a6a
cursor-color = #968a6a
cursor-text = #101d1a
selection-background = #5a6e53
selection-foreground = #101d1a

