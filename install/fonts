#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_info() { echo -e "${YELLOW}→${NC} $1"; }

PLATFORM=${1:-}

if [[ ! "$PLATFORM" =~ ^(wsl|ubuntu|mac|arch)$ ]]; then
    print_error "Usage: ./setup-fonts [wsl|ubuntu|mac|arch]"
    exit 1
fi

# install_nerd_font <release-asset> <sentinel-face> <label> <face>...
# Pulls only the named faces out of a Nerd Fonts release tarball. Skips the
# download when the sentinel face is already on disk.
install_nerd_font() {
    local asset=$1 sentinel=$2 label=$3
    shift 3

    if [ -f "$HOME/.local/share/fonts/$sentinel" ]; then
        print_success "$label already installed"
        return
    fi

    curl -fLo "/tmp/$asset" \
        "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$asset"
    tar xf "/tmp/$asset" -C "$HOME/.local/share/fonts" "$@"
    rm "/tmp/$asset"
    print_success "$label installed"
}

# install_aporetic_sans_mono <dir>
# Aporetic ships no release asset and no apt/pacman package: pull the four
# Sans Mono TTFs from the pinned tag. Skips when the Regular face is on disk.
APORETIC_TAG=1.2.0
install_aporetic_sans_mono() {
    local dir=$1 face
    if [ -f "$dir/aporetic-sans-mono-normalregularupright.ttf" ]; then
        print_success "Aporetic Sans Mono already installed"
        return
    fi
    mkdir -p "$dir"
    for face in regularupright regularitalic boldupright bolditalic; do
        curl -fLo "$dir/aporetic-sans-mono-normal$face.ttf" \
            "https://raw.githubusercontent.com/protesilaos/aporetic/$APORETIC_TAG/aporetic-sans-mono/TTF/aporetic-sans-mono-normal$face.ttf"
    done
    print_success "Aporetic Sans Mono installed"
}

case $PLATFORM in
    wsl)
        print_info "WSL detected - Fonts must be installed on Windows"
        echo ""
        echo "  1. Download: https://github.com/ryanoasis/nerd-fonts/releases"
        echo "  2. Install the FiraCode Nerd Font"
        echo "  3. Download the aporetic-sans-mono TTFs: https://github.com/protesilaos/aporetic/tree/$APORETIC_TAG/aporetic-sans-mono/TTF"
        echo "  4. Windows Terminal → Settings → Font face → 'Aporetic Sans Mono, FiraCode Nerd Font Mono'"
        echo ""
        print_info "Press Enter when fonts are installed..."
        read || true
        ;;
    ubuntu|arch)
        print_info "Installing Nerd Fonts..."
        mkdir -p ~/.local/share/fonts

        # Aporetic Sans Mono — the terminal face.
        install_aporetic_sans_mono "$HOME/.local/share/fonts/aporetic"

        # Fira Code — ghostty's Nerd-glyph fallback, and the face named by nvim,
        # quickshell, hyprlock and zed. Ships no italic, so there is no
        # -Italic/-BoldItalic to pull.
        install_nerd_font FiraCode.tar.xz FiraCodeNerdFontMono-Regular.ttf \
            "FiraCode Nerd Font" \
            FiraCodeNerdFontMono-Regular.ttf FiraCodeNerdFontMono-Bold.ttf \
            FiraCodeNerdFontMono-Light.ttf FiraCodeNerdFontMono-Retina.ttf \
            FiraCodeNerdFontMono-Medium.ttf FiraCodeNerdFontMono-SemiBold.ttf

        fc-cache -fv
        ;;
    mac)
        print_info "Installing Nerd Fonts..."
        brew install --cask font-aporetic 2>/dev/null || print_success "Aporetic already installed"
        brew install --cask font-fira-code-nerd-font 2>/dev/null || print_success "FiraCode Nerd Font already installed"
        print_success "Nerd Fonts installed"
        ;;
esac
