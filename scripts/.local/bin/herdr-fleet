#!/bin/bash
# Fleet dashboard — the `C-.` agent popup, herdr-native.
# Lists every agent pane sorted by who needs you most and jumps on Enter.
# herdr's sidebar covers the same data as a side rail; this is the
# centered-popup reflex instead.
#
# Sort order mirrors herdr's own agent_panel_sort = "priority" so the numbers
# here match the sidebar's: blocked > done > working > idle > unknown, ties
# broken by the API's own workspace/pane order. herdr's `done` is an idle agent
# you haven't looked at yet and `idle` is one you have — which is why a working
# agent outranks a plain idle one.
# Targets are pane_ids, which `herdr agent read/focus` both accept.
#
# Digits 1-9 direct-address the numbered rows (`C-. 1` -> first agent), but
# only while the query is empty — once you've started typing, a digit is a
# search character again, so repos and titles with numbers stay searchable.

export PATH="$HOME/.local/bin:$PATH"

agents=$(herdr agent list 2>/dev/null)

if [ -z "$agents" ]; then
    echo "herdr is not running (no response from the socket API)."
    read -r -n1 -p "press any key to close"
    exit 1
fi

# Last activity: the herdr API carries no timestamps, so the age comes from the
# mtime of the agent's own session transcript, found by the session id herdr
# reports. Claude-specific by nature — any other agent just shows "-".
session_age() {
    local id=$1 f mt d
    [ -z "$id" ] || [ "$id" = "null" ] && { echo "-"; return; }
    for f in "$HOME"/.claude/projects/*/"$id".jsonl; do
        [ -f "$f" ] && break
        f=""
    done
    [ -z "$f" ] && { echo "-"; return; }
    mt=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)   # GNU || BSD
    [ -z "$mt" ] && { echo "-"; return; }
    d=$(( $(date +%s) - mt ))
    if   [ "$d" -lt 60 ];    then echo "<1m"
    elif [ "$d" -lt 3600 ];  then echo "$((d / 60))m"
    elif [ "$d" -lt 86400 ]; then echo "$((d / 3600))h"
    else                          echo "$((d / 86400))d"
    fi
}

meta=$(printf '%s' "$agents" | jq -r '
  .result.agents
  # Ranks are herdr workspace_attention_priority() inverted (src/ui/sidebar.rs).
  # sort_by is stable and agent list already comes back in workspace/pane order,
  # so no explicit tiebreak — adding one would diverge from the sidebar, whose
  # secondary order is workspace INDEX, not id.
  | map(. + {rank:
      (if   .agent_status == "blocked" then 0
       elif .agent_status == "done"    then 1
       elif .agent_status == "working" then 2
       elif .agent_status == "idle"    then 3
       else 4 end)})
  | sort_by(.rank)
  # to_entries after the sort so the printed number IS the fzf row position
  # the digit binds jump to.
  | to_entries | .[]
  # Raw fields only — bash formats the display column, since branch and age
  # need per-row shell-outs beyond jq.
  # Repo is the cwd basename, except under a worktree root
  # (.../worktrees/<branch>) where the leaf is a branch name and the parent
  # carries the project — show "project/branch" there.
  | [ .value.pane_id
    , (.key + 1 | tostring)
    , (if .value.focused then "●" else " " end)
    , .value.agent_status
    , ((.value.cwd // "") | split("/") | map(select(. != ""))
        | if   length == 0 then "-"
          elif length >= 3 and .[-2] == "worktrees"  then .[-3] + "/" + .[-1]
          else .[-1] end)
    , (.value.cwd // "")
    , (.value.agent_session.value // "")
    , (.value.terminal_title_stripped // .value.agent // "-")
    ] | @tsv
')

# Field 1 is the jump target and stays hidden in fzf (--with-nth=2).
rows=()
while IFS=$'\t' read -r pane num mark status repo cwd session title; do
    [ -z "$pane" ] && continue
    branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
    [ -z "$branch" ] && branch=$(git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
    [ -z "$branch" ] && branch="-"
    rows+=("$(printf '%s\t%s %s %-7.7s %-16.16s %-16.16s %4s  %s' \
        "$pane" "$num" "$mark" "$status" "$repo" "$branch" "$(session_age "$session")" "$title")")
done <<< "$meta"

if [ ${#rows[@]} -eq 0 ]; then
    echo "No agent panes detected."
    read -r -n1 -p "press any key to close"
    exit 0
fi

# One bind per digit: empty query -> move to that row and accept; mid-search ->
# fall through to the literal character.
digit_binds=()
for n in 1 2 3 4 5 6 7 8 9; do
    digit_binds+=(--bind "$n:transform:[ -n {q} ] && echo 'put($n)' || echo 'pos($n)+accept'")
done

sel=$(printf '%s\n' "${rows[@]}" | fzf \
    --reverse \
    --ansi \
    --delimiter='\t' \
    --with-nth=2 \
    --prompt="agent> " \
    --header="1-9=jump  enter=jump  ●=current" \
    "${digit_binds[@]}") || exit 0

[ -n "$sel" ] && herdr agent focus "$(printf '%s' "$sel" | cut -f1)"
