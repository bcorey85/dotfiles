          {
            "type": "command",
            "command": "~/.claude/scripts/tools/notify 'Claude Code' 'Task complete'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "tuios agent-hook claude-code --integration 3",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
