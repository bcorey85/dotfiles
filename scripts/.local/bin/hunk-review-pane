#!/bin/bash
# Loop for the herdr dev layout's `review` pane: hunk, with nvim a handoff away.
#
# Runs `hunk diff <merge-base with origin/main or origin/master> --watch` on a feature
# branch (committed and worktree changes), plain `hunk diff --watch` on the default branch,
# a detached HEAD, or with no origin/main or origin/master.
# When hunk quits with the target `nvim` or `lazygit` in $HUNK_REVIEW_HANDOFF, runs that tool in the repo root and, when it exits, goes
# back to hunk. A plain quit of hunk ends the loop; the pane drops back to its shell.
#
# Two things hand off: the claude-review extension's `E` and `C` keys (write the
# target, quit hunk) and nvim-jump, which has no nvim to jump in. nvim-jump is in
# another pane, so it finds this one by the pane id: state lives in the directory
# `hunk-review-pane --state-dir PANE_ID` prints,
#   root      the repo root; nvim-jump hands off only for files under it
#   handoff   the target file, read here once hunk exits
#   hunk.pid  hunk's pid, written by the extension (the shim and node wrappers
#             make the child this script starts a different process)
# nvim-jump writes `handoff`, then SIGTERMs the pid, the same shutdown as `q`.
# The key is $HERDR_PANE_ID: set in every herdr pane and fixed unless the pane moves to
# another workspace; after a move nvim-jump cannot find this pane's state until the loop
# restarts. With it unset, hunk runs plain and nothing hands off.
#
# Env (PATH shims, EDITOR) is the caller's job.
#
# Usage: hunk-review-pane [hunk diff args...]
#        hunk-review-pane --state-dir PANE_ID
#        hunk-review-pane --viewers
#
# Memory cap: hunk runs in a systemd user scope with MemoryMax=$HUNK_REVIEW_MEMORY_MAX
# (default 1G, digits then K, M or G) and no swap, in a herdr pane and in a plain terminal
# alike. With no systemd user session (not Linux, no user bus) hunk runs uncapped. A scope
# that cannot start stops the launcher; hunk never runs uncapped by fallback.
# When the kernel kills hunk for passing the cap, the terminal is reset, one line says so, and
# hunk restarts. A kill within $HUNK_REVIEW_RESTART_WINDOW_SECONDS (default 60) of the start
# waits for Enter first, and the launcher stops on end of input.
#
# --viewers prints the cap and one row per state dir holding hunk.pid, as JSON: see
# lib/viewer-memory.bash.

set -u

# $0 is a stow symlink, so the library is found from the script's real path.
# shellcheck source-path=SCRIPTDIR/../lib source=handoff-command.bash
. "$(dirname "$(readlink -f "$0")")/../lib/handoff-command.bash"
# shellcheck source-path=SCRIPTDIR/../lib source=viewer-memory.bash
. "$(dirname "$(readlink -f "$0")")/../lib/viewer-memory.bash"

# Under $HOME, not a shared /tmp, when there is no runtime dir: another local user could
# otherwise plant the state files nvim-jump trusts.
state_root() {
    echo "${XDG_RUNTIME_DIR:-$HOME/.cache}/hunk-review-pane"
}

state_dir() {
    echo "$(state_root)/${1//[^A-Za-z0-9_.-]/_}"
}

if [ "${1:-}" = "--state-dir" ]; then
    [ $# -eq 2 ] || { echo "usage: hunk-review-pane --state-dir PANE_ID" >&2; exit 2; }
    state_dir "$2"
    exit 0
fi

# Prints one JSON row per state dir with a hunk.pid, then the cap, as one object.
print_viewers() {
    local root pid_file pid_text pane_dir root_text rows cap_bytes
    root=$(state_root)
    rows=$(
        for pid_file in "$root"/*/hunk.pid; do
            [ -f "$pid_file" ] || continue
            pid_text=
            IFS= read -r pid_text <"$pid_file" || :
            if ! [[ $pid_text =~ ^[0123456789]+$ ]]; then
                echo "hunk-review-pane: $pid_file: expected a pid" >&2
                exit 2
            fi
            pane_dir=$(dirname "$pid_file")
            root_text=
            [ ! -f "$pane_dir/root" ] || IFS= read -r root_text <"$pane_dir/root" || :
            jq -nc --arg pane "$(basename "$pane_dir")" --arg root "$root_text" --arg pid "$pid_text" \
                '{pane: $pane, root: $root, pid: ($pid | tonumber)}'
        done
    ) || exit 2
    cap_bytes=$(viewer_memory_max_bytes)
    printf '%s\n' "$rows" | jq -s --argjson cap "$cap_bytes" '{cap_bytes: $cap, viewers: .}'
}

if [ "${1:-}" = "--viewers" ]; then
    viewer_memory_checked || exit 2
    print_viewers || exit 2
    exit 0
fi

viewer_memory_checked || exit 2

# Runs hunk under the memory cap, one fresh scope per start, restarting after an OOM kill.
# Returns hunk's status. Needs base_ref and untracked_flag set.
viewer_start_count=0
run_viewer() {
    local unit pane_label start_seconds status oom_killed
    pane_label=${HERDR_PANE_ID:-term}
    pane_label=${pane_label//[^A-Za-z0-9_.-]/_}
    while true; do
        viewer_start_count=$((viewer_start_count + 1))
        unit="hunk-review-$pane_label-$$-$viewer_start_count"
        set_viewer_cap_prefix "$unit"
        start_seconds=$SECONDS
        ${viewer_cap_prefix[@]+"${viewer_cap_prefix[@]}"} hunk diff ${base_ref:+"$base_ref"} --watch ${untracked_flag[@]+"${untracked_flag[@]}"} "$@"
        status=$?
        # Uncapped: the status is hunk's own, 137 included.
        [ ${#viewer_cap_prefix[@]} -gt 0 ] || return "$status"
        # Always asked, so the failed scope is reset whatever the status.
        oom_killed=false
        if viewer_scope_was_oom_killed "$unit"; then oom_killed=true; fi
        if [ "$status" -eq 137 ]; then oom_killed=true; fi
        [ "$oom_killed" = true ] || return "$status"
        # The dead viewer's pid and any handoff must not outlive it: nvim-jump would signal a reused pid.
        [ -z "${HUNK_REVIEW_PIDFILE:-}" ] || rm -f "$HUNK_REVIEW_PIDFILE" "$HUNK_REVIEW_HANDOFF"
        stty sane 2>/dev/null || :
        printf '\033[?1049l'
        echo "hunk-review-pane: the viewer passed its $viewer_memory_max memory cap and was killed; restarting" >&2
        if [ $((SECONDS - start_seconds)) -lt "$viewer_restart_window_seconds" ]; then
            echo "hunk-review-pane: killed within $viewer_restart_window_seconds s of its start; press Enter to try again" >&2
            read -r || return "$status"
        fi
    done
}

# Past the untracked-file limit, leave them out. Recomputed each pass: lazygit can add files.
untracked_flag=()
set_untracked_flag() {
    local flag
    untracked_flag=()
    flag=$(hunk-untracked-flag)
    [ -z "$flag" ] || untracked_flag=("$flag")
}

# On a feature branch, base_ref is the merge-base with origin's default branch, so the diff
# holds the branch's commits as well as the worktree and hunk-notes can anchor on committed
# lines. It is empty, and hunk shows the plain worktree diff, on the default branch, on a
# detached HEAD, and when origin has neither main nor master.
base_ref=
set_base_ref() {
    base_ref=
    local branch default_ref
    branch=$(git symbolic-ref --short -q HEAD) || return 0
    for default_ref in origin/main origin/master; do
        git rev-parse --verify --quiet "refs/remotes/$default_ref" >/dev/null || continue
        [ "$branch" != "${default_ref#origin/}" ] || return 0
        base_ref=$(git merge-base HEAD "refs/remotes/$default_ref") || base_ref=
        return 0
    done
}

# Outside a herdr pane there is no key for the state dir: plain hunk, no handoff.
# The ${a[@]+...} form: macOS /bin/bash 3.2 treats an empty array as unbound under set -u.
if [ -z "${HERDR_PANE_ID:-}" ]; then
    set_base_ref
    set_untracked_flag
    run_viewer "$@"
    exit $?
fi

# nvim-jump finds this pane by its label; a pane started by hand has none. A failed rename never stops the review.
herdr-api pane rename "$HERDR_PANE_ID" review >/dev/null 2>&1 || true

dir=$(state_dir "$HERDR_PANE_ID")
mkdir -p "$dir"
export HUNK_REVIEW_HANDOFF="$dir/handoff"
export HUNK_REVIEW_PIDFILE="$dir/hunk.pid"
trap 'rm -rf "$dir"' EXIT

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)
echo "$repo_root" >"$dir/root"

while true; do
    rm -f "$HUNK_REVIEW_HANDOFF" "$HUNK_REVIEW_PIDFILE"
    # Each pass: a commit or branch switch (lazygit's C) moves the base.
    set_base_ref
    set_untracked_flag
    run_viewer "$@"
    hunk_status=$?
    rm -f "$HUNK_REVIEW_PIDFILE"

    # Absent or empty file: hunk was quit normally, nothing to hand off to.
    [ -s "$HUNK_REVIEW_HANDOFF" ] || exit "$hunk_status"
    target=$(head -n 1 "$HUNK_REVIEW_HANDOFF")
    rm -f "$HUNK_REVIEW_HANDOFF"

    # Unknown target: exec_handoff_tool prints the message and returns without exec.
    is_handoff_target "$target" || { exec_handoff_tool "$target"; exit 1; }
    # The subshell keeps this loop alive: exec_handoff_tool replaces the shell it runs in.
    (cd "$repo_root" && exec_handoff_tool "$target")
done
