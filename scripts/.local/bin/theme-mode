contextBg        = "$ctxBg"
addedContentBg   = "${addWord:-$addedBg}"
removedContentBg = "${remWord:-$removedBg}"
contextContentBg = "$ctxBg"
addedSignColor   = "$sAdd"
removedSignColor = "$sRem"
lineNumberBg     = "$ctxBg"
lineNumberFg     = "$lnFg"
selectedHunk     = "$border"
badgeAdded       = "$badgeAdd"
badgeRemoved     = "$badgeRem"
badgeNeutral     = "$badgeNeu"
fileNew          = "$sAdd"
fileDeleted      = "$sRem"
fileRenamed      = "$fRename"
fileModified     = "$fMod"
fileUntracked    = "$fUntracked"
noteBorder       = "$border"
noteBackground   = "$note"
