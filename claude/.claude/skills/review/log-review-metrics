#!/usr/bin/env bash
# log-review-metrics — one metrics row per /review run, written through `ledger write`
#
# usage: log-review-metrics key=value [key=value ...]
#   e.g. log-review-metrics iter=2 fix=1 fixed=2 skipped_fp=1 ask=0 result=PASS
#
# Every value is sent as a JSON string; `ledger write review_metrics` types it.
# `specialists=` and `fixed_classes=` are counts by name, as a JSON object
# (`{"code-reviewer":2}`) or as `name:count,name:count`; names are stored lowercase
# with underscores for hyphens (`code_reviewer`). `result=` takes the spaced
# words (PASS WITH WARNINGS, NEEDS CHANGES, NOT DISPATCHED); they are stored with
# underscores, and `PASS (NITS ONLY)` is stored as PASS_WITH_WARNINGS, as
# log-review-finding folds it. clean, residue and findings are stored as sent.
# Every call, with or without `out=` and with telemetry off, exits 2 and writes nothing on an
# arg with no `=` (the words a spaced value leaves unquoted). A ledger row also needs
# `result=` from that set: any other value or a missing one exits 2, with telemetry off too.
# root=<path> runs the script in the reviewed repo or worktree, for a call from another folder;
# it is never stored.
# date, schema_version, repo, session, desc and diff_base are accepted and never stored; the
# writer adds the date, repo and session, and keys `branch=` into branch_key (with no
# ledger, stored raw in the local jsonl file).
# With no ledger found (PATH, then `${CARGO_HOME:-~/.cargo}/bin`) `ledger-write` appends the row to
# ~/.claude/review-metrics.jsonl and prints one stderr line. A row `ledger write`
# refuses exits 2.
#
# Second-draft telemetry retired 2026-07-16; a second_draft= key still routes the
# row to the second-draft log, as a corruption backstop for stale callers. An
# explicit out=<path> writes the row there as one JSONL line instead of to the
# ledger. Both redirects write only while the metrics switch is on.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../../scripts/lib/_kv.sh
source "$script_dir/../../scripts/lib/_kv.sh"
kv_help_exit "${BASH_SOURCE[0]}" "$@"
kv_enter_root "$@"
set -- ${kv_args[@]+"${kv_args[@]}"}
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

# A bare word is the tail of an unquoted spaced value (result=PASS WITH WARNINGS);
# skipping it would store a row with a cut or empty verdict.
for arg in "$@"; do
  case "$arg" in
    *=*) ;;
    *)
      echo "log-review-metrics: refusing to log: '$arg' is not key=value." >&2
      echo "Quote a spaced value as one word: \"result=PASS WITH WARNINGS\"." >&2
      exit 2
      ;;
  esac
done
out=""
# Second-draft rows route to the second-draft log even when the caller forgets
# out= — a second_draft= key in the review-metrics rows corrupts both datasets.
case " $* " in
  *" out="*) ;;
  *" second_draft="*) out="${SECOND_DRAFT_FILE:-$HOME/.claude/second-draft.jsonl}" ;;
esac

# The branch is read here, never trusted to the caller; a caller's own branch= still wins.
json=$(jq -cn --arg b "$(git branch --show-current 2>/dev/null || true)" \
  '{} + (if $b != "" then {branch: $b} else {} end)')

# specialists= and fixed_classes= are counts by name, not strings.
fold_counts_by_name() {
  case "$1" in
    specialists|fixed_classes) ;;
    *) return 1 ;;
  esac

  json=$(jq -c --arg k "$1" --arg v "$2" '
    .[$k] = (try ($v | fromjson | select(type == "object"))
             catch ($v | split(",") | map(select(. != "") | split(":") | {key: .[0], value: (.[1] // "0")}) | from_entries)
             // {})
    | .[$k] |= with_entries(.key |= (ascii_downcase | gsub("-"; "_")))' <<< "$json") || exit $?
}

# Every value may hold spaces here (result=PASS WITH WARNINGS).
kv_fold "*" fold_counts_by_name "$@"
[ -z "$kv_out_seen" ] || out="$kv_out"

# The caller's shell may leave ~ after = unexpanded (zsh does), so expand a
# bare ~ or a leading ~/ here (~user is left alone).
case "$out" in
  "~") out="$HOME" ;;
  "~/"*) out="$HOME/${out#"~/"}" ;;
esac

# A ledger row's verdict is checked before the telemetry switch, so a bad call fails the same way with it off.
if [ -z "$out" ]; then
  payload=$(jq -c '
    def result_verdict:
      (ascii_upcase | gsub("[_-]"; " ")) as $norm
      | if ($norm | test("^PASS WITH WARNINGS")) or $norm == "PASS (NITS ONLY)" then "PASS_WITH_WARNINGS"
      elif $norm == "PASS" then "PASS"
      elif $norm | test("^NEEDS CHANGES") then "NEEDS_CHANGES"
      elif $norm | test("^NOT DISPATCHED") then "NOT_DISPATCHED"
      else gsub(" "; "_") end;
    del(.desc, .diff_base)
    | (if .result then .result |= result_verdict else . end)
    | with_entries(.key |= (if . == "branch" then "branch_key" else . end))' <<< "$json")

  verdict=$(jq -r '.result // ""' <<< "$payload")
  case "$verdict" in
    PASS|PASS_WITH_WARNINGS|NEEDS_CHANGES|NOT_DISPATCHED|clean|residue|findings) ;;
    *)
      echo "log-review-metrics: refusing to log: result='$verdict' is not one of PASS, PASS WITH WARNINGS," \
        "PASS (NITS ONLY), NEEDS CHANGES, NOT DISPATCHED, clean, residue, findings." >&2
      exit 2
      ;;
  esac
fi

"$script_dir/../../scripts/telemetry/telemetry_enabled.sh" 2>/dev/null || exit 0

if [ -n "$out" ]; then
  printf '%s\n' "$(jq -c '. + {date: (now | todate)}' <<< "$json")" >> "$out"
  echo "logged → $out"
  exit 0
fi

printf '%s\n' "$payload" | bash "$script_dir/../../scripts/telemetry/ledger-write" review_metrics
