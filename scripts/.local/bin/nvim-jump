#!/bin/bash
# Drive a running nvim from a Claude Code session: open FILE at LINE in the
# instance whose cwd contains the file. Lets a skill walkthrough (peer-review
# findings, eng-spec research, /walk, /drive) move the editor to each
# file:line as it is discussed instead of making the user type the path.
#
# Socket discovery: nvim auto-listens on $XDG_RUNTIME_DIR/nvim.PID.0 when that
# is set (0.12+), else $TMPDIR/nvim.$USER/*/nvim.PID.0; both are searched.
# Among live instances, pick the one whose getcwd() is the longest prefix of
# FILE's absolute path; NVIM_JUMP_SOCKET overrides. Read-only on the buffer —
# only :edit, cursor motion and highlights, never text.
#
# --note colors LINE..END's line numbers and shows TEXT above them (nvim's util/jump_note.lua);
# each --note belongs to the location after it. Several locations make a list:
# nvim opens the first, ]v/[v step through it, and the next jump replaces it.
# --push nests the new list inside the current one instead; [V in nvim drops
# back to the outer list. <Esc> in nvim dismisses the note.
#
# Usage: nvim-jump [--push] [--note TEXT] FILE[:LINE[-END]] [LINE]
#        nvim-jump [--push] [--note TEXT] FILE:LINE [--note TEXT] FILE:LINE ...
#        nvim-jump --where               # file:line under the cursor
#        nvim-jump --list                # live instances and their cwd
#
# With no nvim owning the file, inside herdr the current tab's pane named `review`
# (hunk-review-pane) is turned from hunk into nvim in the repo root, and the jump
# runs once that nvim is up (NVIM_JUMP_WAIT_SECONDS, default 10). To post notes into
# a hunk diff instead, use hunk-notes.
# Exit 0 on jump, 1 no such directory, or no nvim instance owns the file and no review
# pane whose repo holds it can open one (or nvim did not start in time), 2 bad args.

set -euo pipefail

usage() { sed -n '19,22p' "$0"; exit 2; }

sockets() {
    local s pid
    for s in "${XDG_RUNTIME_DIR:-/nonexistent}"/nvim.*.0 "${TMPDIR:-/tmp}"/nvim."$USER"/*/nvim.*.0 /tmp/nvim."$USER"/*/nvim.*.0; do
        [ -S "$s" ] || continue
        pid=${s##*/nvim.}; pid=${pid%.0}
        kill -0 "$pid" 2>/dev/null && echo "$s"
    done | sort -u
}

cwd_of() { nvim --server "$1" --remote-expr 'getcwd()' 2>/dev/null; }

# $1 as a Vim double-quoted string literal.
vim_str() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "${s//$'\n'/\\n}"
}

# The live instance whose cwd is the longest prefix of path $1.
owner_of() {
    local s cwd owner=${NVIM_JUMP_SOCKET:-} best=-1
    if [ -z "$owner" ]; then
        while read -r s; do
            cwd=$(cwd_of "$s") || continue
            case "$1" in "$cwd"/*) [ ${#cwd} -gt "$best" ] && { best=${#cwd}; owner=$s; } ;; esac
        done < <(sockets)
    fi
    echo "$owner"
}

if [ "${1:-}" = "--list" ]; then
    while read -r s; do printf '%s\t%s\n' "$(cwd_of "$s")" "$s"; done < <(sockets)
    exit 0
fi

if [ "${1:-}" = "--where" ]; then
    sock=$(owner_of "$(pwd -P)/")
    [ -n "$sock" ] || { echo "no nvim instance owns $(pwd -P) (nvim-jump --list)" >&2; exit 1; }
    nvim --server "$sock" --remote-expr 'expand("%:p") . ":" . line(".")'
    echo
    exit 0
fi

# The argument parser is shared with hunk-notes. $0 is a stow symlink, so the library is found
# from the script's real path.
# shellcheck source-path=SCRIPTDIR/../lib source=location-args.bash
. "$(dirname "$(readlink -f "$0")")/../lib/location-args.bash"
allow_push=1
parse_location_args "$@"

resolve_location_files
jumps=
for i in "${!files[@]}"; do
    jumps+="${jumps:+, }{\"file\": $(vim_str "${files[$i]}"), \"first\": ${firsts[$i]}, \"last\": ${lasts[$i]}, \"note\": $(vim_str "${notes[$i]}")}"
done

# No nvim owns the file: turn the herdr dev layout's `review` pane (hunk-review-pane's
# loop) from hunk into nvim in the repo root. Returns 1 when there is no such pane
# or its hunk cannot be told to hand off.
open_nvim_in_review_pane() {
    [ -n "${HERDR_ENV:-}" ] || return 1
    local tab review_pane state_dir pid pane_root
    tab=$(herdr-api pane current --current | jq -r '.result.pane.tab_id') || return 1
    review_pane=$(herdr-api pane list | jq -r --arg tab "$tab" \
        '.result.panes[] | select(.tab_id == $tab and .label == "review") | .pane_id' | head -n 1) || return 1
    [ -n "$review_pane" ] || return 1
    state_dir=$(hunk-review-pane --state-dir "$review_pane")
    # The pane opens nvim in its own repo root; a file elsewhere would never get an owner.
    pane_root=$(cat "$state_dir/root" 2>/dev/null) || return 1
    case "$file" in "$pane_root"/*) ;; *) return 1 ;; esac
    pid=$(cat "$state_dir/hunk.pid" 2>/dev/null) || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    echo nvim >"$state_dir/handoff"
    kill -TERM "$pid" 2>/dev/null
}

# Poll for the nvim the review pane starts, up to $NVIM_JUMP_WAIT_SECONDS (10).
wait_for_owner() {
    local tries=$(( ${NVIM_JUMP_WAIT_SECONDS:-10} * 5 )) owner
    while [ "$tries" -gt 0 ]; do
        owner=$(owner_of "$1")
        if [ -n "$owner" ]; then
            echo "$owner"
            return 0
        fi
        sleep 0.2
        tries=$((tries - 1))
    done
    return 1
}

sock=$(owner_of "$file")
if [ -z "$sock" ]; then
    if ! open_nvim_in_review_pane; then
        echo "no nvim instance owns $file and no review pane for its repo could open one (nvim-jump --list; hunk-notes posts to a hunk session)" >&2
        exit 1
    fi
    sock=$(wait_for_owner "$file") || { echo "nvim did not start in the review pane within ${NVIM_JUMP_WAIT_SECONDS:-10}s" >&2; exit 1; }
fi

# <C-\><C-n> exits any mode (insert/visual/cmdline) before the command.
nvim --server "$sock" --remote-send "<C-\\><C-n>:edit +${line%-*} $(printf '%q' "$file")<CR>zz"
# Every jump replaces the last list unless --push; one location with no --note
# and no --push only clears it.
note_error=$(nvim --server "$sock" --remote-expr "luaeval('select(2, pcall(function(a) return require(\"util.jump_note\").show(a.jumps, a.push) end, _A))', {'jumps': [$jumps], 'push': $push})" 2>&1) || true
list_hint=
[ ${#files[@]} -eq 1 ] || list_hint=" (1/${#files[@]}, ]v/[v for the rest)"
[ -z "$list_hint${notes[0]}" ] || [ -z "$note_error" ] || echo "note not shown: $note_error" >&2
echo "$(cwd_of "$sock") -> ${file#"$(cwd_of "$sock")"/}:$line$list_hint"
