#!/usr/bin/env bash
# review-scope — print the whole review scope of a repo in one call
#
# usage: review-scope [key=value ...]
#   mode=worktree   (default) unstaged + staged + untracked, against base
#   mode=staged     staged only, against base
#   base=HEAD       (default) the ref every count is taken against
#   merge_base=<ref>  compare-to ref for the MERGE_BASE line; default: the
#                     ref that scripts/tools/branch-base returns, else empty
#   paths=<a:b:c>   colon-separated pathspec filter applied to every git call
#   root=<dir>      run in this directory instead of the current one
#   caller=<name>   also write one review_scope row through `ledger write`
#   skill=<name>    skill name on that row (default: review-loop)
#
# Prints eight labelled sections and no diff text:
#   ROOT, BRANCH, MERGE_BASE, STATUS, FILES, NUMSTAT, SHORTSTAT, UNTRACKED
#
# With caller=, pipes {skill, caller} to `ledger write review_scope`, which adds the
# time, repo and session. The write runs only while the metrics switch is on and `jq` is on PATH. It
# never fails the caller and never touches stdout; `ledger write` may still print to stderr.
# With no ledger found (PATH, then `${CARGO_HOME:-~/.cargo}/bin`) `ledger-write` drops the row and
# prints one stderr line; the scope prints as usual.
#
# Exit 3 (reason on stderr, stdout stops after BRANCH) when no merge base is found, no base= was given,
# and HEAD has commits that no other branch or remote ref has: the scope would silently drop them.
#
# Exit 0 with ROOT= empty when the directory is not a git repo. Never fails the
# caller: every git call that errors prints an empty section.
set -uo pipefail
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../../scripts/lib/_kv.sh
source "$script_dir/../../scripts/lib/_kv.sh"
kv_help_exit "${BASH_SOURCE[0]}" "$@"

mode=worktree base=HEAD base_given=0 merge_base="" paths="" root="" caller="" skill=review-loop
for kv in "$@"; do
  case "$kv" in
    mode=*) mode="${kv#mode=}" ;;
    base=*) base="${kv#base=}"; base_given=1 ;;
    merge_base=*) merge_base="${kv#merge_base=}" ;;
    paths=*) paths="${kv#paths=}" ;;
    root=*) root="${kv#root=}" ;;
    caller=*) caller="${kv#caller=}" ;;
    skill=*) skill="${kv#skill=}" ;;
    *) echo "review-scope: unknown argument: $kv" >&2; exit 2 ;;
  esac
done

case "$mode" in
  worktree|staged) ;;
  *) echo "review-scope: mode must be worktree or staged" >&2; exit 2 ;;
esac

if [ -n "$root" ]; then
  cd "$root" 2>/dev/null || { echo "review-scope: cannot enter $root" >&2; exit 2; }
fi

IFS=':' read -r -a pathspec <<<"$paths"
if [ -z "$paths" ]; then pathspec=(); fi

top=$(git rev-parse --show-toplevel 2>/dev/null || true)

if [ -n "$caller" ] && command -v jq >/dev/null 2>&1 \
  && "$script_dir/../../scripts/telemetry/telemetry_enabled.sh" 2>/dev/null; then
  jq -cn --arg skill "$skill" --arg caller "$caller" '{skill: $skill, caller: $caller}' \
    | bash "$script_dir/../../scripts/telemetry/ledger-write" review_scope >/dev/null || true
fi

echo "ROOT=$top"
if [ -z "$top" ]; then
  for s in BRANCH MERGE_BASE STATUS FILES NUMSTAT SHORTSTAT UNTRACKED; do echo "$s="; done
  exit 0
fi

echo "BRANCH=$(git branch --show-current 2>/dev/null || true)"

if [ -z "$merge_base" ]; then
  branch_base_script="${BRANCH_BASE_SCRIPT:-$script_dir/../../scripts/tools/branch-base}"
  if [ -x "$branch_base_script" ]; then
    # branch-base prints stdout only on exit 0 and stderr only on failure
    branch_base_out=$("$branch_base_script" 2>&1)
    branch_base_rc=$?
    if [ "$branch_base_rc" -eq 0 ]; then
      merge_base=${branch_base_out%% *}
    else
      # keep the reason, drop the instruction aimed at an interactive caller
      branch_base_reason=${branch_base_out#STOP: }
      branch_base_reason=${branch_base_reason%%; ask the user*}
      echo "review-scope: MERGE_BASE empty: branch-base exit $branch_base_rc${branch_base_reason:+: $branch_base_reason}" >&2
    fi
  else
    echo "review-scope: MERGE_BASE empty: not executable at $branch_base_script" >&2
  fi
fi
# No base ref and no base= argument: the scope below is only the working tree. When the
# branch holds commits that no other ref has, those commits would drop out of the review
# silently, so stop and ask for a base instead.
if [ -z "$merge_base" ] && [ "$base_given" = 0 ]; then
  current_ref=$(git symbolic-ref -q HEAD 2>/dev/null || true)
  exclude_current=()
  [ -n "$current_ref" ] && exclude_current=(--exclude="${current_ref#refs/heads/}")
  other_refs=$(git for-each-ref --format='%(refname)' refs/heads refs/remotes 2>/dev/null | grep -vxF "${current_ref:-none}" | head -n 1)
  branch_only_commits=$(git rev-list --count HEAD --not "${exclude_current[@]+"${exclude_current[@]}"}" --branches --remotes 2>/dev/null || echo 0)
  # a repo with no other ref (a lone default branch) has no base to find: the working tree is the scope
  if [ -n "$other_refs" ] && [ "${branch_only_commits:-0}" -gt 0 ]; then
    echo "review-scope: STOP: no base ref found and this branch has $branch_only_commits commit(s) no other ref has; a working-tree scope would miss them. Rerun with base=<ref> (whole-branch review) or merge_base=<ref>." >&2
    exit 3
  fi
fi
if [ -n "$merge_base" ]; then
  echo "MERGE_BASE=$(git merge-base HEAD "$merge_base" 2>/dev/null || true)"
else
  echo "MERGE_BASE="
fi

cached=()
[ "$mode" = staged ] && cached=(--cached)

echo "STATUS="
git status --porcelain ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null || true

echo "FILES="
{
  if [ "$mode" = staged ]; then
    git diff --cached --name-only "$base" ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null
  else
    git diff --name-only "$base" ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null
    git diff --cached --name-only "$base" ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null
    git ls-files --others --exclude-standard ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null
  fi
} | sort -u

echo "NUMSTAT="
git diff "${cached[@]+"${cached[@]}"}" --numstat "$base" ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null || true

echo "SHORTSTAT="
git diff "${cached[@]+"${cached[@]}"}" --shortstat "$base" ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null || true

echo "UNTRACKED="
git ls-files --others --exclude-standard ${pathspec:+-- "${pathspec[@]}"} 2>/dev/null || true
