#!/bin/bash
# theme-mode — single source of truth for the theme FAMILY and light/dark MODE
# across herdr + neovim + ghostty + claude code.
#
# State files (read by every consumer):
#   ~/.cache/theme-mode    dark|light
#   ~/.cache/theme-family  family name (see families() below)
#
# Consumers:
#   - nvim:    lua/config/theme-sync.lua polls both files (~1s) and applies
#              the family's colorscheme + overrides
#   - ghostty: this script writes ~/.config/ghostty/theme-switch.conf
#              (machine-local include, same pattern as local.conf), then
#              SIGUSR2s the running ghostty to reload it (1.2+; ctrl+shift+,
#              still works by hand). Only USR2 — any other signal crashes it.
#   - claude:  this script rewrites ~/.claude/themes/active.json (machine-local,
#              gitignored) with the active half — a copy of the family's authored
#              theme (claude_theme_file()) where one ships, else a bare
#              `base: <mode>` — and pins .theme = "custom:active" in
#              ~/.claude/settings.json. Claude Code watches ~/.claude/themes/ and
#              repaints running sessions when a theme file changes; a settings.json
#              .theme change never repaints an open session (anthropics/claude-code
#              #98161). A session started before the first switch onto
#              custom:active needs one restart.
#   - herdr:   this script regenerates the REAL ~/.config/herdr/config.toml from
#              the stowed ~/.config/herdr/config.toml.template (substituting the
#              __THEME_MODE_PALETTE__ marker with herdr_palette() below), then
#              runs `herdr server reload-config` so attached clients repaint
#              live. Same template contract as starship: the generated config is
#              machine-local, so a toggle never dirties the tracked file. herdr
#              has no include mechanism, so the WHOLE file is regenerated —
#              anything herdr writes to config.toml itself (e.g. `herdr config
#              reset-keys`) is overwritten on the next toggle. herdr's own
#              auto_switch is deliberately off: it keys off the terminal's
#              reported appearance rather than ~/.cache/theme-mode.
#   - tuios:   this script writes ~/.config/tuios/themes/theme-mode.json
#              (machine-local) from the family's ghostty theme file: the
#              sixteen, plus a chrome object that puts the accents on the
#              palette's cyan (teal) and the dialogs on its background. The
#              stowed config selects theme = "theme-mode". theme = "none" would
#              take the panes from ghostty but keep tuios's own accents and
#              grey dialogs. Every client watches the themes dir; this script
#              also runs `tuios theme reload`.
#   - starship: this script regenerates the REAL ~/.config/starship.toml from
#              the stowed ~/.config/starship.toml.template with the active
#              `palette =` line swapped to `<family>-<mode>` — a two-axis
#              swap, not mode-only. Starship has no include but re-reads its
#              config every prompt from that default path, so EVERY running
#              shell flips on its next prompt — no reload, no STARSHIP_CONFIG.
#              The generated file is machine-local (not stowed), so the
#              tracked template is never dirtied. Edit the template => re-run
#              theme-mode to refresh the live config.
#   - delta:   this script writes ~/.config/delta/theme.gitconfig (machine-local,
#              included by the stowed .gitconfig) from the family's hunk diff
#              palette. git reads it on every run, so the next diff flips.
#
# Usage:
#   theme-mode [dark|light|toggle]    flip mode, keep family (default: toggle)
#   theme-mode use <family> [mode]    switch family, keep mode unless given
#   theme-mode list                   known families
#   theme-mode status                 current family + mode
#   theme-mode herdr                  rebuild herdr's config from its template
#                                     and reload it, theme unchanged (prefix+r)
#   theme-mode tuios                  rewrite tuios's theme file, theme unchanged
#
# Adding a family = six touchpoints, kept in sync by hand:
#   1. families() + ghostty_theme() + claude_theme_file() below
#   2. FAMILIES table in nvim lua/config/theme-sync.lua
#   3. a ghostty theme (builtin name, or custom file in ghostty/themes/)
#   4. herdr_palette() below (herdr's [theme.custom] token block)
#   5. hunk_theme() below — a hunk builtin used directly, or (when no builtin
#      matches) the base a hunk_custom_theme() block inherits from; a family
#      that maps to neither leaves hunk with whatever it had
#   6. palettes in quickshell/.config/quickshell/Theme.qml — this script writes
#      nothing for quickshell; that singleton watches the two state files
#      itself and repaints live. A missing family silently falls back to
#      onedarkpro, so nothing breaks, it just doesn't follow.
#
# Also needed, not part of the six but easy to miss:
#   - starship.toml.template: add a `[palettes.<family>-dark]` /
#     `[palettes.<family>-light]` pair for the new family, `branch` key included
#   - zsh/.zshrc: its fresh-machine bootstrap copies starship.toml.template
#     verbatim, so it must stay in sync with the template's default palette
#     name (this already caused one bug, fixed separately)
#   - DEFAULT_FAMILY must be kept in sync across three sites: this script's own
#     DEFAULT_FAMILY var, theme-sync.lua's default, and starship.toml.template's
#     root `palette =` line
set -euo pipefail

MODE_FILE="$HOME/.cache/theme-mode"
FAMILY_FILE="$HOME/.cache/theme-family"
GHOSTTY_SWITCH="$HOME/.config/ghostty/theme-switch.conf"
DEFAULT_FAMILY="onedarkpro"

families() { printf '%s\n' onedarkpro edge bamboo gruvbox-material tokyonight dracula nightfox duskfox dredge solarized-osaka solarized selenized flexoki token-flint token jellybeans catppuccin kanagawa darcula tairiki everforest gruvbox papercolor hybrid rose-pine ef-elea ef-maris vitesse; }

claude_theme_file() { # <family> <mode> -> the authored Claude Code theme JSON, empty if none
  # A family that ships claude/.claude/themes/<slug>.json gets it copied into
  # active.json. Every other family gets a bare `base: <mode>`, which Claude Code
  # renders with its builtin dark/light theme (Monokai diff scopes, its own
  # washes) — the ghostty palette only reaches it through a custom theme whose
  # `base` is dark-ansi/light-ansi.
  case "$1:$2" in
    dredge:light) echo "$HOME/.claude/themes/dredge-light.json" ;;
    dredge:*)     echo "$HOME/.claude/themes/dredge.json" ;;
  esac
}

ghostty_theme() { # <family> <mode> -> ghostty theme name
  # A family whose halves are ghostty BUILTINS (spaces and all) needs no file
  # under ghostty/themes/ and apply() falls through to `theme = `.
  # bamboo: no ghostty builtin — custom files in ghostty/themes/, ANSI straight
  # from the theme's own terminal.lua mapping.
  case "$1:$2" in
    bamboo:light)       echo "bamboo-light" ;;
    bamboo:*)           echo "bamboo-dark" ;;
    # gruvbox-material runs background=hard, foreground=mix. Ghostty's
    # "Gruvbox Material" builtins are the medium ground — custom files in
    # ghostty/themes/, ANSI from the plugin's terminal map.
    gruvbox-material:light) echo "gruvbox-material-light" ;;
    gruvbox-material:*)     echo "gruvbox-material-dark" ;;
    # tokyonight: ghostty BUILTINS — night dark, day light.
    tokyonight:light)       echo "TokyoNight Day" ;;
    tokyonight:*)           echo "TokyoNight Night" ;;
    # onedarkpro: ghostty's Atom One builtins differ from onedarkpro.nvim —
    # custom files in ghostty/themes/.
    onedarkpro:light)       echo "onedarkpro-light" ;;
    onedarkpro:*)           echo "onedarkpro-dark" ;;
    # edge is not a ghostty builtin — custom files in ghostty/themes/, aura
    # style dark and the darkened-along-hue neon light.
    edge:light)             echo "edge-light" ;;
    edge:*)                 echo "edge-dark" ;;
    # dracula: BUILTIN matches dracula/vim's terminal map; alucard is custom.
    dracula:light)          echo "dracula-light" ;;
    dracula:*)              echo "Dracula" ;;
    # nightfox/duskfox: ghostty BUILTINS, same values as the plugin's palettes.
    nightfox:light)         echo "Dayfox" ;;
    nightfox:*)             echo "Nightfox" ;;
    duskfox:light)          echo "Dawnfox" ;;
    duskfox:*)              echo "Duskfox" ;;
    dredge:light)           echo "dredge-light" ;;
    dredge:*)               echo "dredge" ;;
    # solarized-osaka: custom files in ghostty/themes/, copied from the
    # plugin's extras/ghostty.
    solarized-osaka:light)  echo "solarized-osaka-light" ;;
    solarized-osaka:*)      echo "solarized-osaka-dark" ;;
    # solarized: ghostty BUILTINS, Schoonover's sixteen with the base tones on
    # the bright slots.
    solarized:light)        echo "iTerm2 Solarized Light" ;;
    solarized:*)            echo "iTerm2 Solarized Dark" ;;
    # selenized: ghostty BUILTINS, Warchoł's dark and light variants.
    selenized:light)        echo "Selenized Light" ;;
    selenized:*)            echo "Selenized Dark" ;;
    # flexoki: ghostty BUILTINS, kepano's sixteen.
    flexoki:light)          echo "Flexoki Light" ;;
    flexoki:*)              echo "Flexoki Dark" ;;
    # token-flint: custom files in ghostty/themes/, copied from the plugin's
    # contrib/ghostty.
    token-flint:light)      echo "token-flint-light" ;;
    token-flint:*)          echo "token-flint-dark" ;;
    # token: the same plugin's default variant, same source.
    token:light)            echo "token-light" ;;
    token:*)                echo "token-dark" ;;
    # jellybeans: custom files in ghostty/themes/, from the plugin's
    # extras/ghostty (ghostty's "Jellybeans" builtin is the older vim palette).
    jellybeans:light)       echo "jellybeans-light" ;;
    jellybeans:*)           echo "jellybeans-dark" ;;
    # catppuccin: ghostty BUILTINS — frappé dark, latte light.
    catppuccin:light)       echo "Catppuccin Latte" ;;
    catppuccin:*)           echo "Catppuccin Frappe" ;;
    # kanagawa: ghostty BUILTINS — wave dark, lotus light.
    kanagawa:light)         echo "Kanagawa Lotus" ;;
    kanagawa:*)             echo "Kanagawa Wave" ;;
    # darcula: dark only, both modes take the custom file.
    darcula:*)              echo "darcula" ;;
    # tairiki: custom files from the plugin's own terminal colours.
    tairiki:light)          echo "tairiki-light" ;;
    tairiki:*)              echo "tairiki-dark" ;;
    # everforest: custom files — the Med builtins' palette on nvim's hard
    # ground (the builtins sit on bg_dim).
    everforest:light)       echo "everforest-light" ;;
    everforest:*)           echo "everforest-dark" ;;
    # gruvbox (ellisonleao/gruvbox.nvim, medium contrast): ghostty BUILTINS,
    # morhetz's sixteen on the medium grounds.
    gruvbox:light)          echo "Gruvbox Light" ;;
    gruvbox:*)              echo "Gruvbox Dark" ;;
    # papercolor: no ghostty builtin — custom files, the plugin's palette
    # re-slotted so each ANSI index holds its own hue.
    papercolor:light)       echo "papercolor-light" ;;
    papercolor:*)           echo "papercolor-dark" ;;
    # hybrid: custom files. Dark is the plugin's terminal sixteen; light is the
    # palette of nvim's colors/hybrid-light.lua.
    hybrid:light)           echo "hybrid-light" ;;
    hybrid:*)               echo "hybrid-dark" ;;
    # vitesse: custom files, antfu's terminal sixteen.
    vitesse:light)          echo "vitesse-light" ;;
    vitesse:*)              echo "vitesse-dark" ;;
    # rose-pine: ghostty BUILTINS — main dark, dawn light.
    rose-pine:light)        echo "Rose Pine Dawn" ;;
    rose-pine:*)            echo "Rose Pine" ;;
    # ef-elea, ef-maris (oonamo/ef-themes.nvim): custom files, copies of the
    # plugin's extras/ghostty files.
    ef-elea:light)          echo "ef-elea-light" ;;
    ef-elea:*)              echo "ef-elea-dark" ;;
    ef-maris:light)         echo "ef-maris-light" ;;
    ef-maris:*)             echo "ef-maris-dark" ;;
  esac
}

hunk_theme() { # <family> <mode> -> the hunk theme id, or the `base` a custom block builds on
  # A family with no hunk builtin ships a full [custom_theme] and this id is
  # only the BASE that block inherits from. The base still decides two things
  # the config cannot override: any TextMate scope the block does not name, and
  # `syntaxColors.default` (the fg of un-highlighted content). So pick by
  # NEUTRALS.
  #
  # bamboo has no hunk builtin — gruvbox medium is the
  # neutral match at both ends: gruvbox-dark-medium is #ebdbb2 on #282828
  # (bamboo vulgaris is #f1e9d2 on #252623) and gruvbox-light-medium is #3c3836
  # on #fbf1c7 (bamboo light is #3a4238 on #fafae0) — same warm cream cast,
  # near-identical text colors.
  case "$1:$2" in
    bamboo:light)       echo "gruvbox-light-medium" ;;
    bamboo:*)           echo "gruvbox-dark-medium" ;;
    gruvbox-material:light) echo "gruvbox-light-hard" ;;
    gruvbox-material:*)     echo "gruvbox-dark-hard" ;;
    # tokyonight: hunk ships only tokyo-night (dark); light
    # takes the neutral vitesse base.
    tokyonight:light)       echo "vitesse-light" ;;
    tokyonight:*)           echo "tokyo-night" ;;
    # onedarkpro: both halves are only the BASE of a [custom_theme] — hunk's
    # one-dark-pro and one-light are Binaryify's palettes, not olimorris's.
    onedarkpro:light)       echo "one-light" ;;
    onedarkpro:*)           echo "one-dark-pro" ;;
    # edge has no hunk builtin — the vitesse pair is the neutral base (blue-gray
    # dark, plain-white light). Both halves are only the BASE of a
    # [custom_theme].
    edge:light)             echo "vitesse-light" ;;
    edge:*)                 echo "vitesse-dark" ;;
    # hunk has no alucard; light takes the neutral vitesse base.
    dracula:light)          echo "vitesse-light" ;;
    dracula:*)              echo "dracula" ;;
    # nightfox/duskfox: no hunk builtin — BASES of full [custom_theme] blocks.
    # duskfox/dawnfox share rose-pine moon/dawn's neutrals exactly.
    nightfox:light)         echo "rose-pine-dawn" ;;
    nightfox:*)             echo "night-owl" ;;
    duskfox:light)          echo "rose-pine-dawn" ;;
    duskfox:*)              echo "rose-pine-moon" ;;
    # dredge light: github-light leaks the fewest scopes past the dark-tuned
    # table; one-light leaks its red variables and blue operators.
    dredge:light) echo "github-light" ;;
    dredge:*)     echo "one-dark-pro" ;;
    # solarized-osaka: BASE of a full [custom_theme]. hunk's solarized
    # builtins render code #ffffff / #000000 (their text fails 4.5:1 on hunk's
    # own panel), so the bases are the nearest greys that pass.
    solarized-osaka:light)  echo "ayu-light" ;;
    solarized-osaka:*)      echo "one-dark-pro" ;;
    # solarized: BASE of a full [custom_theme] whose syntax follows
    # solarized.nvim's autumn variant.
    solarized:light)        echo "solarized-light" ;;
    solarized:*)            echo "solarized-dark" ;;
    # selenized: no hunk builtin. Solarized's builtins are the nearest syntax
    # base, under a diff-only block that sets selenized's text and diff.
    selenized:light)        echo "solarized-light" ;;
    selenized:*)            echo "solarized-dark" ;;
    # flexoki: BASE of a full [custom_theme]. hunk has no flexoki; these have
    # the nearest neutrals (warm grey on near-black, black on white).
    flexoki:light)          echo "light-plus" ;;
    flexoki:*)              echo "vitesse-black" ;;
    # token-flint: BASE of a full [custom_theme]. one-dark-pro is #abb2bf on
    # #282c34 (flint is #c3c8cc on #272c33); github-light is the cool-grey
    # light with the fewest leaks.
    token-flint:light)      echo "github-light" ;;
    token-flint:*)          echo "one-dark-pro" ;;
    # token: BASE of a full [custom_theme]. The vitesse pair is the warm-grey
    # match (token is #c3c0b8 on #262624 and #323128 on #faf9f5).
    token:light)            echo "vitesse-light" ;;
    token:*)                echo "vitesse-dark" ;;
    # jellybeans: BASE of a full [custom_theme]. Warm cream on near-black, and
    # near-black on a warm ground.
    jellybeans:light)       echo "vitesse-light" ;;
    jellybeans:*)           echo "vitesse-black" ;;
    # catppuccin: hunk BUILTINS.
    catppuccin:light)       echo "catppuccin-latte" ;;
    catppuccin:*)           echo "catppuccin-frappe" ;;
    # kanagawa and everforest: hunk BUILTINS.
    kanagawa:light)         echo "kanagawa-lotus" ;;
    kanagawa:*)             echo "kanagawa-wave" ;;
    everforest:light)       echo "everforest-light" ;;
    everforest:*)           echo "everforest-dark" ;;
    # gruvbox: hunk BUILTINS, medium contrast.
    gruvbox:light)          echo "gruvbox-light-medium" ;;
    gruvbox:*)              echo "gruvbox-dark-medium" ;;
    # darcula: dark only, BASE of a full [custom_theme]; dark-plus is the
    # nearest neutral grey.
    darcula:*)              echo "dark-plus" ;;
    # tairiki: BASE of a full [custom_theme]. Warm grey on near-black, and
    # dark ink on white.
    tairiki:light)          echo "light-plus" ;;
    tairiki:*)              echo "vitesse-black" ;;
    # papercolor: BASE of a full [custom_theme]. dark-plus is #d4d4d4 on
    # #1e1e1e (papercolor is #d0d0d0 on #1c1c1c); one-light is the nearest
    # grey-on-off-white.
    papercolor:light)       echo "one-light" ;;
    papercolor:*)           echo "dark-plus" ;;
    # hybrid: BASE of a full [custom_theme]; grey on #1d1f21, and grey on white.
    hybrid:light)           echo "light-plus" ;;
    hybrid:*)               echo "dark-plus" ;;
    # vitesse: hunk's own builtins, used directly (no [custom_theme]).
    vitesse:light)          echo "vitesse-light" ;;
    vitesse:*)              echo "vitesse-dark" ;;
    # rose-pine: hunk BUILTINS — main dark, dawn light.
    rose-pine:light)        echo "rose-pine-dawn" ;;
    rose-pine:*)            echo "rose-pine" ;;
    # ef-elea: BASE of a full [custom_theme]; near-white on neutral grey, and
    # near-black on a pale ground.
    ef-elea:light)          echo "light-plus" ;;
    ef-elea:*)              echo "dark-plus" ;;
    # ef-maris: BASE of a full [custom_theme]. night-owl is the navy match
    # (#d6deeb on #011627); github-light is the cool light.
    ef-maris:light)         echo "github-light" ;;
    ef-maris:*)             echo "night-owl" ;;
  esac
}

# theme-mode owns exactly this delimited block inside hunk's self-written
# config.toml; hunk_set_block strips only what is between the markers, never
# hunk's own keys/tables.
HUNK_BLOCK_BEGIN="# >>> theme-mode custom_theme (do not edit inside markers)"
HUNK_BLOCK_END="# <<< theme-mode custom_theme"

drop_overridden_scopes() { # <extra scope lines> — stdin minus every scope line extra re-sets
  # TOML refuses a repeated key, so a family's `extra` replaces a generic scope
  # line instead of repeating it.
  EXTRA_SCOPES="$1" awk '
    BEGIN {
      line_count = split(ENVIRON["EXTRA_SCOPES"], extra_lines, "\n")
      for (i = 1; i <= line_count; i++) {
        if (match(extra_lines[i], /^"[^"]+"/)) {
          overridden[substr(extra_lines[i], RSTART, RLENGTH)] = 1
        }
      }
    }
    match($0, /^"[^"]+"/) && (substr($0, RSTART, RLENGTH) in overridden) { next }
    { print }
  '
}

hunk_custom_theme() { # <family> <mode> <base> -> a [custom_theme] TOML table, or nothing
  # A family that renders via a hunk builtin gets a comment-only block: hunk
  # inherits every unset key from `base`. Each `cmt` in this function is the
  # stock comment blended toward `text` until it clears 4.5:1 on the ground
  # and both row washes (hunk's builtin washes come from its buildShikiTheme).
  local cmt=""
  case "$1:$2" in
    tokyonight:light|dracula:light) cmt="#666d64" ;;
    tokyonight:*)                   cmt="#9098bd" ;;
    dracula:*)                      cmt="#b0b8cd" ;;
  esac
  # Docstrings take the yellow tokyonight.nvim gives @string.documentation.
  local docstr=""
  case "$1:$2" in
    tokyonight:light) docstr="#8c6c3e" ;;
    tokyonight:*)     docstr="#e0af68" ;;
  esac
  # Every comment selector the builtin paints dim, doc comments included: a
  # more specific base selector beats a plain "comment".
  local cmt_scopes=(
    "comment"
    "punctuation.definition.comment"
    "comment.block.documentation"
    "comment.block.documentation punctuation"
    "comment.block.documentation variable"
    "comment.block.documentation storage"
    "comment.block.documentation storage.type"
    "comment.block.documentation keyword"
    "comment.block.documentation support"
    "comment.block.documentation markup"
    "comment.block.documentation markup.inline.raw.string.markdown"
    "comment.block.documentation entity.name.type.instance"
    "comment.block.documentation punctuation.definition.block.tag"
    "keyword.operator.assignment.jsdoc"
  )
  local docstr_scopes=(
    "string.quoted.docstring.multi"
    "string.quoted.docstring.multi.python punctuation.definition.string.begin"
    "string.quoted.docstring.multi.python punctuation.definition.string.end"
    "string.quoted.docstring.multi.python constant.character.escape"
  )
  if [ -n "$cmt" ]; then
    printf '[custom_theme]\nbase = "%s"\n\n[custom_theme.syntax_scopes]\n' "$3"
    local scope
    for scope in "${cmt_scopes[@]}"; do
      printf '"%s" = "%s"\n' "$scope" "$cmt"
    done
    if [ -n "$docstr" ]; then
      for scope in "${docstr_scopes[@]}"; do
        printf '"%s" = "%s"\n' "$scope" "$docstr"
      done
    fi
    return 0
  fi
  # A diff-only block: syntax stays the builtin's, the diff colours follow nvim,
  # so hunk, delta and nvim show one diff. Dark rows are the washes neogit
  # renders (dimmer than DiffAdd/DiffDelete), words those rows 15% toward the
  # sign; light is DiffAdd/DiffDelete/DiffText. Fields: row washes, word
  # washes, signs, line number, border, text (delta_apply reads the last three).
  # chrome_colors puts the family's panels, accent, muted and badges back over
  # the base's: panel, panelAlt, accent, accentMuted, muted, modified.
  local diff_colors="" chrome_colors=""
  case "$1:$2" in
    # selenized: solarized.nvim paints diffs fg-only, so rows are the green/red
    # signs 15% into the ground and words 30%; selenized takes the same recipe
    # from its palette's green and red.
    selenized:light)
      diff_colors="#e0e4ba #f5d3c1 #c5d699 #efb4a7 #489100 #d2212d #909995 #cfcebe #3a4d53"
      chrome_colors="#ece3cc #f5ecd4 #0072d4 #d5cdb6 #909995 #ad8900"
      ;;
    selenized:*)
      diff_colors="#1f4f46 #334049 #2e6243 #56444a #75b938 #fa5750 #72898f #2d5b69 #adbcbc"
      chrome_colors="#184956 #0d3540 #4695f7 #2d5b69 #72898f #dbb32d"
      ;;
  esac
  if [ -n "$diff_colors" ]; then
    local d_add d_rem d_add_word d_rem_word d_sign_add d_sign_rem d_line_number d_border d_text
    read -r d_add d_rem d_add_word d_rem_word d_sign_add d_sign_rem d_line_number d_border d_text <<<"$diff_colors"

    local c_panel c_panel_alt c_accent c_accent_muted c_muted c_modified
    read -r c_panel c_panel_alt c_accent c_accent_muted c_muted c_modified <<<"$chrome_colors"
    cat <<EOF
[custom_theme]
base             = "$3"
addedBg          = "$d_add"
removedBg        = "$d_rem"
movedAddedBg     = "$d_add"
movedRemovedBg   = "$d_rem"
addedContentBg   = "$d_add_word"
removedContentBg = "$d_rem_word"
addedSignColor   = "$d_sign_add"
removedSignColor = "$d_sign_rem"
fileNew          = "$d_sign_add"
fileDeleted      = "$d_sign_rem"
lineNumberFg     = "$d_line_number"
border           = "$d_border"
text             = "$d_text"
panel            = "$c_panel"
panelAlt         = "$c_panel_alt"
accent           = "$c_accent"
accentMuted      = "$c_accent_muted"
muted            = "$c_muted"
selectedHunk     = "$c_accent"
badgeAdded       = "$d_sign_add"
badgeRemoved     = "$d_sign_rem"
badgeNeutral     = "$c_accent"
fileRenamed      = "$c_accent"
fileModified     = "$c_modified"
fileUntracked    = "$d_sign_add"

