#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_info() { echo -e "${YELLOW}→${NC} $1"; }

# herdr — agent-aware terminal multiplexer (https://github.com/herdrdev/herdr).
# No apt/pacman/brew package; upstream publishes raw release binaries with no
# checksum asset, so this pins a version and verifies against a checksum
# recorded here. Bump VERSION + SHA256 together to upgrade (--update forces a
# reinstall at the pinned version). Checksums come from the release API:
#   gh release view <TAG> --repo herdrdev/herdr --json assets \
#     --jq '.assets[] | "\(.name) \(.digest)"'
# VERSION takes a stable tag (vX.Y.Z) or a preview tag
# (preview-YYYY-MM-DD-<sha>); keep it in step with `channel` in the herdr
# package's config.toml.template.

VERSION="preview-2026-08-04-d78e3d3b5126"

# Workflow plugins the herdr config's plugin_action binds depend on. Without
# these installed the bound keys resolve to nothing and fail silently.
#   herdr-splits.nvim — C-hjkl nav / M-hjkl resize across the herdr<->nvim
#   boundary (nvim side: nvim/.config/nvim/lua/plugins/herdr-splits.lua).
PLUGINS="lmilojevicc/herdr-splits.nvim"

install_plugins() {
  local repo name
  for repo in $PLUGINS; do
    name=$(basename "$repo" .nvim)
    if "$HOME/.local/bin/herdr" plugin list 2>/dev/null | grep -q "^- ${name} "; then
      print_success "herdr plugin ${name} already installed"
    else
      print_info "Installing herdr plugin ${name}..."
      "$HOME/.local/bin/herdr" plugin install "$repo" --yes >/dev/null
      print_success "herdr plugin ${name} installed"
    fi
  done
}

if command -v herdr &>/dev/null && [ "$1" != "--update" ]; then
  print_success "herdr already installed ($(herdr --version 2>/dev/null || true)) — use --update to upgrade"
  install_plugins
  exit 0
fi

# macOS ships bash 3.2 (no associative arrays) — checksums live in this case.
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)
    PLATFORM=linux-x86_64
    SHA256="338afbfe03f0eb32efc52e30a5effc6c5ee772846bdb5e059f73d04b89b467d6"
    ;;
  Linux-aarch64) PLATFORM=linux-aarch64 SHA256="f79f3ad5b24dd1b6ba49ebee1b26d69ab5dcbeaf15be4fd7f3357ab0d17f6096" ;;
  Darwin-arm64) PLATFORM=macos-aarch64 SHA256="d02190962293ccf19186e0ea8a162d7f670ef49e61dfc10051bffd7da08a7ee4" ;;
  Darwin-x86_64) PLATFORM=macos-x86_64 SHA256="384ee2f2a805260d24f3d398ba8169aa68b502452ab1457c5da40a8e4d9c975f" ;;
  *)
    print_error "Unsupported platform: $(uname -s)-$(uname -m)"
    exit 1
    ;;
esac

if [ -z "$SHA256" ]; then
  print_error "No recorded checksum for $PLATFORM — add it to install/herdr"
  exit 1
fi

ASSET="herdr-${PLATFORM}"
URL="https://github.com/herdrdev/herdr/releases/download/${VERSION}/${ASSET}"

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

print_info "Downloading herdr ${VERSION} (${PLATFORM})..."
curl -fsSL -o "$TMP_DIR/herdr" "$URL"
# macOS has shasum, not sha256sum
if command -v sha256sum &>/dev/null; then
  echo "${SHA256}  $TMP_DIR/herdr" | sha256sum --check --quiet
else
  echo "${SHA256}  $TMP_DIR/herdr" | shasum -a 256 --check --quiet
fi

mkdir -p "$HOME/.local/bin"
install -m 755 "$TMP_DIR/herdr" "$HOME/.local/bin/herdr"
print_success "herdr installed to ~/.local/bin ($("$HOME/.local/bin/herdr" --version 2>/dev/null || true))"

install_plugins
