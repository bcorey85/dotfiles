configuration {
    modi: "drun,run,window,ssh";
    show-icons: true;
    icon-theme: "Adwaita";
    terminal: "ghostty";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    display-ssh: "SSH";
}

/* rofi has no mode/family axis — @theme is fixed, untouched by theme-mode. */
@theme "flexoki"
