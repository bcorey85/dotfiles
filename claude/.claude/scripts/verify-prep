#!/usr/bin/env python3
"""verify-prep [<ticket|dir>] [--base <ref>] [--ticket-file <path>]

Fixed first steps of /verify-branch: resolve the task dir, read the criteria, measure the diff, decide whether a
branch-wide code review ran on the current tree, and print the dispatches. Exit codes:
  0 ready   2 loud failure (no criteria, missing file, no base, empty diff, detached HEAD, unknown option)
  3 several task dirs: ask which   4 no plan found: ticket-only (fetch the ticket, rerun with --ticket-file)

Runs from any directory in the repo: relative paths are read against the directory it ran in, and git and the
resolver run from the repo top level.
"""
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import verify_common as vc  # noqa: E402

REVIEW_PROMPT = ("Branch-wide deep review: review the whole branch diff against its base branch (git diff "
                 "{base}...HEAD), backend and frontend together. This is the only review of cross-phase interactions. "
                 "Report findings with file:line and severity.")
UNTRACKED_LISTED = 20


def parse_args(argv):
    options = {"base": None, "ticketFile": None, "target": ""}
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in ("--base", "--ticket-file"):
            index += 1
            if index >= len(argv):
                raise vc.Fail(f"{arg} needs a value", 2)
            options["base" if arg == "--base" else "ticketFile"] = argv[index]
        elif arg.startswith("-"):
            raise vc.Fail(f"unknown option {arg}; usage: verify-prep [<ticket|dir>] [--base <ref>] [--ticket-file <path>]")
        elif options["target"]:
            raise vc.Fail(f"unexpected second argument {arg!r} (already have {options['target']!r}); "
                          "usage: verify-prep [<ticket|dir>] [--base <ref>] [--ticket-file <path>]")
        else:
            options["target"] = arg
        index += 1
    return options


def against_original_cwd(value, originalCwd, mustExist):
    """`value` as an absolute path when it is relative to the directory the command ran in. With mustExist, a value
    that names nothing there is a ticket id or a repo-relative name for the resolver and stays as given."""
    if not value or pathlib.Path(value).is_absolute():
        return value
    candidate = pathlib.Path(originalCwd) / value
    if mustExist and not candidate.exists():
        return value
    return str(candidate)


def find_in_dir(taskDir, fixedName, globPattern):
    """The task-dir file `fixedName`, else the single `globPattern` match (legacy `<KEY>-00-ticket.md` names)."""
    fixed = taskDir / fixedName
    if fixed.is_file():
        return fixed
    matches = sorted(taskDir.glob(globPattern))
    if len(matches) > 1:
        raise vc.Fail(f"{taskDir} holds several {globPattern}: {', '.join(m.name for m in matches)}")
    return matches[0] if matches else None


def resolve_inputs(target, ticketFile, top):
    """(mode, ticketPath, planPath|None, note). Raises Fail for the ask / ticket-only exits. The resolver runs from the
    repo top level; a relative `target` or `ticketFile` has been made absolute by the caller."""
    if ticketFile:
        path = pathlib.Path(ticketFile)
        if not path.is_file():
            raise vc.Fail(f"--ticket-file {ticketFile} does not exist")
        return "ticket-only", path, None, "plan: none (ticket-only)"

    resolver = vc.script_path("RESOLVE_TASK_DIR_SCRIPT", "scripts/resolve-task-dir.sh")
    done = vc.run(["bash", resolver, target], cwd=top)
    output = done.stdout.strip()
    code = done.returncode
    if code == 3:
        raise vc.Fail("several matches; ask the user which:\n" + output, 3)
    if code == 4:
        raise vc.Fail("no plan or task dir found. Ticket-only: fetch the ticket per _shared/jira-ticket.md, write its "
                      "raw fields to <scratchpad>/<KEY>-ticket.md, then rerun with --ticket-file <that path>.\n"
                      + done.stderr.strip(), 4)
    if code not in (0, 5):
        raise vc.Fail(f"resolve-task-dir.sh exited {code}: {done.stderr.strip()}")

    if code == 5:
        flat = top / output
        return "flat", flat, flat, "legacy flat plan: it is both ticket and plan"

    taskDir = top / output
    ticket = find_in_dir(taskDir, "00-ticket.md", "*-00-ticket.md")
    if ticket is None:
        raise vc.Fail(f"{taskDir}: no 00-ticket.md or *-00-ticket.md")
    spec = find_in_dir(taskDir, "spec.md", "*-05-plan.md")
    if spec is None:
        return "dir", ticket, None, f"{taskDir.name} has no spec.md or *-05-plan.md: ticket-only (plan: none)"
    return "dir", ticket, spec, f"task dir {output}"


def read_criteria(mode, ticketPath, planPath):
    """(counts, criteriaPath|None). Every source is parsed here so a bad file fails at prep; verify-log reads them
    again when it prints the checklist, so only counts are kept."""
    counts = {"ticket": len(vc.ticket_criteria(ticketPath.read_text(), str(ticketPath))), "criteriaFileIds": 0,
              "manualOnly": 0, "manualVerification": 0, "ids": []}

    criteriaPath = None
    candidate = ticketPath.parent / "acceptance-criteria.md"
    if mode == "dir" and candidate.is_file():
        entries, manualEntries = vc.criteria_file(candidate.read_text(), str(candidate))
        if not entries and not manualEntries:
            raise vc.Fail(f"{candidate} exists but holds no `- **ACn** — text` lines")
        criteriaPath = str(candidate)
        counts["criteriaFileIds"] = len(entries) + len(manualEntries)
        counts["manualOnly"] = len(manualEntries)
        counts["ids"] = sorted({entry["id"] for entry in [*entries, *manualEntries]},
                               key=lambda acId: int(acId[2:]))
    if planPath is not None:
        counts["manualVerification"] = len(vc.manual_items(planPath.read_text(), str(planPath)))
    return counts, criteriaPath


def parse_numstat(raw):
    """[(added, removed, newPath)] from `git diff --numstat -z`; a rename lists its new path. Binary files count 0."""
    fields = raw.split("\0")
    changes = []
    index = 0
    while index < len(fields) and fields[index]:
        added, removed, name = fields[index].split("\t", 2)
        if name == "":
            name = fields[index + 2]
            index += 3
        else:
            index += 1
        changes.append((0 if added == "-" else int(added), 0 if removed == "-" else int(removed), name))
    return changes


def parse_status(raw):
    """(trackedChanges, untrackedPaths) from `git status --porcelain -z`; a rename's old path is not a second entry."""
    fields = raw.split("\0")
    tracked = 0
    untracked = []
    index = 0
    while index < len(fields) and fields[index]:
        entry = fields[index]
        if entry.startswith("??"):
            untracked.append(entry[3:])
        else:
            tracked += 1
        index += 2 if entry[0] in "RC" or entry[1] in "RC" else 1
    return tracked, untracked


def measure_diff(top, mergeBase):
    changes = parse_numstat(vc.run(["git", "diff", "--numstat", "-z", mergeBase], cwd=top, check=True).stdout)
    status = vc.run(["git", "status", "--porcelain", "-z", "--untracked-files=all"], cwd=top, check=True).stdout
    tracked, untracked = parse_status(status)
    insertions = sum(added for added, _, _ in changes)
    deletions = sum(removed for _, removed, _ in changes)
    churn = sorted(((added + removed, name) for added, removed, name in changes), reverse=True)
    return {"files": len(changes), "insertions": insertions, "deletions": deletions,
            "diffLoc": insertions + deletions, "uncommitted": tracked, "untracked": untracked,
            "hotspots": [name for _, name in churn[:5]]}


def untracked_note(untracked):
    if not untracked:
        return ""
    listed = ", ".join(untracked[:UNTRACKED_LISTED])
    more = f" (+{len(untracked) - UNTRACKED_LISTED} more)" if len(untracked) > UNTRACKED_LISTED else ""
    return f"untracked files, not in any git diff: {listed}{more}"


def print_plan(context):
    lines = []
    lines.append(f"verify-prep: {context['note']}")
    lines.append(f"ticket: {context['ticket']}")
    lines.append(f"plan: {context['plan'] or 'none'}")
    lines.append(f"base: {context['baseRef']} (merge-base {context['mergeBase'][:10]})")
    diff = context["diff"]
    lines.append(f"diff: {diff['files']} files, +{diff['insertions']} -{diff['deletions']} (diff_loc={diff['diffLoc']}); "
                 f"{diff['uncommitted']} uncommitted, {len(diff['untracked'])} untracked")
    untracked = untracked_note(diff["untracked"])
    if untracked:
        lines.append(f"  {untracked}")
    criteria = context["criteria"]
    lines.append(f"ticket ACs: {criteria['ticket']}; acceptance-criteria.md ids: {criteria['criteriaFileIds']} "
                 f"({criteria['manualOnly']} manual-only); plan Manual Verification items: "
                 f"{criteria['manualVerification']}")
    lines.append("")

    step = 1
    if not context["review"]["ran"]:
        lines.append(f"STEP {step}: branch-wide code review has NOT run on this tree "
                     f"({context['review']['reason']}).")
        lines.append("  Dispatch Agent subagent_type=code-reviewer (omit model) with this prompt:")
        lines.append("  ---")
        lines.append("  " + REVIEW_PROMPT.format(base=context["mergeBase"]))
        if diff["uncommitted"]:
            lines.append(f"  {diff['uncommitted']} uncommitted file(s) are outside `base...HEAD`: also read `git diff` "
                         "(working tree).")
        if untracked:
            lines.append(f"  {untracked}: read them too.")
        lines.append("  ---")
        lines.append("  Route its findings with /review and fix them. THEN log the review, after the fixes. Write the "
                     "findings to a JSON list ([] when none) of")
        lines.append('  {"desc","file","line","actioned", optional "class","disposition"} and run. `actioned` is required '
                     '(fixed|skipped_fp|deferred|ask|none);')
        lines.append('  a finding with disposition fix (the default) cannot have actioned none: fix it, mark it '
                     'skipped_fp, or defer it.')
        lines.append("  verify-log review --result <PASS|PASS WITH WARNINGS|NEEDS CHANGES> --rows <file|->")
        lines.append("  Then rerun verify-prep (it must report the review as ran) before STEP 2.")
        step += 1
    else:
        lines.append(f"REVIEW: ran. {context['review']['reason']}. Skip the code-reviewer dispatch.")
    lines.append(f"STEP {step}: dispatch Agent subagent_type=plan-verifier (omit model), prompt exactly:")
    lines.append("  ---")
    lines.append("  scope: branch")
    lines.append(f"  ticket: {context['ticket']}")
    lines.append(f"  plan: {context['plan'] or 'none'}")
    lines.append(f"  diff scope: base {context['mergeBase']} ({context['baseRef']}); `git diff {context['mergeBase']}` "
                 "covers committed and uncommitted changes")
    if untracked:
        lines.append(f"  {untracked}: they are part of the branch.")
    lines.append("  ---")
    lines.append("  Then convert its verdict table to rows JSON and run: verify-log --rows <file> "
                 "(see SKILL.md for the row shape).")
    return "\n".join(lines)


def excluded_from_fingerprint(mode, ticketPath, planPath, top):
    """The repo-relative task dir (the plan file itself in flat mode), or None for a ticket-only run."""
    if mode == "dir":
        return vc.repo_relative(ticketPath.parent, top)
    if mode == "flat":
        return vc.repo_relative(planPath, top)
    return None


def main(argv):
    options = parse_args(argv)
    originalCwd = os.getcwd()
    top = vc.repo_top(originalCwd)
    branch = vc.current_branch(top)

    target = against_original_cwd(options["target"], originalCwd, mustExist=True)
    ticketFile = against_original_cwd(options["ticketFile"], originalCwd, mustExist=False)
    mode, ticketPath, planPath, note = resolve_inputs(target, ticketFile, top)
    criteria, criteriaPath = read_criteria(mode, ticketPath, planPath)
    baseRef, mergeBase = vc.find_base(top, options["base"])
    repo = vc.repo_name(top)
    diff = measure_diff(top, mergeBase)
    if diff["files"] == 0:
        raise vc.Fail(f"diff vs {baseRef} is empty: nothing to verify")

    excludeRel = excluded_from_fingerprint(mode, ticketPath, planPath, top)
    fingerprint = vc.tree_fingerprint(top, mergeBase, excludeRel)
    ran, reason = vc.review_ran(repo, branch, fingerprint)

    statePath = vc.context_path(repo, branch)
    earlierEscapes = []
    if statePath.is_file():
        try:
            earlierEscapes = vc.load_context(statePath).get("escapes", [])
        except ValueError:
            earlierEscapes = []

    planFile = planPath or ticketPath
    planRel = vc.repo_relative(planFile, top) or str(planFile)
    context = {"repo": repo, "branch": branch, "note": note, "ticket": str(ticketPath),
               "plan": str(planPath) if planPath else None, "planRel": planRel, "criteriaPath": criteriaPath,
               "baseRef": baseRef, "mergeBase": mergeBase, "diff": diff, "criteria": criteria,
               "excludeRel": excludeRel, "fingerprint": fingerprint, "review": {"ran": ran, "reason": reason},
               "logged": False, "escapes": earlierEscapes}
    vc.save_context(statePath, context)
    print(print_plan(context))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except vc.Fail as error:
        vc.die(error)
