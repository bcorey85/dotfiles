#!/usr/bin/env bash
# Cross-platform notification script for Claude Code hooks
# Works on macOS, native Ubuntu, and WSL Ubuntu
#
# Usage: notify "Title" "Message"
#   or:  echo "message" | notify "Title"

# herdr raises its own agent-state notification for these same events; a second
# desktop toast is pure duplication. Outside herdr this script is the only one.
[[ -n "$HERDR_ENV" ]] && exit 0

title="${1:-Claude Code}"

if [[ -n "$2" ]]; then
  message="$2"
else
  message="$(cat)"
fi

: "${message:=Something needs your attention}"

if [[ "$(uname -s)" == "Darwin" ]]; then
  # Escape backslashes and double quotes so arbitrary text can't break out of
  # the AppleScript string literal
  esc_message=${message//\\/\\\\}; esc_message=${esc_message//\"/\\\"}
  esc_title=${title//\\/\\\\}; esc_title=${esc_title//\"/\\\"}
  osascript -e "display notification \"$esc_message\" with title \"$esc_title\""

elif grep -qi microsoft /proc/version 2>/dev/null; then
  # WSL - use Windows toast via PowerShell WinRT API
  powershell.exe -NoProfile -Command "
    \$app = '{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe'
    [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] | Out-Null
    [Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom, ContentType = WindowsRuntime] | Out-Null
    \$template = @'
<toast>
  <visual>
    <binding template=\"ToastGeneric\">
      <text>$title</text>
      <text>$message</text>
    </binding>
  </visual>
</toast>
'@
    \$xml = New-Object Windows.Data.Xml.Dom.XmlDocument
    \$xml.LoadXml(\$template)
    \$toast = [Windows.UI.Notifications.ToastNotification]::new(\$xml)
    [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier(\$app).Show(\$toast)
  " &>/dev/null &

else
  # Native Linux
  notify-send "$title" "$message"
fi
