      mac="$fn"; var="$text"; call="$fn"
      key="$text"; use="$text"; mem="$text"
      # Types take osaka's green: type names, classes, builtin types.
      typ="$type_fg"; prim="$type_fg"; cls="$type_fg"
      # Builtins and modules take osaka's blue, shifted toward cyan, clear of the violet functions.
