      overlay0="#685f5a" overlay1="#8f857e"
      text="#b4bdc3" subtext0="#8f857e"
      green="#819b69" yellow="#b77e64" red="#de6e7c"
      blue="#6099c0" teal="#66a5ad" peach="#d68c67"
      ;;
    tempus:light)
      # tempus day (Prot WCAG-tuned warm-cream #f8f2e5) — comment = fgalt #68607d.
