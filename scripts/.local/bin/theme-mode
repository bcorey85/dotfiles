#!/bin/bash
# theme-mode — single source of truth for the theme FAMILY and light/dark MODE
# across herdr + neovim + ghostty + claude code.
#
# State files (read by every consumer):
#   ~/.cache/theme-mode    dark|light
#   ~/.cache/theme-family  family name (see families() below)
#
# Consumers:
#   - nvim:    lua/config/theme-sync.lua polls both files (~1s) and applies
#              the family's colorscheme + overrides
#   - ghostty: this script writes ~/.config/ghostty/theme-switch.conf
#              (machine-local include, same pattern as local.conf), then
#              SIGUSR2s the running ghostty to reload it (1.2+; ctrl+shift+,
#              still works by hand). Only USR2 — any other signal crashes it.
#   - claude:  this script writes .theme (mode only) into ~/.claude/settings.json
#              via jq (correct key on Claude Code >= 2.1.119; older builds kept it
#              in ~/.claude.json). This sets the theme for the NEXT session — a
#              running session does NOT repaint live: Claude Code reloads the
#              settings value but never re-renders the TUI on a theme change, and
#              its `auto` OSC 11 detection only samples at launch (and the
#              multiplexer mangles it). No supported live-flip lever exists (see anthropics/claude-code
#              #33899); restart or run /theme by hand to see it in an open session.
#   - herdr:   this script regenerates the REAL ~/.config/herdr/config.toml from
#              the stowed ~/.config/herdr/config.toml.template (substituting the
#              __THEME_MODE_PALETTE__ marker with herdr_palette() below), then
#              runs `herdr server reload-config` so attached clients repaint
#              live. Same template contract as starship: the generated config is
#              machine-local, so a toggle never dirties the tracked file. herdr
#              has no include mechanism, so the WHOLE file is regenerated —
#              anything herdr writes to config.toml itself (e.g. `herdr config
#              reset-keys`) is overwritten on the next toggle. herdr's own
#              auto_switch is deliberately off: it keys off the terminal's
#              reported appearance rather than ~/.cache/theme-mode.
#   - starship: this script regenerates the REAL ~/.config/starship.toml from
#              the stowed ~/.config/starship.toml.template with the active
#              `palette =` line swapped to `<family>-<mode>` — a two-axis
#              swap, not mode-only. Starship has no include but re-reads its
#              config every prompt from that default path, so EVERY running
#              shell flips on its next prompt — no reload, no STARSHIP_CONFIG.
#              The generated file is machine-local (not stowed), so the
#              tracked template is never dirtied. Edit the template => re-run
#              theme-mode to refresh the live config.
#
# Usage:
#   theme-mode [dark|light|toggle]    flip mode, keep family (default: toggle)
#   theme-mode use <family> [mode]    switch family, keep mode unless given
#   theme-mode list                   known families
#   theme-mode status                 current family + mode
#
# Adding a family = six touchpoints, kept in sync by hand:
#   1. families() + ghostty_theme() below
#   2. FAMILIES table in nvim lua/config/theme-sync.lua
#   3. a ghostty theme (builtin name, or custom file in ghostty/themes/)
#   4. herdr_palette() below (herdr's [theme.custom] token block)
#   5. hunk_theme() below — a hunk builtin used directly, or (when no builtin
#      matches) the base a hunk_custom_theme() block inherits from; a family
#      that maps to neither leaves hunk with whatever it had
#   6. palettes in quickshell/.config/quickshell/Theme.qml — this script writes
#      nothing for quickshell; that singleton watches the two state files
#      itself and repaints live. A missing family silently falls back to
#      onedarkpro, so nothing breaks, it just doesn't follow.
#
# Also needed, not part of the six but easy to miss:
#   - starship.toml.template: add a `[palettes.<family>-dark]` /
#     `[palettes.<family>-light]` pair for the new family
#   - zsh/.zshrc: its fresh-machine bootstrap copies starship.toml.template
#     verbatim, so it must stay in sync with the template's default palette
#     name (this already caused one bug, fixed separately)
#   - DEFAULT_FAMILY must be kept in sync across three sites: this script's own
#     DEFAULT_FAMILY var, theme-sync.lua's default, and starship.toml.template's
#     root `palette =` line
set -euo pipefail

MODE_FILE="$HOME/.cache/theme-mode"
FAMILY_FILE="$HOME/.cache/theme-family"
GHOSTTY_SWITCH="$HOME/.config/ghostty/theme-switch.conf"
DEFAULT_FAMILY="onedarkpro"

families() { printf '%s\n' onedarkpro edge bamboo gruvbox-material tokyonight dracula nightfox duskfox dredge; }

ghostty_theme() { # <family> <mode> -> ghostty theme name
  # A family whose halves are ghostty BUILTINS (spaces and all) needs no file
  # under ghostty/themes/ and apply() falls through to `theme = `.
  # bamboo: no ghostty builtin — custom files in ghostty/themes/, ANSI straight
  # from the theme's own terminal.lua mapping.
  case "$1:$2" in
    bamboo:light)       echo "bamboo-light" ;;
    bamboo:*)           echo "bamboo-dark" ;;
    # gruvbox-material runs background=hard, foreground=original, whose ANSI IS
    # the original gruvbox palette over the hard grounds (#1d2021 / #f9f5d7) —
    # so the Gruvbox *Hard* builtins are exact here. Ghostty's own "Gruvbox
    # Material Dark/Light" builtins are medium ground AND the MATERIAL
    # foreground (fg #d4be98, red #ea6962), so they match on neither axis.
    gruvbox-material:light) echo "Gruvbox Light Hard" ;;
    gruvbox-material:*)     echo "Gruvbox Dark Hard" ;;
    # tokyonight: ghostty BUILTINS — storm dark, day light.
    tokyonight:light)       echo "TokyoNight Day" ;;
    tokyonight:*)           echo "TokyoNight Storm" ;;
    # onedarkpro: ghostty's Atom One builtins differ from onedarkpro.nvim —
    # custom files in ghostty/themes/.
    onedarkpro:light)       echo "onedarkpro-light" ;;
    onedarkpro:*)           echo "onedarkpro-dark" ;;
    # edge is not a ghostty builtin — custom files in ghostty/themes/, aura
    # style dark and the darkened-along-hue neon light.
    edge:light)             echo "edge-light" ;;
    edge:*)                 echo "edge-dark" ;;
    # dracula: BUILTIN matches dracula/vim's terminal map; alucard is custom.
    dracula:light)          echo "dracula-light" ;;
    dracula:*)              echo "Dracula" ;;
    # nightfox/duskfox: ghostty BUILTINS, same values as the plugin's palettes.
    nightfox:light)         echo "Dayfox" ;;
    nightfox:*)             echo "Nightfox" ;;
    duskfox:light)          echo "Dawnfox" ;;
    duskfox:*)              echo "Duskfox" ;;
    dredge:*)            echo "dredge" ;;
  esac
}

hunk_theme() { # <family> <mode> -> the hunk theme id, or the `base` a custom block builds on
  # A family with no hunk builtin ships a full [custom_theme] and this id is
  # only the BASE that block inherits from. The base still decides two things
  # the config cannot override: any TextMate scope the block does not name, and
  # `syntaxColors.default` (the fg of un-highlighted content). So pick by
  # NEUTRALS.
  #
  # bamboo has no hunk builtin — gruvbox medium is the
  # neutral match at both ends: gruvbox-dark-medium is #ebdbb2 on #282828
  # (bamboo vulgaris is #f1e9d2 on #252623) and gruvbox-light-medium is #3c3836
  # on #fbf1c7 (bamboo light is #3a4238 on #fafae0) — same warm cream cast,
  # near-identical text colors.
  case "$1:$2" in
    bamboo:light)       echo "gruvbox-light-medium" ;;
    bamboo:*)           echo "gruvbox-dark-medium" ;;
    gruvbox-material:light) echo "gruvbox-light-medium" ;;
    gruvbox-material:*)     echo "gruvbox-dark-medium" ;;
    # tokyonight: hunk ships only tokyo-night (dark), close to storm; light
    # takes the neutral vitesse base.
    tokyonight:light)       echo "vitesse-light" ;;
    tokyonight:*)           echo "tokyo-night" ;;
    # onedarkpro: both halves are only the BASE of a [custom_theme] — hunk's
    # one-dark-pro and one-light are Binaryify's palettes, not olimorris's.
    onedarkpro:light)       echo "one-light" ;;
    onedarkpro:*)           echo "one-dark-pro" ;;
    # edge has no hunk builtin — the vitesse pair is the neutral base (blue-gray
    # dark, plain-white light). Both halves are only the BASE of a
    # [custom_theme].
    edge:light)             echo "vitesse-light" ;;
    edge:*)                 echo "vitesse-dark" ;;
    # hunk has no alucard; light takes the neutral vitesse base.
    dracula:light)          echo "vitesse-light" ;;
    dracula:*)              echo "dracula" ;;
    # nightfox/duskfox: no hunk builtin — BASES of full [custom_theme] blocks.
    # duskfox/dawnfox share rose-pine moon/dawn's neutrals exactly.
    nightfox:light)         echo "rose-pine-dawn" ;;
    nightfox:*)             echo "night-owl" ;;
    duskfox:light)          echo "rose-pine-dawn" ;;
    duskfox:*)              echo "rose-pine-moon" ;;
    dredge:*)            echo "one-dark-pro" ;;
  esac
}

# theme-mode owns exactly this delimited block inside hunk's self-written
# config.toml; hunk_set_block strips only what is between the markers, never
# hunk's own keys/tables.
HUNK_BLOCK_BEGIN="# >>> theme-mode custom_theme (do not edit inside markers)"
HUNK_BLOCK_END="# <<< theme-mode custom_theme"

hunk_custom_theme() { # <family> <mode> <base> -> a [custom_theme] TOML table, or nothing
  # A family that renders via a hunk builtin gets a comment-only block: hunk
  # inherits every unset key from `base`. Each `cmt` in this function is the
  # stock comment blended toward `text` until it clears 4.5:1 on the ground
  # and both row washes (hunk's builtin washes come from its buildShikiTheme).
  local cmt=""
  case "$1:$2" in
    tokyonight:light|dracula:light) cmt="#666d64" ;;
    tokyonight:*)                   cmt="#9098bd" ;;
    dracula:*)                      cmt="#b0b8cd" ;;
  esac
  if [ -n "$cmt" ]; then
    printf '[custom_theme]\nbase = "%s"\n\n[custom_theme.syntax_scopes]\n"comment" = "%s"\n"punctuation.definition.comment" = "%s"\n' "$3" "$cmt" "$cmt"
    return 0
  fi
  # Some per-family branches below are inert (their families are gone);
  # retained as the pattern for re-adding a family whose colors no bundled
  # theme matches.
  local bg panel panelAlt border accent accentMuted text muted addedBg removedBg
  local ctxBg sAdd sRem lnFg badgeAdd badgeRem badgeNeu fRename fMod fUntracked note
  local kw str num fn typ punct op konst esc
  # Secondary roles. Each one defaults (below the case) to the generic role a
  # family that does not set it already used, so leaving them unset reproduces
  # the previous output byte for byte.
  local mem param attr tag vbi imp pre prim ns mac bfn var lang
  # Extra TOML scope lines appended last, so they out-rank the base theme.
  local extra
  case "$1:$2" in
    flume:light)
      # flume mesa (warm cream #f3ede8) — the family's light half. comment
      # #706878 (~5:1 on paper).
      bg="#f3ede8"; panel="#ece5df"; panelAlt="#ddd6e0"; border="#c8c0ca"
      accent="#3f7180"; accentMuted="#d3ccd5"; text="#413b49"; muted="#706878"
      addedBg="#e0e8dc"; removedBg="#eadadd"; ctxBg="#f3ede8"
      sAdd="#557245"; sRem="#934d5b"; lnFg="#a39ba8"
      badgeAdd="#557245"; badgeRem="#934d5b"; badgeNeu="#3f7180"
      fRename="#72518f"; fMod="#815f1d"; fUntracked="#706878"; note="#ece5df"
      # flume roles: keyword purple, string green, number/boolean rust, fn teal,
      # type yellow, operator neutral text.
      kw="#72518f"; str="#557245"; num="#9b5146"; fn="#3f7180"; typ="#815f1d"; punct="#625b69"; op="#413b49"
      ;;
    flume:*)
      # flume mira (violet-charcoal #24212f) — the family's dark half. comment
      # lifted to #a29bb0 (~5.5:1; stock #918a9a ~4.7:1).
      bg="#24212f"; panel="#292634"; panelAlt="#353142"; border="#4b485a"
      accent="#72b5bf"; accentMuted="#596073"; text="#d9d4df"; muted="#a29bb0"
      addedBg="#2a3735"; removedBg="#402a35"; ctxBg="#24212f"
      sAdd="#84b39f"; sRem="#dd789b"; lnFg="#5b6070"
      badgeAdd="#84b39f"; badgeRem="#dd789b"; badgeNeu="#72a8c7"
      fRename="#b69bd2"; fMod="#d8a36b"; fUntracked="#a29bb0"; note="#292634"
      # flume roles: keyword purple, string green, number/boolean rust, fn cyan
      # accent, type yellow, operator neutral text.
      kw="#b69bd2"; str="#84b39f"; num="#e49a7b"; fn="#72b5bf"; typ="#d8a36b"; punct="#9d96aa"; op="#d9d4df"
      ;;
    zenbones:light)
      # zenbones light (warm sand #f0edec). Chrome from the theme's own
      # CursorLine/Pmenu. Comment grey lifted to #726a64 (stock #948985 ~3.0:1).
      bg="#f0edec"; panel="#e9e4e2"; panelAlt="#dad3cf"; border="#cfc1ba"
      accent="#a8334c"; accentMuted="#a4968f"; text="#2c363c"; muted="#726a64"
      addedBg="#cbe5b8"; removedBg="#ebd8da"; ctxBg="#f0edec"
      sAdd="#4f6c31"; sRem="#a8334c"; lnFg="#a4968f"
      badgeAdd="#4f6c31"; badgeRem="#a8334c"; badgeNeu="#286486"
      fRename="#a8334c"; fMod="#944927"; fUntracked="#4f6c31"; note="#e9e4e2"
      # zenbones is low-color: keyword/fn use fg, only string/type/number tint.
      kw="#2c363c"; str="#556570"; num="#556570"; fn="#2c363c"; typ="#6a5549"; punct="#2c363c"; op="#14161b"
      ;;
    zenbones:*)
      # zenbones dark (warm near-black #1c1917). Chrome from the theme's own
      # CursorLine/Pmenu. Comment grey lifted to #8f857e (stock #6e6763 ~3.1:1).
      bg="#1c1917"; panel="#25211f"; panelAlt="#302b29"; border="#403833"
      accent="#de6e7c"; accentMuted="#685f5a"; text="#b4bdc3"; muted="#8f857e"
      addedBg="#232d1a"; removedBg="#3e2225"; ctxBg="#1c1917"
      sAdd="#819b69"; sRem="#de6e7c"; lnFg="#685f5a"
      badgeAdd="#819b69"; badgeRem="#de6e7c"; badgeNeu="#6099c0"
      fRename="#de6e7c"; fMod="#b77e64"; fUntracked="#819b69"; note="#25211f"
      # zenbones is low-color: keyword/fn use fg, only string/type/number tint.
      kw="#b4bdc3"; str="#868c91"; num="#868c91"; fn="#b4bdc3"; typ="#a1938c"; punct="#b4bdc3"; op="#e0e2ea"
      ;;
    tempus:light)
      # tempus day (Prot's WCAG-tuned warm-cream light #f8f2e5). comment = fgalt
      # #68607d. Diff bgs are washes over bgalt #e7e3d7. red softened to brick
      # #a3352a (stock col1 #c81000 is high-saturation red).
      bg="#f8f2e5"; panel="#e7e3d7"; panelAlt="#dcd7c9"; border="#d0cbba"
      accent="#8050a7"; accentMuted="#d0cbba"; text="#464340"; muted="#68607d"
      addedBg="#dde7cf"; removedBg="#f0e0cf"; ctxBg="#f8f2e5"
      sAdd="#107410"; sRem="#a3352a"; lnFg="#b0a99a"
      badgeAdd="#107410"; badgeRem="#a3352a"; badgeNeu="#385dc4"
      fRename="#8050a7"; fMod="#806000"; fUntracked="#68607d"; note="#e7e3d7"
      # tempus roles: keyword purple, string blue, number rust-orange, fn rose,
      # type teal, operator neutral fg.
      kw="#8050a7"; str="#0f64c4"; num="#b24000"; fn="#b63052"; typ="#007070"; punct="#68607d"; op="#464340"
      ;;
    tempus:*)
      # tempus classic (Prot's WCAG-tuned dark #232323). Palette already legible;
      # comment = fgalt #949d9f. Diff bgs are washes over bgalt #312e30.
      bg="#232323"; panel="#312e30"; panelAlt="#3a3739"; border="#444142"
      accent="#d58888"; accentMuted="#6b6868"; text="#aeadaf"; muted="#949d9f"
      addedBg="#283026"; removedBg="#332a24"; ctxBg="#232323"
      sAdd="#8c9e3d"; sRem="#d4823d"; lnFg="#6b6868"
      badgeAdd="#8c9e3d"; badgeRem="#d4823d"; badgeNeu="#6e9cb0"
      fRename="#d58888"; fMod="#b1942b"; fUntracked="#949d9f"; note="#312e30"
      # tempus roles: keyword pink, string blue, number blue, fn warm-rose,
      # type green, operator neutral fg.
      kw="#d58888"; str="#8e9cc0"; num="#6e9cb0"; fn="#b58d88"; typ="#6da280"; punct="#949d9f"; op="#aeadaf"
      ;;
    gruvbox-material:light)
      # gruvbox-material HARD light (#f9f5d7), foreground=original — the accent
      # hexes are original gruvbox's, but the ground is a stop lighter than
      # gruvbox's medium cream #fbf1c7, and the CHROME ladder is warmer and
      # tighter (bg1 #f5edca / bg3 #f2e5bc / bg5 #ebdbb2). Diff washes are the
      # theme's own bg_diff_green/red. Roles differ too — see below.
      bg="#f9f5d7"; panel="#f5edca"; panelAlt="#f2e5bc"; border="#ebdbb2"
      accent="#9d0006"; accentMuted="#ebdbb2"; text="#3c3836"; muted="#928374"
      addedBg="#e4edc8"; removedBg="#f8e4c9"; ctxBg="#f9f5d7"
      sAdd="#79740e"; sRem="#9d0006"; lnFg="#a89984"
      badgeAdd="#79740e"; badgeRem="#9d0006"; badgeNeu="#076678"
      fRename="#8f3f71"; fMod="#b57614"; fUntracked="#928374"; note="#f5edca"
      # gruvbox-material roles (its own highlight table, NOT original gruvbox's):
      # Keyword/Statement red, String/Function green, Number/Boolean purple,
      # Type yellow, Constant/Macro aqua, Operator/StorageClass/Tag orange,
      # Identifier/@variable.member blue, PreProc/Include/@attribute purple,
      # @module yellow, Delimiter fg.
      kw="#9d0006"; str="#79740e"; num="#8f3f71"; fn="#79740e"; typ="#b57614"; punct="#3c3836"; op="#af3a03"
      konst="#427b58"; esc="#79740e"; cmt="#70665c"; mem="#076678"; param="#3c3836"
      attr="#8f3f71"; tag="#af3a03"; vbi="#8f3f71"; imp="#8f3f71"; pre="#8f3f71"
      prim="#b57614"; ns="#b57614"; mac="#427b58"; bfn="#79740e"
      ;;
    gruvbox-material:*)
      # gruvbox-material HARD dark (#1d2021), foreground=original — the original
      # bright accents over a ground a stop darker than gruvbox's medium
      # #282828, with the chrome ladder shifted down to match (bg1 #282828 /
      # bg3 #3c3836 / bg5 #504945). Diff washes are the theme's own
      # bg_diff_green #32361a / bg_diff_red #3c1f1e.
      bg="#1d2021"; panel="#282828"; panelAlt="#32302f"; border="#3c3836"
      accent="#fb4934"; accentMuted="#504945"; text="#ebdbb2"; muted="#928374"
      addedBg="#32361a"; removedBg="#3c1f1e"; ctxBg="#1d2021"
      sAdd="#b8bb26"; sRem="#fb4934"; lnFg="#504945"
      badgeAdd="#b8bb26"; badgeRem="#fb4934"; badgeNeu="#83a598"
      fRename="#d3869b"; fMod="#fabd2f"; fUntracked="#928374"; note="#282828"
      # Same role table as the light half above.
      kw="#fb4934"; str="#b8bb26"; num="#d3869b"; fn="#b8bb26"; typ="#fabd2f"; punct="#ebdbb2"; op="#fe8019"
      konst="#8ec07c"; esc="#b8bb26"; cmt="#a89984"; mem="#83a598"; param="#ebdbb2"
      attr="#d3869b"; tag="#fe8019"; vbi="#d3869b"; imp="#d3869b"; pre="#d3869b"
      prim="#fabd2f"; ns="#fabd2f"; mac="#8ec07c"; bfn="#b8bb26"
      ;;
    bamboo:light)
      # bamboo light (warm cream #fafae0). Chrome from the theme's own CursorLine/
      # Visual. Diff washes dimmed from bamboo's loud stock DiffAdd/DiffDelete
      # (#c0e3ab/#f9afb5) to a neogit-style low-sat blend — hunk fills whole lines
      # at full opacity, so the raw hues read far brighter than in neogit.
      bg="#fafae0"; panel="#eaead0"; panelAlt="#dadac2"; border="#dadac2"
      accent="#8a4adf"; accentMuted="#a1a7a0"; text="#3a4238"; muted="#838781"
      addedBg="#e4eecb"; removedBg="#f2ddd8"; ctxBg="#fafae0"
      sAdd="#27850b"; sRem="#c72a3c"; lnFg="#a1a7a0"
      badgeAdd="#27850b"; badgeRem="#c72a3c"; badgeNeu="#1745d5"
      fRename="#8a4adf"; fMod="#a77b00"; fUntracked="#27850b"; note="#eaead0"
      # bamboo light roles, resolved from the colorscheme's own groups: Keyword/
      # Statement/PreProc/Include/@tag purple, String green, Constant (and the
      # Number/Boolean/Character/Float links) orange, Function blue, Type ochre,
      # Macro bright-purple, @string.escape + @variable.parameter coral,
      # @variable.member/@attribute cyan, @variable.builtin red, @module
      # light-blue, @function.builtin orange, Delimiter light-grey, Operator the
      # theme's own blend(purple, fg, 0.375) = #6c47a0. `cmt` is @comment
      # (bg_yellow #6f4c05, ~7.3:1) — the group treesitter actually paints code
      # comments with, NOT the dimmer Comment/light_grey nvim falls back to.
      kw="#8a4adf"; str="#27850b"; num="#df5926"; fn="#1745d5"; typ="#a77b00"; punct="#838781"; op="#6c47a0"
      konst="#df5926"; esc="#c05050"; cmt="#6f4c05"; mem="#188a9e"; param="#c05050"
      attr="#188a9e"; tag="#8a4adf"; vbi="#c72a3c"; imp="#8a4adf"; pre="#8a4adf"
      prim="#a77b00"; ns="#177fff"; mac="#c810d0"; bfn="#df5926"
      ;;
    bamboo:*)
      # bamboo vulgaris dark (warm green-brown #252623). Chrome from the theme's
      # own CursorLine/Visual. Diff washes dimmed from bamboo's loud stock
      # DiffAdd/DiffDelete (#40531b/#893f45) to a neogit-style low-sat blend —
      # hunk fills whole lines at full opacity, so the raw hues read far brighter
      # than in neogit. `muted` is light_grey; code comments use `cmt` below.
      bg="#252623"; panel="#2f312c"; panelAlt="#3a3d37"; border="#1c1e1b"
      accent="#e75a7c"; accentMuted="#5b5e5a"; text="#f1e9d2"; muted="#838781"
      addedBg="#2d3a1e"; removedBg="#3d2a2d"; ctxBg="#252623"
      sAdd="#8fb573"; sRem="#e75a7c"; lnFg="#5b5e5a"
      badgeAdd="#8fb573"; badgeRem="#e75a7c"; badgeNeu="#57a5e5"
      fRename="#e75a7c"; fMod="#dbb651"; fUntracked="#8fb573"; note="#2f312c"
      # bamboo dark roles, resolved from the colorscheme's own groups: Keyword/
      # Statement/PreProc/Include/@tag purple, String green, Constant (and the
      # Number/Boolean/Character/Float links) orange, Function blue, Type yellow,
      # Macro bright-purple, @string.escape + @variable.parameter coral,
      # @variable.member/@attribute cyan, @variable.builtin red, @module
      # light-blue, @function.builtin orange, Delimiter light-grey, Operator the
      # theme's own blend(purple, fg, 0.375) = #c5c2ee. `cmt` is @comment
      # (bg_yellow #e2c792, ~9.3:1) — the group treesitter actually paints code
      # comments with, NOT the dimmer Comment/light_grey nvim falls back to.
      kw="#aaaaff"; str="#8fb573"; num="#ff9966"; fn="#57a5e5"; typ="#dbb651"; punct="#838781"; op="#c5c2ee"
      konst="#ff9966"; esc="#f08080"; cmt="#e2c792"; mem="#70c2be"; param="#f08080"
      attr="#70c2be"; tag="#aaaaff"; vbi="#e75a7c"; imp="#aaaaff"; pre="#aaaaff"
      prim="#dbb651"; ns="#96c7ef"; mac="#df73ff"; bfn="#ff9966"
      ;;
    # onedarkpro (olimorris), both halves verbatim — hunk's one-dark-pro and
    # one-light builtins are Binaryify's palettes, not these. Chrome is the
    # theme's float_bg/fold/indentline. Diff washes are NOT the colorscheme's
    # own (its blend(bg, green|red, 0.12) is olive and lands add/remove at the
    # same lightness) — they are the cool washes hunk's one-dark-pro and
    # one-light builtins paint, read off their own rendered output.
