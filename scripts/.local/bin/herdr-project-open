#!/bin/bash
# Switch to (or create) the herdr workspace for a project directory. Under
# tuios a herdr workspace is a tuios session.
# Workspace label is the project basename.

set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

dir="${1:?usage: herdr-project-open <dir>}"
dir="${dir%/}"
label="$(basename "$dir")"

# Prefer an existing workspace with the project's label; fall back to one
# whose focused pane already sits in the project dir (covers renamed labels).
ws=$(herdr-api workspace list 2>/dev/null \
  | jq -r --arg l "$label" '.result.workspaces[] | select(.label == $l) | .workspace_id' \
  | head -1)

if [ -z "$ws" ]; then
  ws=$(herdr-api api snapshot 2>/dev/null \
    | jq -r --arg d "$dir" '.result.snapshot.panes[] | select(.cwd == $d) | .workspace_id' \
    | head -1)
fi

if [ -n "$ws" ]; then
  herdr-api workspace focus "$ws" >/dev/null
  exit 0
fi

ws=$(herdr-api workspace create --cwd "$dir" --label "$label" --focus \
      | jq -r '.result.workspace.workspace_id')

# tuios ignores create's --focus. herdr-dev's layout calls also need the
# client on this workspace under tuios.
herdr-api workspace focus "$ws" >/dev/null

# Only fresh workspaces get the layout.
if [[ "$dir" == "$HOME/dev/"* ]]; then
  herdr-dev "$dir" "$ws"
fi
