#!/bin/bash
# Single-keypress notes menu — the display-menu semantics tmux had (prefix n
# then one mnemonic, no enter). Runs in a popup in any multiplexer; the chosen
# entry execs in the same popup.
# Targets: org capture via `todo`/`bookmark`/`research`, `vault-ask` for the
# notes already held, org-popup views (todos is the single entry point for
# reading AND checking off), compiled daily note, vault sync.

export PATH="$HOME/.local/bin:$PATH"

b=$'\e[34m'
d=$'\e[2m'
r=$'\e[0m'

show() {
    clear
    printf '%s\n' "  ${b}notes${r}" ""
    printf '  %s%s%s  %s\n' \
        "$b" t "$r" "Quick todo" \
        "$b" b "$r" "Bookmark" \
        "$b" r "$r" "Research" \
        "$b" '?' "$r" "Ask vault" \
        "$b" J "$r" "Edit journal" \
        "$b" d "$r" "Today" \
        "$b" s "$r" "Sync vault" \
        "$b" c "$r" "Capture (org)" \
        "$b" j "$r" "Journal (org)" \
        "$b" a "$r" "Agenda (org)" \
        "$b" e "$r" "Todos (org)"
    printf '\n  %sq/esc close%s\n' "$d" "$r"
}

while :; do
    show
    IFS= read -rsn1 k || exit 0
    case "$k" in
        t) exec todo -i ;;
        b) exec bookmark -i ;;
        r) exec research -i ;;
        '?') exec vault-ask -i ;;
        J) exec nvim + ~/vault/org/journal.org ;;
        d)
            f=~/vault/daily/$(date +%F).md
            if [ -f "$f" ]; then exec glow-fit -p "$f"; else echo "no daily note compiled yet"; sleep 2; exit 0; fi
            ;;
        s) tmux-tui-popup vault-sync "vault-sync failed —" && sleep 1; exit 0 ;;
        c) exec org-popup capture t ;;
        j) exec org-popup capture j ;;
        a) exec org-popup agenda ;;
        e) exec org-popup todos ;;
        q | $'\e') exit 0 ;;
    esac
done
