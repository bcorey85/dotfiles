# DARK-ONLY, so the light palette below is a verbatim copy; the family name
# still needs both keys because theme-mode selects `<family>-<mode>`. No
# yellow slot: orange doubles. Grey is the lifted comment value.
[palettes.aura-dark]
red = "#c55858"
orange = "#c7a06f"
yellow = "#c7a06f"
green = "#54c59f"
blue = "#6cb2c7"
branch = "#6cb2c7"
teal = "#6cb2c7"
purple = "#8464c6"
fg = "#bdbdbd"
bg = "#15141b"
grey = "#8e8e8e"

[palettes.aura-light]
red = "#c55858"
orange = "#c7a06f"
yellow = "#c7a06f"
green = "#54c59f"
blue = "#6cb2c7"
branch = "#6cb2c7"
teal = "#6cb2c7"
purple = "#8464c6"
fg = "#bdbdbd"
bg = "#15141b"
grey = "#8e8e8e"

[directory]
style = "bold teal"
truncation_length = 3
truncate_to_repo = true

[git_branch]
format = " [$branch]($style)"
style = "branch"

[git_status]
format = "[$all_status$ahead_behind]($style) "
style = "red"
ahead = " ↑${count}"
behind = " ↓${count}"
diverged = " ↑${ahead_count}↓${behind_count}"
modified = " ✗"
staged = " +"
untracked = " ?"
stashed = " ≡"

[python]
format = " [${virtualenv}]($style)"
style = "green"
detect_extensions = []

[nodejs]
format = " [ $version]($style)"
style = "green"

[cmd_duration]
min_time = 2_000
format = " [$duration]($style)"
style = "grey"

[character]
success_symbol = "[❯](bold teal)"
error_symbol = "[❯](bold red)"
