# material lighter (shared with the material family — same light half).
# Upstream load_terminal mapping — #FAFAFA canvas, slate fg. Note the
# upstream wart kept verbatim: slots 7/15 are bright-white #EEFFFF
# (m.white is not overridden by the style), so bold-white text matches the
# canvas — same as nvim :terminal under lighter.
background = #FAFAFA
foreground = #546E7A
cursor-color = #272727
cursor-text = #FAFAFA
selection-background = #80CBC4
selection-foreground = #546E7A

palette = 0=#000000
palette = 1=#DC6068
palette = 2=#ABCF76
palette = 3=#E6B455
palette = 4=#6E98EB
palette = 5=#B480D6
palette = 6=#71C6E7
palette = 7=#EEFFFF
palette = 8=#D2D4D5
palette = 9=#E53935
palette = 10=#91B859
palette = 11=#F6A434
palette = 12=#6182B8
palette = 13=#7C4DFF
