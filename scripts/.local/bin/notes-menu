#!/usr/bin/env bash
# notes-menu — fzf replacement for the `prefix n` display-menu.
#
# Why this exists: tmux's display-menu has no equivalent in herdr (its overlays
# are internal UI, not user-definable). An fzf picker that `exec`s the choice
# in-place is the portable substitute — it runs as ONE popup in both tmux and
# herdr, which also respects herdr's single-popup-at-a-time limit (a menu that
# spawned a second popup would fail there with "popup already open").
#
# Same entries and same mnemonic letters as the old menu, so `n` then `T` still
# lands on Quick todo — the letter now filters instead of dispatching directly,
# so it needs Enter. Everything still captures to the org lane (~/vault/org).
#
#   tmux:  bind n display-popup -w 100% -h 100% -E "~/.local/bin/notes-menu"
#   herdr: [[keys.command]] key="prefix+n" command="~/.local/bin/notes-menu" type="popup"
set -euo pipefail

# key<TAB>label<TAB>command — key+label are shown, command is hidden.
entries=$(
	cat <<'EOF'
T	Quick todo	~/.local/bin/todo -i
b	Bookmark	~/.local/bin/bookmark -i
?	Ask	~/.local/bin/ask -i
p	Process inbox	~/.local/bin/vault-inbox-next
x	Check off	~/.local/bin/todo
e	Edit todos	nvim ~/vault/org/inbox.org
J	Edit journal	nvim + ~/vault/org/journal.org
d	Today	f=~/vault/Daily/$(date +%F).md; [ -f "$f" ] && ~/.local/bin/glow-fit -p "$f" || { echo "no daily note compiled yet"; sleep 2; }
s	Sync vault	~/.local/bin/tmux-tui-popup ~/.local/bin/vault-sync "vault-sync failed —" && sleep 1
c	Capture (org)	~/.local/bin/org-popup capture t
j	Journal (org)	~/.local/bin/org-popup capture j
a	Agenda (org)	~/.local/bin/org-popup agenda
t	Todos (org)	~/.local/bin/org-popup todos
EOF
)

sel=$(
	printf '%s\n' "$entries" |
		fzf --delimiter='\t' --with-nth=1,2 \
			--header='notes' --header-first \
			--layout=reverse --height=100% --info=inline
) || exit 0

[ -n "$sel" ] || exit 0

# Field 3 is the command. exec replaces this process, so the chosen program
# takes over the same popup rather than opening a nested one.
exec "${SHELL:-/bin/sh}" -c "${sel#*$'\t'*$'\t'}"
