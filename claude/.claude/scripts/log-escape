#!/usr/bin/env bash
# log-escape — append one JSONL line per escaped defect to the escape log.
#
# An "escape" is a defect found DOWNSTREAM of the gate that should have caught
# it: a human PR read, a /cc comment, a /refactor smell sweep, a /q-verify gap,
# or production. This file is the ground-truth side of the review flywheel;
# ~/.claude/review-metrics.jsonl is the "what the gates caught" side. /audit review
# aggregates both to compute per-gate escape rates.
#
# usage: log-escape key=value [key=value ...]
#   canonical fields:
#     repo=<basename>
#     stage_found=cc|walkthrough|refactor|q-verify|verify|pr-human|pr-bot|prod|
#                 phase-gate|other
#       pr-bot = a bot reviewer on the PR (Copilot, the Claude review bot)
#       caught it, logged by /pr-comments. Distinct from pr-human because a
#       bot's lens can be wired into the loop; a human's attention cannot.
#       walkthrough = caught reading /stage's queue at a phase sign-off, i.e.
#       inside the loop. Distinct from pr-human (caught after the branch left
#       the gates) because the remediation differs: a walkthrough catch means
#       the reviewer missed something the human then found one step later.
#       phase-gate = caught by a downstream AGENT inside the phase loop, before
#       a human read anything — a test-writer FAILING-TEST that resolves as a
#       spec defect, a coder reporting the plan contradicts the code. Distinct
#       from walkthrough because the loop caught this one itself; the
#       remediation is upstream, not "the human reads harder".
#     gate_missed=review|drift-gate|test-intent|stage|coder|eng-spec|q-verify
#       eng-spec = the defect was IN THE PLAN, not in code written against it:
#       an unrunnable success criterion, a criterion that contradicts the
#       domain, a mandated primitive whose semantics were never stated. No
#       implementation gate can catch these — a reviewer checks the diff
#       against the spec, so a wrong spec and a faithful diff agree with each
#       other. Remediation is a check added to /eng-spec, never a stricter
#       reviewer. Do NOT log these as gate_missed=coder: it attributes a
#       planning failure to the implementer and makes the coder's escape
#       ratio unreadable.
#     class=bug|smell|duplication|complexity|plan-drift|test-gap|weak-assertion
#          |security|perf|correctness|other
#       Same vocabulary as log-review-finding, so the caught and escaped sides
#       cross-tabulate. Do not invent values — a one-off value is a row that
#       joins to nothing.
#       perf = query/IO cost: N+1, unbounded query, missing index, over-fetch,
#       serial awaits, per-item round-trip. Use it instead of `other` for these,
#       or the perf gate's misses stay indistinguishable from every other class's
#       and its recall cannot be computed.
#       complexity = code that need not have existed (branching a data model
#       collapses, one-implementation indirection, unused configurability,
#       guards a boundary check kills). Logged by /refactor simplify mode.
#       Rows before 2026-08-11 also carry four retired values (dead-code,
#       pattern-misalignment, stale-test, wrong-altitude) — 5 rows total. Report
#       them as legacy; never remap them into the current vocabulary.
#     severity=high|medium|low
#     guard=type|convention|gotcha|rule|check|none|n-a   (REQUIRED — the ratchet
#       rung applied so this class of defect cannot recur; see
#       ~/.claude/skills/_shared/escape-ratchet.md. `check` is the plan-stage
#       rung: a command added to the spec finalization sweep, or to
#       spec-criteria-lint.sh. `none` = considered and rejected. `n-a` = this row
#       is not review-flywheel data, i.e. a REVIEW_ESCAPES_FILE override log.)
#     desc="one line"
#     file=path
#     lane=q-plan|eng-spec|code|other   (optional: planning lane that produced
#                                        the shipped work — enables lane-level
#                                        escape attribution in /audit review)
#     scan_flagged=  RETIRED — do not pass it. It scored the recall side of the
#       whole-tree scans that no longer run (copied blocks, diverged copies,
#       unreferenced symbols), was never populated on a single row, and nothing
#       reads it. Historical rows keep it; the audit reports it nowhere.
#
# Numeric-looking values are stored as numbers, everything else as strings.
# A "date" field (UTC ISO 8601) is always added. Output file:
#   $REVIEW_ESCAPES_FILE or ~/.claude/review-escapes.jsonl
set -euo pipefail

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
out="${REVIEW_ESCAPES_FILE:-$HOME/.claude/review-escapes.jsonl}"

# schema_version marks the row's schema era; bump ONLY on a breaking change
# (a value-vocabulary swap or a field-meaning change), never for additive fields.
# /audit review reads only the current version; older versions are archived.
# v1 = pre-2026-08-08 (deep-plan/q-plan lane labels), archived.
SCHEMA_VERSION=2
json=$(jq -cn --argjson sv "$SCHEMA_VERSION" '{date: (now | todate), schema_version: $sv}')
for kv in "$@"; do
  case "$kv" in
    *=*) ;;
    *) echo "skipping malformed arg (want key=value): $kv" >&2; continue ;;
  esac
  k="${kv%%=*}"
  v="${kv#*=}"
  # Only desc is free text. A space in any other value means the caller quoted
  # too much and swallowed the following key=value pairs into this one, which
  # silently destroys gate attribution — fail loud instead of logging the row.
  if [ "$k" != "desc" ] && [ "$v" != "${v#* }" ]; then
    echo "refusing to log: $k= contains a space: '$v'" >&2
    echo "Quote each key=value separately; only desc= may contain spaces." >&2
    exit 1
  fi
  json=$(jq -c --arg k "$k" --arg v "$v" '.[$k] = ($v | (tonumber? // .))' <<< "$json")
done

guard=$(jq -r '.guard // ""' <<< "$json")
case "$guard" in
  type|convention|gotcha|rule|check|none|n-a) ;;
  "")
    echo "refusing to log: guard= is required." >&2
    echo "Run the ratchet (~/.claude/skills/_shared/escape-ratchet.md), then pass" >&2
    echo "guard=type|convention|gotcha|rule|check|none (or guard=n-a for non-flywheel logs)." >&2
    exit 1 ;;
  *)
    echo "refusing to log: guard=$guard is not one of type|convention|gotcha|rule|check|none|n-a" >&2
    exit 1 ;;
esac

printf '%s\n' "$json" >> "$out"
echo "logged → $out"
