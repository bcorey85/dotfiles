# Font — Fira Code. No space in "FiraCode": that is the family name the Nerd
# Fonts patcher registers, and `Fira Code Nerd Font Mono` silently falls back.
# The family ships no italic, so italics are synthesised (oblique) by ghostty.
font-family = FiraCode Nerd Font Mono
font-style = Retina
font-size = 13
adjust-cell-height = 15%
confirm-close-surface = false

# Theme — owned by the `theme-mode` switcher: it writes ?theme-switch.conf
# (machine-local, not stowed) with the active family+mode's theme name; that
# include is processed after this file, so it wins. The line below is the
# fallback when the switcher has never run. This is what Claude Code chat
# renders in. Ghostty has no external reload — press ctrl+shift+, after
# switching. The fallback is Monokai Pro, a builtin — builtins load by `theme =
# <name>` on every platform (they have no file on disk). Custom (non-builtin)
# themes, if any are re-added, live in ./themes/ and are pulled in by a relative
# `config-file = themes/<name>` path (resolved against THIS file's dir) rather
# than `theme = <name>`, which resolves against ghostty's own config dir — not
# this one on macOS.
theme = Monokai Pro
config-file = ?theme-switch.conf

# Window
window-padding-x = 4
window-padding-y = 4

# Shell integration
shell-integration = detect

# macOS cmd key mappings. Option/Command are swapped in System Settings and
# aerospace owns real Option, so the physical "Alt" key emits Command (super) —
# these binds turn that back into the Alt sequences herdr/herdr-splits expect.
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl
keybind = super+semicolon=text:\x1b;
# Harpoon jumps: send Alt+1..4 as CSI-u (codepoint 49-52 + modifier 3=alt).
# Mirrors kitty's `map cmd+N send_text \x1b[<cp>;3u`. NOTE: the digit key is
# named `digit_N`, not
# `one`/`1` — and Ghostty 1.2.0+ binds cmd+1..9 to goto_tab by default, so this
# rebind is what reclaims them (a mismatched key name silently loses to that).
keybind = super+digit_1=csi:49;3u
keybind = super+digit_2=csi:50;3u
keybind = super+digit_3=csi:51;3u
keybind = super+digit_4=csi:52;3u

# Free ctrl+comma for herdr: Ghostty binds it to open_config by default and
# would swallow the keystroke. Emit CSI-u C-, (codepoint 44 + modifier 5=ctrl)
# so herdr reads it as C-, (last-done). Config is still reachable via
# ctrl+shift+,.
keybind = ctrl+,=csi:44;5u

# ctrl+period — the fleet dashboard reflex (herdr `ctrl+period`).
# Ctrl+punctuation has no legacy control code, so without this the keystroke
# reaches the mux as nothing at all. Codepoint 46 + modifier 5=ctrl.
keybind = ctrl+.=csi:46;5u

# Mouse
link-url = true

# Copy-on-select. Ghostty's default (`true`) writes the selection to the PRIMARY
# selection only, so a highlight is pastable with middle-click but ctrl+v still
# returns whatever was last explicitly copied. `clipboard` writes both, which is
# the behaviour every other terminal calls copy-on-select.
copy-on-select = clipboard

# Per-machine overrides (font-size on a hidpi laptop vs an external monitor,
# etc.). Machine-local, not stowed. `?` = optional. config-file includes are
# processed after this file finishes parsing, and this is the last one, so it
# wins over everything above.
config-file = ?local.conf
