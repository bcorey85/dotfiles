#!/bin/bash
# hunk review with a one-key handoff into lazygit (`C`) or nvim (`E`), for the herdr prefix+d popup.
#
# herdr popups are session-modal: while one is open no keybinding can open
# another, so review -> git means quitting hunk and pressing the git key. This
# wrapper collapses that into a single keypress by keeping the tools inside the
# one popup: the claude-review extension's `C` or `E` writes the tool it wants into
# $HUNK_REVIEW_HANDOFF and quits hunk, and we exec that tool over ourselves.
#
# Env (PATH shims, EDITOR) is the caller's job — see the prefix+d binding.
#
# Usage: hunk-review-popup [hunk diff args...]

set -u

# $0 is a stow symlink, so the library is found from the script's real path.
# shellcheck source-path=SCRIPTDIR/../lib source=handoff-command.bash
. "$(dirname "$(readlink -f "$0")")/../lib/handoff-command.bash"

handoff="${TMPDIR:-/tmp}/hunk-review-handoff.$$"
export HUNK_REVIEW_HANDOFF="$handoff"
rm -f "$handoff"
trap 'rm -f "$handoff"' EXIT

# Past the untracked-file limit, leave them out; lazygit (C) still lists them.
untracked_flag=()
flag=$(hunk-untracked-flag)
[ -z "$flag" ] || untracked_flag=("$flag")

# --sidebar first so it is the default, but a caller's --no-sidebar still wins.
# The ${a[@]+...} form: macOS /bin/bash 3.2 treats an empty array as unbound under set -u.
hunk diff --sidebar --no-hunk-headers ${untracked_flag[@]+"${untracked_flag[@]}"} "$@" || exit $?

# Absent or empty file: hunk was quit normally, nothing to hand off to.
[ -s "$handoff" ] || exit 0
target=$(head -n 1 "$handoff")
rm -f "$handoff"

exec_handoff_tool "$target"
exit 1
